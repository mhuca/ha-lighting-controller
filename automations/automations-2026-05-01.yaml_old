- id: '1775739275271'
  alias: 'Bridge Export: Universal Controller Command 1.1'
  description: Important
  triggers:
  - event_type: universal_controller_command
    trigger: event
    event_data:
      command_input: broadcast
  conditions:
  - condition: template
    value_template: '{{ trigger.event.data.controller_id is not defined }}'
  actions:
  - variables:
      payload: '{{ dict(trigger.event.data, controller_id = ''lighting_primary'')  |
        to_json  }}

        '
  - data:
      topic: home/universal/bus
      payload: '{{ payload }}

        '
    action: mqtt.publish
  mode: single
- id: '1775741158641'
  alias: 'Override: Infer from Pico Light Call v1.2'
  description: Use Pico turn_on/turn_off in override-eligible areas to toggle override
  triggers:
  - event_type: universal_controller_command
    event_data:
      source_device: pico
      action_type: light_call
    trigger: event
  conditions:
  - condition: template
    value_template: '{{ is_eligable and cmd in [''turn_on'', ''turn_off''] }}

      '
  actions:
  - event: lighting_registry_update
    event_data:
      action: '{{ ''add'' if cmd == ''turn_on'' else ''remove'' }}'
      claimant_id: '{{ trigger.event.data.data_payload.device_id }}'
      area_key: '{{ area_key }}'
      seconds: '{{ -1 if cmd == ''turn_on'' else 0 }}'
      intent_type: override
      locked: '{{ true if cmd == ''turn_on'' else false }}'
  variables:
    area_key: '{{ trigger.event.data.area_key }}'
    cmd: '{{ trigger.event.data.command_input }}'
    is_eligable: '{{ area_key in label_areas(''override_eligible'') }}'
  mode: parallel
  max: 20
- id: '1775741224329'
  alias: 'Override: Universal Engine v1.2'
  description: Handle manual relay overrides generically based on labels
  triggers:
  - trigger: state
    entity_id: sensor.active_override_source
  conditions:
  - condition: template
    value_template: "{{ trigger.to_state.state not in ['none', 'unknown', 'unavailable']\n
      \  and trigger.from_state.state != trigger.to_state.state \n   and trigger.to_state.context.user_id
      is none \n   and trigger.to_state.context.parent_id is none }}\n"
  actions:
  - variables:
      src: '{{ states[source_entity] }}'
  - event: universal_controller_command
    event_data:
      action_type: light_override
      area_key: '{{ area_key }}'
      action_value: '{{ states[source_entity].state }}'
      claimant_id: '{{ source_entity }}'
    enabled: false
  - action: logbook.log
    metadata: {}
    data:
      name: Lighting Override Engine
      message: 'Override for {{ area_key }} State: {{ states[source_entity].state
        }} via UCC Bus'
      entity_id: '{{ source_entity }}'
    enabled: false
  mode: parallel
  variables:
    registry: '{{ state_attr(''sensor.global_variable_registry'', ''vars'') | default({},
      true) }}'
    g_env: '{{ registry.get(''globals'', {}).get(''environmental'', {}) }}'
    g_hvac: '{{ registry.get(''globals'', {}).get(''hvac'', {}) }}'
    g_logic: '{{ registry.get(''globals'', {}).get(''logic_engines'', {}) }}'
    source_entity: '{{ trigger.to_state.state.split(''|'')[0] }}'
    area_key: '{{ area_id(source_entity) | default(''none'') }}'
    entity_labels: '{{ labels(source_entity) }}'
    is_ready: '{{ g_env != {} and area_key != ''none'' }}'
  max: 20
- id: '1775741291145'
  alias: 'Override: Expiry & Policy Reaper v1.2'
  description: Cleans up manual overrides based on expiry timestamps and area policies
  triggers:
  - trigger: time_pattern
    hours: /1
  conditions: []
  actions:
  - variables:
      registry: '{{ state_attr(''sensor.active_area_overrides'', ''override_expiry'')
        or {} }}'
      now_ts: '{{ now().timestamp() | int }}'
  - repeat:
      for_each: '{{ registry.items() | list }}'
      sequence:
      - variables:
          area_key: '{{ repeat.item[0] }}'
          expiry_ts: '{{ repeat.item[1] | int }}'
          area_policy: '{{ labels(area_key) }}'
          is_lock_zone: '{{ ''lock_eligible'' in area_policy }}'
          is_area_locked: '{{ (state_attr(''sensor.lighting_off_registry'', ''active_timers'')
            or {}).get(area_key, {}).get(''locked'', false) }}

            '
          presence_entities: '{{ area_entities(area_key) | intersect(label_entities(''presence''))
            }}'
          is_empty: "{% if presence_entities | length > 0 %}\n  {{ presence_entities
            | select('is_state', 'on') | list | length == 0 }}\n{% else %}\n  true\n{%
            endif %}\n"
      - if:
        - condition: template
          value_template: '{{ expiry_ts <= now_ts and not (is_lock_zone and is_area_locked)
            }}

            '
        then:
        - event: universal_controller_command
          event_data:
            action_type: light_call
            area_key: '{{ area_key }}'
            command_input: turn_off
            source_device: expiry_reaper
            action_value: ''
            target_label: []
            data_payload:
              transition: 20
        - event: universal_controller_command
          event_data:
            action_type: light_override
            area_key: '{{ area_key }}'
            action_value: 'off'
            source_device: expiry_reaper
  mode: single
- id: '1775742743926'
  alias: Bridge - Global Presence Orchestrator v1.3
  description: "# GPE - ORCHESTRATOR (V1.3)\n## 1. CORE PURPOSE\nActs as the central
    decision engine for environmental presence. It translates  raw sensor telemetry
    (PIR, mmWave, Door) into high-level architectural  intents, coordinating between
    the **Matrix Scene Executor** and the  **Global Presence Registry**.\n## 2. ARCHITECTURAL
    LOGIC\n* **Polymorphic Execution**: Dynamically switches between `scene_cycle`
    \n  (for high-end Matrix zones) and `light_call` (for standard zones) based on
    \n  the `scene_eligible` area policy.\n\n* **The Gatekeeper Pattern**: Leverages
    `is_room_off` state-checks to suppress \n  redundant `restore` commands. This
    ensures scene persistence and prevents \n  network \"command storms\" during continuous
    occupancy.\n\n* **Dual-Path Departure**: \n\n  * **Performance Zones**: Executes
    an instant `off` command to the Matrix \n    Engine upon motion-stop for maximum
    efficiency.\n    \n  * **Legacy Zones**: Hands off management to the `lighting_off_registry`
    with \n    TTL (Time-To-Live) values adjusted by sensor precision (mmWave vs.
    PIR).\n\n* **Privacy & Media Locks**: Integrates `is_area_locked` logic to stand
    down \n  during active media playback or manual privacy overrides, preventing
    \n  unintended \"dark-outs.\"\n\n## 3. OPERATIONAL NOTES\n* **V1.3**: Integrated
    Matrix Scene `restore`/`off` logic; implemented \n  `is_already_active` gatekeeping
    to prevent command spam.\n  \n* **V1.2**: Added mmWave vs. PIR detection-stop
    logic with variable TTLs.\n* **V1.1**: Integrated Privacy Zone/Lock logic and
    Door-state awareness.\n* **V1.0**: Initial Bus-Pure presence translation.\n##
    4. DATA DEPENDENCIES\n* **Registry**: `sensor.lighting_off_registry` (for lock
    and timer states)\n* **Matrix State**: `state_attr(g_logic.scene_data, 'data')`\n*
    **Policy**: Area labels (e.g., `scene_eligible`, `lock_eligible`, `presence`)\n*
    **Posture**: `sensor.night_posture_sensor`\n## 5. YAML STANDARDS (PROJECT WIDE)\n*
    **Self-Documentation**: All critical automations must include \n  Markdown-formatted
    documentation in the `description` block.\n  \n* **Code References**: Use backticks
    ` for entity IDs, attributes, or \n  technical slugs (e.g., `area_key`, `is_room_off`)."
  triggers:
  - trigger: state
    entity_id: sensor.active_sensor_monitor_master
  conditions:
  - condition: template
    value_template: "{{ trigger.to_state.state not in ['none', 'unknown', 'unavailable']
      and\n   trigger.from_state.state != trigger.to_state.state }}"
  - condition: template
    value_template: "{% set source_entity = trigger.to_state.state.split('@')[0]  %}
      \n{% set area = area_id(source_entity) | default('none') %} \n{% set overrides
      = state_attr('sensor.active_area_overrides', 'overridden_areas') or [] %} \n{{
      area not in overrides }}\n"
  actions:
  - variables:
      registry: '{% set r = state_attr(''sensor.global_variable_registry'', ''vars'')
        %} {{ r if r is not none else {} }}'
      g_env: '{{ registry.get(''globals'', {}).get(''environmental'', {}) }}'
      g_hvac: '{{ registry.get(''globals'', {}).get(''hvac'', {}) }}'
      g_logic: '{{ registry.get(''globals'', {}).get(''logic_engines'', {}) }}'
      is_ready: '{{ g_env != {} }}'
  - condition: template
    value_template: '{{ is_ready }}'
  - variables:
      source_entity: '{{ trigger.to_state.state.split(''@'')[0] }}'
      area_key: '{{ area_id(source_entity) | default(''none'') }}'
      entity_labels: '{{ labels(source_entity) }}'
      event_ts: '{{ states[source_entity].last_changed }}'
      is_on: '{{ is_state(source_entity, ''on'') }}'
      has_presence_capability: '{{ (area_entities(area_key) | intersect(label_entities(''presence''))
        | count) > 0 }}'
      is_presence: '{{ ''presence'' in entity_labels }}'
      area_policy: '{{ labels(area_key) }}'
      is_night_policy_enabled: '{{ ''night_light'' in area_policy }}'
      house_is_in_night_posture: '{{ is_state(g_env.night_posture_sensor, ''on'')
        }}'
      use_night_settings: '{{ is_night_policy_enabled and house_is_in_night_posture
        }}'
      scene_data: '{{ state_attr(g_logic.scene_data, ''data'') | default({}, true)
        }}'
      current_scene: '{{ scene_data.get(area_key, {}).get(''name'', ''off'') | lower
        }}'
      is_room_off: '{{ current_scene == ''off'' }}'
      use_scene: '{{ ''scene_eligible'' in area_policy }}'
      call_scene: '{{ is_room_off and is_presence and is_on and use_scene }}'
      final_target_label: "{% if use_night_settings %} \n  {{ ['night_light'] }} \n{%
        elif is_night_policy_enabled %}\n  {{ ['main'] }} \n{% else %} \n  {{ [] }}
        \n{% endif %}\n"
      adjoining_area: '{{ registry.area_metadata.get(area_key, {}).get(''neighbors'',
        {}).get(''peer'', ''none'') }}'
      is_entrance: '{{ ''entrance'' in entity_labels }}'
      is_door: '{{ ''door'' in entity_labels }}'
      door_entity: '{{ (area_entities(area_key) | intersect(label_entities(''door'')))
        | first | default(''none'') }}'
      has_door: '{{ door_entity != ''none'' }}'
      is_lock_zone: '{{ ''lock_eligible'' in area_policy }}'
      registry_entry: '{{ (state_attr(g_logic.lighting_off_registry, ''active_timers'')
        or {}).get(area_key, {}) }}'
      is_area_locked: '{{ registry_entry.get(''locked'', false) }}'
      should_trigger_peer: '{{ is_door and is_on and area_key != ''none'' and adjoining_area
        != ''none'' }}'
      hvac_action: '{{ state_attr(g_hvac.primary_unit, ''hvac_action'') | default(''idle'')
        }}'
      fan_running: '{{ is_state_attr(g_hvac.primary_unit, ''fan'', ''on'') }}'
      hvac_is_active: '{{ hvac_action in g_hvac.monitored_states or fan_running }}'
      door_age: "{% if has_door and states[door_entity] is not none %}\n  {{ as_timestamp(now())
        - as_timestamp(states[door_entity].last_changed, 0) }}\n{% else %}\n  0\n{%
        endif %}\n"
      is_door_closed: '{{ is_state(door_entity, ''off'') if has_door else false }}'
      is_privacy_zone: '{{ has_door and ''lock_eligible'' in area_policy }}'
      is_ghost: "{% if not has_door %} \n  {{ false }}\n{% else %}\n  {{ is_presence
        and is_on and is_door_closed and not is_area_locked and (door_age > 600 or
        hvac_is_active) }}\n{% endif %}\n"
      should_lock_area: "{% if not is_privacy_zone %}\n  {{ false }}\n{% else %}\n
        \ {{ is_presence and is_on and is_door_closed and not is_area_locked and door_age
        < 120 }}\n{% endif %}\n"
      should_unlock_area: "{% if is_area_locked %}\n   {# Safety: Clear lock if motion
        stops OR if the door is physically opened #}\n   {{ not is_on or (has_door
        and not is_door_closed) }}\n{% else %}\n   {{ false }}\n{% endif %}\n"
      action_type: '{{ ''scene_call'' if use_scene else ''light_call'' }}'
  - choose:
    - alias: Veto Log (Ghost Detected)
      conditions:
      - condition: template
        value_template: '{{ is_presence and is_on and is_ghost }}'
      sequence:
      - action: logbook.log
        data:
          name: GPE VETO
          message: 'GPE VETO: Ghost in {{ area_key }} (HVAC: {{ hvac_action }}, Door
            Age: {{ door_age | int }}s, Lock Status: {{ is_area_locked}})'
          entity_id: '{{ source_entity }}'
    - alias: Lock Presence (Sabbatical)
      conditions:
      - condition: template
        value_template: '{{ should_lock_area and not is_area_locked }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: lock
          area_key: '{{ area_key }}'
      - action: logbook.log
        data:
          name: GPE LOCKED
          message: 'Locked Via {{ ''Motion'' if is_presence else ''Portal'' }} Room
            {{ area_key }} (Registry Reset{% if has_door %}, Door Age: {{ door_age
            | int }}s{% endif %})'
          entity_id: '{{ source_entity }}'
    - alias: Valid Turn On (Anti-Ghosting)
      conditions:
      - condition: template
        value_template: '{{ (is_entrance or is_door or (is_presence and not is_area_locked))
          and is_on and not is_ghost }}'
      sequence:
      - choose:
        - conditions:
          - condition: template
            value_template: '{{ not use_scene }}'
          sequence:
          - event: universal_controller_command
            event_data:
              action_type: light_call
              command_input: turn_on
              area_key: '{{ area_key }}'
              action_value: '{{ ''night_mode'' if use_night_settings else ''day_mode''
                }}'
              target_label: '{{ final_target_label }}'
              source_device: monitor
          - event: lighting_registry_update
            event_data:
              action: remove
              area_key: '{{ area_key }}'
        - conditions:
          - condition: template
            value_template: '{{ use_scene }}'
          sequence:
          - if:
            - condition: template
              value_template: '{{ call_scene }}'
            then:
            - event: universal_controller_command
              event_data:
                action_type: scene_cycle
                command_input: turn_on
                area_key: '{{ area_key }}'
                action_value: restore
                target_label: '{{ final_target_label }}'
                source_device: monitor
            - event: lighting_registry_update
              event_data:
                action: remove
                area_key: '{{ area_key }}'
      - action: logbook.log
        data:
          name: GPE
          message: 'Turn On: Via {{''Motion'' if is_presence else ''Portal'' }} Room
            {{ area_key }} (Registry Reset, Door Age: {{ door_age | int }}s)'
          entity_id: '{{ source_entity }}'
      - if:
        - condition: template
          value_template: '{{ is_door and has_presence_capability }}'
        then:
        - event: lighting_registry_update
          event_data:
            action: add
            area_key: '{{ area_key }}'
            seconds: 10
            timestamp: '{{ event_ts }}'
    - alias: Presence Cleared (Start Cleaner)
      conditions:
      - condition: template
        value_template: '{{ is_presence and not is_on and not is_area_locked }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: add
          area_key: '{{ area_key }}'
          seconds: '{{ 120 if has_presence_capability else 1800 }}'
          skip_warning: '{{ use_scene if use_scene else not is_lock_zone }}'
          timestamp: '{{ event_ts }}'
      - event: start_registry_cleaner
      - action: logbook.log
        data:
          name: 'GPE Start '
          message: 'GPE: Start Cleaner {{ area_key }} Seconds: "{{ 120 if has_presence_capability
            else 1800 }}" Skip Warning: "{{  use_scene if use_scene else not is_lock_zone
            }}"'
          entity_id: '{{ source_entity }}'
    - alias: Door Closed Timer Reset
      conditions:
      - condition: template
        value_template: '{{ is_door and not is_on }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: add
          area_key: '{{ area_key }}'
          seconds: '{{ 30 if has_presence_capability else 5 }}'
          skip_warning: '{{ not is_lock_zone }}'
          timestamp: '{{ event_ts }}'
      - action: logbook.log
        data:
          name: GPE Add
          message: 'GPE: Door Warning {{ area_key }} seconds: "{{ 30 if has_presence_capability
            else 5 }}" skip_warning: "{{ not is_lock_zone }}"'
          entity_id: '{{ source_entity }}'
    - alias: Presence Update (No or Open Door)
      conditions:
      - condition: template
        value_template: '{{ is_presence and is_on and (not has_door or not is_door_closed
          ) }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: add
          area_key: '{{ area_key }}'
          seconds: 120
          timestamp: '{{ event_ts }}'
      - action: logbook.log
        data:
          name: GPE Add
          message: 'GPE: Reset {{ area_key }} Time Added 120s'
          entity_id: '{{ source_entity }}'
    - alias: Safety Unlock (Self-Healing)
      conditions:
      - condition: template
        value_template: '{{ should_unlock_area }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: remove
          area_key: '{{ area_key }}'
        enabled: false
  - if:
    - condition: template
      value_template: '{{ should_trigger_peer }}'
    then:
    - event: universal_controller_command
      event_data:
        action_type: light_call
        command_input: turn_on
        area_key: '{{ adjoining_area }}'
        action_value: '{{ final_action_value }}'
        source_device: peer_preheat
  mode: parallel
  max: 20
- id: '1775743100644'
  alias: Bridge - Global Presence Recursive Registry Cleaner v1.2
  description: Iterates through the Registry with support for Skip-Warning (Transient)
    logic
  triggers:
  - trigger: event
    event_type: start_registry_cleaner
  - trigger: event
    event_type: esphome.start_registry_cleaner
  - trigger: event
    event_type: cleaner_heartbeat
  - trigger: state
    entity_id: sensor.lighting_off_registry
    to: active
  conditions: []
  actions:
  - variables:
      global_vars: '{{ state_attr(''sensor.global_variable_registry'', ''vars'') }}'
      g_logic: '{{ global_vars.globals.logic_engines }}'
      target_registry: '{{ g_logic.lighting_off_registry }}'
      log_dest: '{{ g_logic.system_log }}'
      registry_data: '{{ state_attr(target_registry, ''active_timers'') or {} }}'
      current_time: '{{ now() }}'
  - repeat:
      for_each: '{{ registry_data.items() | list }}'
      sequence:
      - variables:
          area_key: '{{ repeat.item[0] }}'
          data: '{{ repeat.item[1] }}'
          expiry: '{{ as_timestamp(data.expiry) | default(0) }}'
          is_locked: '{{ data.locked }}'
          is_warned: '{{ data.warned }}'
          skip_warning: '{{ data.skip_warning | default(false) }}'
          now_ts: '{{ as_timestamp(now()) }}'
          is_expired: '{{ now_ts >= expiry }}'
          area_policy: '{{ labels(area_key) }}'
          use_scene: '{{ ''scene_eligible'' in area_policy }}'
      - choose:
        - conditions:
          - condition: template
            value_template: '{{ is_locked or not is_expired }}'
          sequence: []
          alias: Locked or not Expired (Do nothing)
        - conditions:
          - condition: template
            value_template: '{{ skip_warning }}'
          sequence:
          - choose:
            - conditions:
              - condition: template
                value_template: '{{ use_scene }}'
              sequence:
              - event: universal_controller_command
                event_data:
                  action_type: scene_cycle
                  command_input: ''
                  area_key: '{{ area_key }}'
                  action_value: 'off'
                  source_device: Global Presence Cleaner
            - conditions:
              - condition: template
                value_template: '{{ not use_scene }}'
              sequence:
              - event: universal_controller_command
                event_data:
                  action_type: light_call
                  command_input: turn_off
                  area_key: '{{ area_key }}'
                  source_device: Global Presence Cleaner
          - event: lighting_registry_update
            event_data:
              action: remove
              area_key: '{{ area_key }}'
          - action: logbook.log
            data:
              name: Registry Cleaner
              message: Light Call Turn Off (Transient/Skip) for {{ area_key }}
              entity_id: '{{ log_dest }}'
          alias: Skip Warning - Lights Off and Clear
        - conditions:
          - condition: template
            value_template: '{{ not is_warned }}'
          sequence:
          - event: universal_controller_command
            event_data:
              action_type: light_call
              command_input: turn_on
              action_value: min
              area_key: '{{ area_key }}'
              source_device: Global Presence Cleaner
          - event: lighting_registry_update
            event_data:
              action: warned
              area_key: '{{ area_key }}'
          - action: logbook.log
            data:
              name: Registry Cleaner
              message: Light Call Dim Warning for {{ area_key }}
              entity_id: '{{ log_dest }}'
          alias: Send Warning - Dim Lights
        - conditions:
          - condition: template
            value_template: '{{ is_warned }}'
          sequence:
          - event: universal_controller_command
            event_data:
              action_type: light_call
              command_input: turn_off
              area_key: '{{ area_key }}'
              source_device: Global Presence Cleaner
          - event: lighting_registry_update
            event_data:
              action: remove
              area_key: '{{ area_key }}'
          - action: logbook.log
            data:
              name: Registry Cleaner
              message: Light Call Turn Off After Warning for {{ area_key }}
              entity_id: '{{ log_dest }}'
          alias: Warning Sent - Lights Off and Clear
  - if:
    - condition: template
      value_template: '{{ (state_attr(target_registry, ''active_timers'') or {}) |
        count > 0 }}'
    then:
    - delay: 00:00:05
    - event: cleaner_heartbeat
  mode: restart
- id: '1775777481832'
  alias: Universal Matrix Scene Executor V2.9.3
  description: '# UNIVERSAL MATRIX SCENE EXECUTOR (V2.9.2)


    ## 1. CORE PURPOSE


    Executes lighting scene changes locally using the **Processed** profile provided
    by the Node-RED Matrix Processor. This version is "Bus Pure," meaning it exclusively
    listens to the Universal Bus for all commands.


    ## 2. ARCHITECTURAL LOGIC


    * **Bus Integration**: Listens to `home/universal/bus` for unified observability.


    * **Relative Commands**: Supports `next`, `previous`, `raise`, `lower`, `max`,
    `min`.


    * **Absolute Jumps**: Automatically switches to an absolute jump if `action_value`
    is a numeric weight (e.g., from the HA UI Selector).


    * **Restore Logic**: If `action_value` is `restore`, the engine pulls the weight
    from `sensor.[area]_matrix_previous_scene` to return the room to its last state.


    * **Lock Down Logic**: If `action_value` is `lock_down`, the engine physically
    forces all labels to 0 (Off) but suppresses the `mqtt.publish` to preserve logical
    state memory during "Away" postures.


    ## 3. OPERATIONAL NOTES


    * **V2.9.2**: Applied V3.0 Documentation Standards; refined spacing and bold key
    formatting.


    * **V2.9.1**: Integrated `lock_down` physical override with `restore` state logic.


    * **V2.9.0**: Added `restore` logic to leverage the V3.1 Discovery Generator memory.


    * **V2.8.4**: Replaced `home/matrix/+/set` with unified `home/universal/bus`.


    * **V2.8.0**: Removed looping; implemented boundary clamping for Raise/Lower.


    ## 4. DATA DEPENDENCIES


    * **Config**: `sensor.[area_key]_matrix_config`


    * **Memory**: `sensor.[area_key]_matrix_previous_scene`


    * **State**: `state_attr(g_logic.scene_data, ''data'')`


    ## 5. YAML STANDARDS (PROJECT WIDE)


    * **Self-Documentation**: All critical automations must include Markdown-formatted
    documentation in the `description` block.


    * **Code References**: Use backticks ` for entity IDs, attributes, or technical
    slugs (e.g., `area_id`, `weight_0`).'
  triggers:
  - trigger: event
    event_type: universal_controller_command
    event_data:
      action_type: scene_cycle
  - trigger: mqtt
    id: MQTT_Message
    options:
      topic: home/universal/bus
      value_template: '{{ value_json.action_type }}'
      payload: scene_cycle
  conditions: []
  actions:
  - variables:
      registry: "{% set reg = state_attr('sensor.global_variable_registry', 'vars')
        %} \n{{ reg if reg is not none else {} }}\n"
      g_logic: '{{ registry.get(''globals'', {}).get(''logic_engines'', {}) }}'
      is_ready: '{{ g_logic != {} }}'
  - condition: template
    value_template: '{{ is_ready }}'
  - variables:
      payload: '{{ trigger.payload_json if trigger.id == ''MQTT_Message'' else trigger.event.data
        }}'
      area: '{{ payload.area_key }}'
      action: '{{ payload.action_value | default(''next'') }}'
      restore_val: "{% if action == 'restore' %}\n  {% set prev = states('sensor.'
        ~ area ~ '_matrix_previous_scene') %}\n  {{ prev.split(':')[0] | int(-1) if
        prev not in ['unknown', 'unavailable'] else -1 }}\n{% else %}\n  -1\n{% endif
        %}"
      target_weight: '{{ restore_val if action == ''restore'' else action | int(-1)
        }}'
      is_jump: '{{ target_weight >= 0 }}'
      is_lock_down: '{{ action == ''lock_down'' }}'
      matrix_sensor: '{{ state_attr(''sensor.'' ~ area ~ ''_matrix_scene_config'',
        ''scenes'') | default({}, true) }}'
      matrix_list: '{{ matrix_sensor.values() | sort(attribute=''sequence_weight'')
        | list }}'
      current_scene_data: '{{ state_attr(g_logic.scene_data, ''data'') | default({},
        true) }}'
      current_state_obj: "{{ current_scene_data.get(area, {\n  \"name\": \"off\",\n
        \ \"sequence_weight\": 0\n}) }}"
      current_scene_name: '{{ current_state_obj.name | default(''off'') }}'
      current_scene: "{% set match = matrix_list \n  | selectattr('name', 'eq', current_scene_name)
        \n  | first \n  | default(none) %}\n{{ match if match is not none else (matrix_list[0]
        if matrix_list | length > 0 else none) }}\n"
      next_scene: "{% set weight = current_scene.sequence_weight | default(0) | int
        %}\n{% if is_jump %}\n  {{ matrix_list | selectattr('sequence_weight', 'eq',
        target_weight) | first | default(current_scene) }}\n{% elif action in ['raise',
        'next'] %}\n  {{ matrix_list | selectattr('sequence_weight', 'gt', weight)
        | sort(attribute='sequence_weight') | first | default(current_scene) }}\n{%
        elif action in ['lower', 'previous'] %}\n  {{ matrix_list | selectattr('sequence_weight',
        'lt', weight) | sort(attribute='sequence_weight') | last | default(current_scene)
        }}\n{% elif action == 'max' %}\n  {{ matrix_list | last }}\n{% elif action
        in ['min'] %}\n  {{ matrix_list | selectattr('sequence_weight', 'gt', 0) |
        sort(attribute='sequence_weight') | first | default(matrix_list | first) }}\n{%
        elif action in ['off','lock_down'] %}\n  {{ matrix_list | first }}\n{% else
        %}\n  {{ current_scene }}\n{% endif %}\n"
  - condition: template
    value_template: '{{ next_scene is not none }}'
  - repeat:
      until:
      - condition: template
        value_template: '{{ repeat.index >= (next_scene.primary.keys() | list | length
          if next_scene.primary is mapping else 1) }}'
      sequence:
      - variables:
          is_map: '{{ next_scene.primary is mapping }}'
          target: "{% if is_map %}\n  {% set key = (next_scene.primary.keys() | list)[repeat.index
            - 1] %}\n  {{ [key] }}\n{% else %}\n  {{ [\"all\"] }}\n{% endif %}"
          val: "{% if is_map %}\n  {{ (next_scene.primary.values() | list)[repeat.index
            - 1] }}\n{% else %}\n  {{ next_scene.primary | default(0) }}\n{% endif
            %}"
      - event: universal_controller_command
        event_data:
          source_device: matrix_engine
          action_type: light_call
          area_key: '{{ area }}'
          target_label: '{{ target }}'
          action_value: '{{ val | int(0) if val != '''' else '''' }}'
          command_input: '{{ ''turn_off'' if val | int(0) == 0 and val != '''' else
            ''turn_on'' }}'
  - repeat:
      until:
      - condition: template
        value_template: '{{ repeat.index >= (next_scene.links.keys() | list | length
          if next_scene.links is mapping else 1) }}'
      sequence:
      - variables:
          link_area: '{{ (next_scene.links.keys() | list)[repeat.index - 1] if next_scene.links
            is mapping else none }}'
          link_data: '{{ (next_scene.links.values() | list)[repeat.index - 1] if next_scene.links
            is mapping else none }}'
      - condition: template
        value_template: '{{ link_area is not none }}'
      - repeat:
          until:
          - condition: template
            value_template: '{{ repeat.index >= (link_data.keys() | list | length
              if link_data is mapping else 1) }}

              '
          sequence:
          - variables:
              is_map: '{{ link_data is mapping }}'
              target: "{% if is_map %}\n  {% set key = (link_data.keys() | list)[repeat.index
                - 1] %}\n  {{ [key] }}\n{% else %}\n  {{ [\"all\"] }}\n{% endif %}"
              val: "{% if is_map %}\n  {{ (link_data.values() | list)[repeat.index
                - 1] }}\n{% else %}\n  {{ link_data | default(0) }}\n{% endif %}"
          - event: universal_controller_command
            event_data:
              source_device: matrix_engine_link
              action_type: light_call
              area_key: '{{ link_area }}'
              target_label: '{{ target }}'
              action_value: '{{ val | int(0) if val != '''' else '''' }}'
              command_input: '{{ ''turn_off'' if val | int(0) == 0 and val != ''''
                else ''turn_on'' }}'
  - if:
    - condition: template
      value_template: '{{ not is_lock_down }}'
    then:
    - variables:
        matrix_history_sensor: select.living_room_matrix_scene
        options: "{{ state_attr('sensor.' ~ area ~ '_matrix_scene_config', 'options')
          |\n  default(['0: off', '10: Relax', '20: Bright']) }}\n"
        friendly_name: '{{ state_attr(matrix_history_sensor,''friendly_name'') }}

          '
        icon: '{{ state_attr(matrix_history_sensor,''icon'') }}

          '
        history_stack: '{{ state_attr(matrix_history_sensor,''history_stack'') | default([],
          true) }}

          '
        attributes:
          options: '{{ options }}'
          friendly_name: '{{ friendly_name }}'
          icon: '{{ icon }}'
          history_stack: "{{ (history_stack + [ next_scene.sequence_weight ~ ': '
            ~ next_scene.name] )[-5:] }}   \n"
    - action: mqtt.publish
      data:
        topic: homeassistant/select/{{area}}/scene/attributes
        retain: true
        payload: '{{ attributes | to_json }}'
    - action: mqtt.publish
      data:
        topic: homeassistant/select/{{area}}/scene/state
        retain: true
        payload: "{\n  \"name\": \"{{ next_scene.name }}\",\n  \"sequence_weight\":
          {{ next_scene.sequence_weight }}\n}\n"
  mode: restart
- id: '1775925651978'
  alias: Bridge - Global Presence Orchestrator v1.4
  description: "# GPE - ORCHESTRATOR (V1.4) \n## 1. CORE PURPOSE \nActs as the central
    decision engine for environmental presence. Now fully  integrated with the Priority
    Intent Stack (Registry v5.6).\n## 2. ARCHITECTURAL LOGIC\n* **Priority Intent
    Integration**: All presence events are now tagged with \n  `intent_type: motion`
    to ensure they interact correctly with the \n  multi-layered priority stack.\n
    \ \n* **Polymorphic Execution**: Switches between `scene_cycle` and `light_call`
    \n  based on `scene_eligible` policy.\n  \n* **The Gatekeeper Pattern**: Suppresses
    redundant commands if the room \n  is already in the desired state.\n\n## 3. VERSION
    HISTORY\n* **V1.4**: Updated attribute paths from `active_timers` to `active_intents`.\n
    \ Standardized `intent_type` as 'motion' for all presence-based additions.\n  Updated
    variable mapping to match Registry v5.6. Decommissioned \n  `active_area_overrides`
    in favor of Registry-based override detection."
  triggers:
  - trigger: state
    entity_id: sensor.active_sensor_monitor_master
  conditions:
  - condition: template
    value_template: "{{ trigger.to_state.state not in ['none', 'unknown', 'unavailable']
      and\n   trigger.from_state.state != trigger.to_state.state and \n   is_ready
      }}"
  - condition: template
    value_template: "{# Veto if an 'override' intent is currently active in the stack
      #} \n{% set is_overridden = area_stack | selectattr('type', 'eq', 'override')
      | list | count > 0 %} \n\n{{ area_key != 'none' and not is_overridden }}\n"
  actions:
  - variables:
      event_ts: '{{ states[source_entity].last_changed }}'
      is_on: '{{ is_state(source_entity, ''on'') }}'
      has_presence_capability: '{{ (area_entities(area_key) | intersect(label_entities(''presence''))
        | count) > 0 }}'
      is_presence: '{{ ''presence'' in entity_labels }}'
      area_policy: '{{ labels(area_key) }}'
      is_night_policy_enabled: '{{ ''night_light'' in area_policy }}'
      house_is_in_night_posture: '{{ is_state(g_env.night_posture_sensor, ''on'')
        }}'
      use_night_settings: '{{ is_night_policy_enabled and house_is_in_night_posture
        }}'
      scene_data: '{{ state_attr(g_logic.scene_data, ''data'') | default({}, true)
        }}'
      current_scene: '{{ scene_data.get(area_key, {}).get(''name'', ''off'') | lower
        }}'
      is_room_off: '{{ current_scene == ''off'' }}'
      use_scene: '{{ ''scene_eligible'' in area_policy }}'
      call_scene: '{{ is_room_off and is_presence and is_on and use_scene }}'
      final_target_label: "{% if use_night_settings %} \n  {{ ['night_light'] }} \n{%
        elif is_night_policy_enabled %}\n  {{ ['main'] }} \n{% else %} \n  {{ [] }}
        \n{% endif %}\n"
      adjoining_area: '{{ registry.area_metadata.get(area_key, {}).get(''neighbors'',
        {}).get(''peer'', ''none'') }}'
      is_entrance: '{{ ''entrance'' in entity_labels }}'
      is_door: '{{ ''door'' in entity_labels }}'
      door_entity: '{{ (area_entities(area_key) | intersect(label_entities(''door'')))
        | first | default(''none'') }}'
      has_door: '{{ door_entity != ''none'' }}'
      is_lock_zone: '{{ ''lock_eligible'' in area_policy }}'
      is_area_locked: '{{ area_stack | selectattr(''locked'', ''eq'', true) | list
        | count > 0 }}'
      should_trigger_peer: '{{ is_door and is_on and area_key != ''none'' and adjoining_area
        != ''none'' }}'
      hvac_action: '{{ state_attr(g_hvac.primary_unit, ''hvac_action'') | default(''idle'')
        }}'
      fan_running: '{{ is_state_attr(g_hvac.primary_unit, ''fan'', ''on'') }}'
      hvac_is_active: '{{ hvac_action in g_hvac.monitored_states or fan_running }}'
      door_age: "{% if has_door and states[door_entity] is not none %}\n  {{ as_timestamp(now())
        - as_timestamp(states[door_entity].last_changed, 0) }}\n{% else %}\n  0\n{%
        endif %}\n"
      is_door_closed: '{{ is_state(door_entity, ''off'') if has_door else false }}'
      is_privacy_zone: '{{ has_door and ''lock_eligible'' in area_policy }}'
      is_ghost: "{% if not has_door %} \n  {{ false }}\n{% else %}\n  {{ is_presence
        and is_on and is_door_closed and not is_area_locked and (door_age > 600 or
        hvac_is_active) }}\n{% endif %}\n"
      should_lock_area: "{% if not is_privacy_zone %}\n  {{ false }}\n{% else %}\n
        \ {{ is_presence and is_on and is_door_closed and not is_area_locked and door_age
        < 120 }}\n{% endif %}\n"
      should_unlock_area: "{% if is_area_locked %}\n   {{ not is_on or (has_door and
        not is_door_closed) }}\n{% else %}\n   {{ false }}\n{% endif %}\n"
  - choose:
    - alias: Veto Log (Ghost Detected)
      conditions:
      - condition: template
        value_template: '{{ is_presence and is_on and is_ghost }}'
      sequence:
      - action: logbook.log
        data:
          name: GPE VETO
          message: 'GPE VETO: Ghost in {{ area_key }} (HVAC: {{ hvac_action }}, Door
            Age: {{ door_age | int }}s, Lock Status: {{ is_area_locked}})'
          entity_id: '{{ source_entity }}'
    - alias: Lock Presence (Sabbatical)
      conditions:
      - condition: template
        value_template: '{{ should_lock_area and not is_area_locked }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: lock
          area_key: '{{ area_key }}'
          intent_type: motion
      - action: logbook.log
        data:
          name: GPE LOCKED
          message: 'Locked Via {{ ''Motion'' if is_presence else ''Portal'' }} Room
            {{ area_key }} (Registry Reset{% if has_door %}, Door Age: {{ door_age
            | int }}s{% endif %})'
          entity_id: '{{ source_entity }}'
    - alias: Valid Turn On (Anti-Ghosting)
      conditions:
      - condition: template
        value_template: '{{ (is_entrance or is_door or (is_presence and not is_area_locked))
          and is_on and not is_ghost }}'
      sequence:
      - choose:
        - conditions:
          - condition: template
            value_template: '{{ not use_scene }}'
          sequence:
          - event: universal_controller_command
            event_data:
              action_type: light_call
              command_input: turn_on
              area_key: '{{ area_key }}'
              action_value: '{{ ''night_mode'' if use_night_settings else ''day_mode''
                }}'
              target_label: '{{ final_target_label }}'
              source_device: monitor
          - event: lighting_registry_update
            event_data:
              action: remove
              area_key: '{{ area_key }}'
              intent_type: motion
        - conditions:
          - condition: template
            value_template: '{{ use_scene }}'
          sequence:
          - if:
            - condition: template
              value_template: '{{ call_scene }}'
            then:
            - event: universal_controller_command
              event_data:
                action_type: scene_cycle
                command_input: turn_on
                area_key: '{{ area_key }}'
                action_value: restore
                target_label: '{{ final_target_label }}'
                source_device: monitor
            - event: lighting_registry_update
              event_data:
                action_type: remove
                area_key: '{{ area_key }}'
                intent_type: motion
      - action: logbook.log
        data:
          name: GPE
          message: 'Turn On: Via {{''Motion'' if is_presence else ''Portal'' }} Room
            {{ area_key }} (Registry Reset, Door Age: {{ door_age | int }}s)'
          entity_id: '{{ source_entity }}'
      - if:
        - condition: template
          value_template: '{{ is_door and has_presence_capability }}'
        then:
        - event: lighting_registry_update
          event_data:
            action: add
            area_key: '{{ area_key }}'
            intent_type: motion
            seconds: 10
            timestamp: '{{ event_ts }}'
    - alias: Presence Cleared (Start Cleaner)
      conditions:
      - condition: template
        value_template: '{{ is_presence and not is_on and not is_area_locked }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: add
          area_key: '{{ area_key }}'
          intent_type: motion
          seconds: '{{ 120 if has_presence_capability else 1800 }}'
          skip_warning: '{{ use_scene if use_scene else not is_lock_zone }}'
          timestamp: '{{ event_ts }}'
      - event: cleaner_heartbeat
      - action: logbook.log
        data:
          name: 'GPE Start '
          message: 'GPE: Start Cleaner {{ area_key }} Seconds: "{{ 120 if has_presence_capability
            else 1800 }}" Skip Warning: "{{  use_scene if use_scene else not is_lock_zone
            }}"'
          entity_id: '{{ source_entity }}'
    - alias: Door Closed Timer Reset
      conditions:
      - condition: template
        value_template: '{{ is_door and not is_on }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: add
          area_key: '{{ area_key }}'
          intent_type: motion
          seconds: '{{ 30 if has_presence_capability else 5 }}'
          skip_warning: '{{ not is_lock_zone }}'
          timestamp: '{{ event_ts }}'
      - action: logbook.log
        data:
          name: GPE Add
          message: 'GPE: Door Warning {{ area_key }} seconds: "{{ 30 if has_presence_capability
            else 5 }}" skip_warning: "{{ not is_lock_zone }}"'
          entity_id: '{{ source_entity }}'
    - alias: Presence Update (No or Open Door)
      conditions:
      - condition: template
        value_template: '{{ is_presence and is_on and (not has_door or not is_door_closed
          ) }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: add
          area_key: '{{ area_key }}'
          intent_type: motion
          seconds: 120
          timestamp: '{{ event_ts }}'
      - action: logbook.log
        data:
          name: GPE Add
          message: 'GPE: Reset {{ area_key }} Time Added 120s'
          entity_id: '{{ source_entity }}'
    - alias: Safety Unlock (Self-Healing)
      conditions:
      - condition: template
        value_template: '{{ should_unlock_area }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: remove
          area_key: '{{ area_key }}'
          intent_type: motion
        enabled: true
  - if:
    - condition: template
      value_template: '{{ should_trigger_peer }}'
    then:
    - event: universal_controller_command
      event_data:
        action_type: light_call
        command_input: turn_on
        area_key: '{{ adjoining_area }}'
        action_value: '{{ final_action_value }}'
        source_device: peer_preheat
  variables:
    registry: "{% set r = state_attr('sensor.global_variable_registry', 'vars') %}
      \n{{ r if r is not none else {} }}"
    g_env: '{{ registry.get(''globals'', {}).get(''environmental'', {}) }}'
    g_hvac: '{{ registry.get(''globals'', {}).get(''hvac'', {}) }}'
    g_logic: '{{ registry.get(''globals'', {}).get(''logic_engines'', {}) }}'
    source_entity: '{{ trigger.to_state.state.split(''@'')[0] }}'
    area_key: '{{ area_id(source_entity) | default(''none'') }}'
    entity_labels: '{{ labels(source_entity) }}'
    is_ready: '{{ g_env != {} and area_key != ''none'' }}'
    lighting_off_registry: '{{ g_logic.get(''lighting_off_registry'', ''none'') }}'
    area_stack: '{{ (state_attr(g_logic.lighting_off_registry, ''active_intents'')
      | default({}, true)).get(area_key, []) }}'
  mode: parallel
  max: 20
- id: '1775925714929'
  alias: Bridge - Global Presence Recursive Registry Cleaner v2.0
  description: Priority-aware cleaner for Lighting Registry v5.6
  triggers:
  - trigger: event
    event_type: cleaner_heartbeat
  - trigger: state
    entity_id: sensor.lighting_off_registry
    to: active
  actions:
  - variables:
      registry_data: '{{ state_attr(''sensor.lighting_off_registry'', ''active_intents'')
        or {} }}'
      log_dest: '{{ state_attr(''sensor.global_variable_registry'', ''vars'').globals.logic_engines.system_log
        }}'
  - repeat:
      for_each: '{{ registry_data.items() | list }}'
      sequence:
      - variables:
          area_key: '{{ repeat.item[0] }}'
          winning_intent: '{{ repeat.item[1] | sort(attribute=''priority'', reverse=true)
            | first }}'
          expiry: '{{ as_timestamp(winning_intent.expiry) | default(0) }}'
          is_locked: '{{ winning_intent.locked }}'
          is_warned: '{{ winning_intent.warned }}'
          skip_warning: '{{ winning_intent.skip_warning | default(false) }}'
          is_expired: '{{ as_timestamp(now()) >= expiry if expiry > 0 else false }}'
          area_policy: '{{ labels(area_key) }}'
          use_scene: '{{ ''scene_eligible'' in area_policy }}'
      - choose:
        - conditions:
          - condition: template
            value_template: '{{ is_locked or not is_expired }}'
          alias: Active or Locked
          sequence: []
        - conditions:
          - condition: template
            value_template: '{{ is_expired and (skip_warning or is_warned) }}'
          alias: Kill Intent / Turn Off
          sequence:
          - event: universal_controller_command
            event_data:
              action_type: '{{ ''scene_cycle'' if use_scene else ''light_call'' }}'
              command_input: '{{ '''' if use_scene else ''turn_off'' }}'
              action_value: 'off'
              area_key: '{{ area_key }}'
              source_device: GPE Cleaner
          - event: lighting_registry_update
            event_data:
              action: remove
              area_key: '{{ area_key }}'
              intent_type: '{{ winning_intent.type }}'
        - conditions:
          - condition: template
            value_template: '{{ is_expired and not is_warned }}'
          alias: Warn/Dim
          sequence:
          - event: universal_controller_command
            event_data:
              action_type: light_call
              command_input: turn_on
              action_value: min
              area_key: '{{ area_key }}'
              source_device: GPE Cleaner
          - event: lighting_registry_update
            event_data:
              action: warned
              area_key: '{{ area_key }}'
              intent_type: '{{ winning_intent.type }}'
  - if:
    - condition: template
      value_template: '{{ (state_attr(''sensor.lighting_off_registry'', ''active_intents'')
        or {}) | count > 0 }}'
    then:
    - delay: 00:00:05
    - event: cleaner_heartbeat
  mode: queued
  max: 10
- id: '1775927437973'
  alias: Testing - lighting_registry_update
  description: ''
  triggers:
  - trigger: mqtt
    options:
      topic: home/universal/bus
      value_template: '{{ value_json.action_type }}'
      payload: lighting_registry_update
  - trigger: event
    event_type: lighting_registry_update
  conditions: []
  actions:
  - variables:
      registry: '{{ state_attr(''sensor.global_variable_registry'', ''vars'') | default({},
        true) }}

        '
      g_env: '{{ registry.get(''environmental'', {}) }}

        '
      work: '{{ state_attr(''sensor.global_variable_registry'', ''vars'').get(''globals'',
        {}).get(''environmental'', {}).get(''override_duration_work'', 36000) | int
        }}'
      standard: '{{ state_attr(''sensor.global_variable_registry'', ''vars'').get(''globals'',
        {}).get(''environmental'', {}).get(''override_duration_standard'', 3600) |
        int }}'
      payload: '{{ trigger.event.data }}'
      area: '{{ payload.area_key }}'
      is_work_area: '{{ (''work'' in (labels(area) | default([], true))) }}'
      current: '{{ state_attr(''sensor.lighting_off_registry'', ''active_intents'')
        or {} }}'
      p: '{{ payload}}'
  - variables:
      action: '{{ p.action }}'
      cid: '{{ payload.claimant_id | default(payload.owner_id | default(payload.owner
        | default(''system''))) }}'
      seconds: '{{ p.seconds | default(120) | int  }}'
      intent_type: '{{ ''override'' if (p.intent_type == ''override'' or p.action_type
        == ''light_override'') else ''motion'' }}'
      entry: '{{ { ''type'': intent_type, ''claimant'': cid, ''priority'': 2 if intent_type
        == ''override'' else 1, ''expiry'': (now() + timedelta(seconds=seconds)).isoformat()
        if seconds > 0 else (none if seconds < 0 else now().isoformat()), ''locked'':
        payload.locked | default(false), ''warned'': false, ''skip_warning'': payload.skip_warning
        | default(false) } }}'
      others: '{{ current.get(area, []) | rejectattr(''claimant'', ''eq'', cid) |
        list }}'
      returned: '{{ dict(current, **{area: others + [entry]}) }}'
      new_stk: '{{ current[area] | rejectattr(''claimant'', ''eq'', cid) | list }}'
      empty: "{% set ns = namespace(res={}) %} {% for k, v in current.items() if k
        != area %}\n  {% set ns.res = dict(ns.res, **{k: v}) %}\n{% endfor %} {{ ns.res
        }}"
  - variables:
      active_intents: "{% set p = payload %}\n          \n{# Veto if MQTT and not
        a registry action #} \n{% if trigger.platform == 'mqtt' and p.action_type
        not in ['lighting_registry_update', 'light_override'] %}\n  {{ current }}\n{%
        else %}\n\n  {# Unified Claimant ID Standard (Bridging older naming conventions)
        #}\n  \n  \n  {% if area is none %}\n    {{ current }}\n  {% else %}\n    {#
        ACTION: ADD / UPDATE #}\n    {% if p.action == 'add' or (p.action_type ==
        'light_override') %}\n      {% set seconds = p.seconds | default(120) | int
        %}\n      {% set intent_type = 'override' if (p.intent_type == 'override'
        or p.action_type == 'light_override') else 'motion' %}\n      {% set entry
        = {\n        'type': intent_type,\n        'claimant': cid,\n        'priority':
        2 if intent_type == 'override' else 1,\n        'expiry': (now() + timedelta(seconds=seconds)).isoformat()
        if seconds > 0 else (none if seconds < 0 else now().isoformat()),\n        'locked':
        p.locked | default(false),\n        'warned': false,\n        'skip_warning':
        p.skip_warning | default(false)\n      } %}\n      {% set others = current.get(area,
        []) | rejectattr('claimant', 'eq', cid) | list %}\n      \n      {{ dict(current,
        **{area: others + [entry]}) }}\n\n    {# ACTION: WARNED #}\n    {% elif p.action
        == 'warned' and area in current %}\n      {% set ns = namespace(stk=[]) %}\n
        \     {% for i in current[area] %}\n        {% set ns.stk = ns.stk + [dict(i,
        warned=true, expiry=(now() + timedelta(seconds=20)).isoformat()) if i.claimant
        == cid else i] %}\n      {% endfor %}\n      {{ dict(current, **{area: ns.stk})
        }}\n\n    {# ACTION: REMOVE #}\n    {% elif p.action == 'remove' and area
        in current %}\n\n        {% if new_stk | count > 0 %}\n          {{ dict(current,
        **{area: new_stk}) }}\n        {% else %}\n          {% set ns = namespace(res={})
        %}\n          {% for k, v in current.items() if k != area %}\n            {%
        set ns.res = dict(ns.res, **{k: v}) %}\n          {% endfor %}\n          {{
        ns.res }}\n        {% endif %}\n\n    {# ACTION: LOCK #}\n    {% elif p.action
        == 'lock' and area in current %}\n       {% set ns = namespace(stk=[]) %}\n
        \      {% for i in current[area] %}\n         {% set ns.stk = ns.stk + [dict(i,
        locked=true, expiry=none) if i.claimant == cid else i] %}\n       {% endfor
        %}\n       {{ dict(current, **{area: ns.stk}) }}\n    {% else %}\n      {{
        current }}\n    {% endif %}\n  {% endif %}\n{% endif %}"
  mode: single
- id: '1776011184643'
  alias: GPE - Orchestrator (V1.5)
  description: "# GPE - ORCHESTRATOR (V1.5) \n## 1. CORE PURPOSE \nActs as the central
    decision engine for environmental presence. Now fully  integrated with the Priority
    Intent Stack (Registry v5.6).\n## 2. ARCHITECTURAL LOGIC\n* **Priority Intent
    Integration**: All presence events are now tagged with \n  `intent_type: motion`
    to ensure they interact correctly with the \n  multi-layered priority stack.\n
    \ \n* **Polymorphic Execution**: Switches between `scene_cycle` and `light_call`
    \n  based on `scene_eligible` policy.\n  \n* **The Gatekeeper Pattern**: Suppresses
    redundant commands if the room \n  is already in the desired state.\n\n## 3. VERSION
    HISTORY\n* **V1.4**: Updated attribute paths from `active_timers` to `active_intents`.\n
    \ Standardized `intent_type` as 'motion' for all presence-based additions.\n  Updated
    variable mapping to match Registry v5.6. Decommissioned \n  `active_area_overrides`
    in favor of Registry-based override detection."
  triggers:
  - trigger: state
    entity_id: sensor.active_sensor_monitor_master
  conditions:
  - condition: template
    value_template: "{{ trigger.to_state.state not in ['none', 'unknown', 'unavailable']
      and\n   trigger.from_state.state != trigger.to_state.state and \n   is_ready
      }}"
  - condition: template
    value_template: "{# Veto if an 'override' intent is currently active in the stack
      #} \n{% set is_overridden = area_stack | selectattr('type', 'eq', 'override')
      | list | count > 0 %} \n\n{{ area_key != 'none' and not is_overridden }}\n"
  actions:
  - variables:
      event_ts: '{{ states[source_entity].last_changed }}'
      is_on: '{{ is_state(source_entity, ''on'') }}'
      has_presence_capability: '{{ (area_entities(area_key) | intersect(label_entities(''presence''))
        | count) > 0 }}'
      is_presence: '{{ ''presence'' in entity_labels }}'
      area_policy: '{{ labels(area_key) }}'
      is_night_policy_enabled: '{{ ''night_light'' in area_policy }}'
      house_is_in_night_posture: '{{ is_state(g_env.night_posture_sensor, ''on'')
        }}'
      use_night_settings: '{{ is_night_policy_enabled and house_is_in_night_posture
        }}'
      scene_data: '{{ state_attr(g_logic.scene_data, ''data'') | default({}, true)
        }}'
      current_scene: '{{ scene_data.get(area_key, {}).get(''name'', ''off'') | lower
        }}'
      is_room_off: '{{ current_scene == ''off'' }}'
      use_scene: '{{ ''scene_eligible'' in area_policy }}'
      call_scene: '{{ is_room_off and is_presence and is_on and use_scene }}'
      final_target_label: "{% if use_night_settings %} \n  {{ ['night_light'] }} \n{%
        elif is_night_policy_enabled %}\n  {{ ['main'] }} \n{% else %} \n  {{ [] }}
        \n{% endif %}\n"
      adjoining_area: '{{ registry.area_metadata.get(area_key, {}).get(''neighbors'',
        {}).get(''peer'', ''none'') }}'
      is_entrance: '{{ ''entrance'' in entity_labels }}'
      is_door: '{{ ''door'' in entity_labels }}'
      door_entity: '{{ (area_entities(area_key) | intersect(label_entities(''door'')))
        | first | default(''none'') }}'
      has_door: '{{ door_entity != ''none'' }}'
      is_lock_zone: '{{ ''lock_eligible'' in area_policy }}'
      is_area_locked: '{{ area_stack | selectattr(''locked'', ''eq'', true) | list
        | count > 0 }}'
      should_trigger_peer: '{{ is_door and is_on and area_key != ''none'' and adjoining_area
        != ''none'' }}'
      hvac_action: '{{ state_attr(g_hvac.primary_unit, ''hvac_action'') | default(''idle'')
        }}'
      fan_running: '{{ is_state_attr(g_hvac.primary_unit, ''fan'', ''on'') }}'
      hvac_is_active: '{{ hvac_action in g_hvac.monitored_states or fan_running }}'
      door_age: "{% if has_door and states[door_entity] is not none %}\n  {{ as_timestamp(now())
        - as_timestamp(states[door_entity].last_changed, 0) }}\n{% else %}\n  0\n{%
        endif %}\n"
      is_door_closed: '{{ is_state(door_entity, ''off'') if has_door else false }}'
      is_privacy_zone: '{{ has_door and ''lock_eligible'' in area_policy }}'
      is_ghost: "{% if not has_door %} \n  {{ false }}\n{% else %}\n  {{ is_presence
        and is_on and is_door_closed and not is_area_locked and (door_age > 600 or
        hvac_is_active) }}\n{% endif %}\n"
      should_lock_area: "{% if not is_privacy_zone %}\n  {{ false }}\n{% else %}\n
        \ {{ is_presence and is_on and is_door_closed and not is_area_locked and door_age
        < 120 }}\n{% endif %}\n"
      should_unlock_area: "{% if is_area_locked %}\n   {{ not is_on or (has_door and
        not is_door_closed) }}\n{% else %}\n   {{ false }}\n{% endif %}\n"
  - choose:
    - alias: Veto Log (Ghost Detected)
      conditions:
      - condition: template
        value_template: '{{ is_presence and is_on and is_ghost }}'
      sequence:
      - action: logbook.log
        data:
          name: GPE VETO
          message: 'GPE VETO: Ghost in {{ area_key }} (HVAC: {{ hvac_action }}, Door
            Age: {{ door_age | int }}s, Lock Status: {{ is_area_locked}})'
          entity_id: '{{ source_entity }}'
    - alias: Lock Presence (Sabbatical)
      conditions:
      - condition: template
        value_template: '{{ should_lock_area and not is_area_locked }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: lock
          owner: '{{ source_entity }}'
          area_key: '{{ area_key }}'
          intent_type: motion
      - action: logbook.log
        data:
          name: GPE LOCKED
          message: 'Locked Via {{ ''Motion'' if is_presence else ''Portal'' }} Room
            {{ area_key }} (Registry Reset{% if has_door %}, Door Age: {{ door_age
            | int }}s{% endif %})'
          entity_id: '{{ source_entity }}'
    - alias: Valid Turn On (Anti-Ghosting)
      conditions:
      - condition: template
        value_template: '{{ (is_entrance or is_door or (is_presence and not is_area_locked))
          and is_on and not is_ghost }}'
      sequence:
      - choose:
        - conditions:
          - condition: template
            value_template: '{{ not use_scene }}'
          sequence:
          - event: universal_controller_command
            event_data:
              action_type: light_call
              command_input: turn_on
              area_key: '{{ area_key }}'
              action_value: '{{ ''night_mode'' if use_night_settings else ''day_mode''
                }}'
              target_label: '{{ final_target_label }}'
              source_device: monitor
          - event: lighting_registry_update
            event_data:
              action: add
              owner: '{{ source_entity }}'
              area_key: '{{ area_key }}'
              seconds: -1
              locked: false
              skip_warning: true
              timestamp: '{{ event_ts }}'
              intent_type: motion
        - conditions:
          - condition: template
            value_template: '{{ use_scene }}'
          sequence:
          - if:
            - condition: template
              value_template: '{{ call_scene }}'
            then:
            - event: universal_controller_command
              event_data:
                action_type: scene_cycle
                command_input: turn_on
                area_key: '{{ area_key }}'
                action_value: restore
                target_label: '{{ final_target_label }}'
                source_device: monitor
            - event: lighting_registry_update
              event_data:
                action: add
                owner: '{{ source_entity }}'
                area_key: '{{ area_key }}'
                seconds: -1
                locked: true
                skip_warning: true
                timestamp: '{{ event_ts }}'
                intent_type: override
      - action: logbook.log
        data:
          name: GPE
          message: 'Turn On: Via {{''Motion'' if is_presence else ''Portal'' }} Room
            {{ area_key }} (Registry Reset, Door Age: {{ door_age | int }}s)'
          entity_id: '{{ source_entity }}'
      - if:
        - condition: template
          value_template: '{{ is_door and has_presence_capability }}'
        then:
        - event: lighting_registry_update
          event_data:
            action: add
            owner: '{{ source_entity }}'
            area_key: '{{ area_key }}'
            intent_type: motion
            seconds: 10
            timestamp: '{{ event_ts }}'
    - alias: Presence Cleared (Start Cleaner)
      conditions:
      - condition: template
        value_template: '{{ is_presence and not is_on and not is_area_locked }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: add
          owner: '{{ source_entity }}'
          area_key: '{{ area_key }}'
          intent_type: motion
          seconds: '{{ 120 if has_presence_capability else 1800 }}'
          skip_warning: '{{ use_scene if use_scene else not is_lock_zone }}'
          timestamp: '{{ event_ts }}'
      - event: cleaner_heartbeat
      - action: logbook.log
        data:
          name: 'GPE Start '
          message: 'GPE: Start Cleaner {{ area_key }} Seconds: "{{ 120 if has_presence_capability
            else 1800 }}" Skip Warning: "{{  use_scene if use_scene else not is_lock_zone
            }}"'
          entity_id: '{{ source_entity }}'
    - alias: Door Closed Timer Reset
      conditions:
      - condition: template
        value_template: '{{ is_door and not is_on }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: add
          owner: '{{ source_entity }}'
          area_key: '{{ area_key }}'
          intent_type: motion
          seconds: '{{ 30 if has_presence_capability else 5 }}'
          skip_warning: '{{ not is_lock_zone }}'
          timestamp: '{{ event_ts }}'
      - action: logbook.log
        data:
          name: GPE Add
          message: 'GPE: Door Warning {{ area_key }} seconds: "{{ 30 if has_presence_capability
            else 5 }}" skip_warning: "{{ not is_lock_zone }}"'
          entity_id: '{{ source_entity }}'
    - alias: Presence Update (No or Open Door)
      conditions:
      - condition: template
        value_template: '{{ is_presence and is_on and (not has_door or not is_door_closed
          ) }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: add
          owner: '{{ source_entity }}'
          area_key: '{{ area_key }}'
          intent_type: motion
          seconds: 120
          timestamp: '{{ event_ts }}'
      - action: logbook.log
        data:
          name: GPE Add
          message: 'GPE: Reset {{ area_key }} Time Added 120s'
          entity_id: '{{ source_entity }}'
    - alias: Safety Unlock (Self-Healing)
      conditions:
      - condition: template
        value_template: '{{ should_unlock_area }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: remove
          owner: '{{ source_entity }}'
          area_key: '{{ area_key }}'
          intent_type: motion
        enabled: true
  - if:
    - condition: template
      value_template: '{{ should_trigger_peer }}'
    then:
    - event: universal_controller_command
      event_data:
        action_type: light_call
        command_input: turn_on
        area_key: '{{ adjoining_area }}'
        action_value: '{{ final_action_value }}'
        source_device: peer_preheat
  mode: parallel
  variables:
    registry: "{% set r = state_attr('sensor.global_variable_registry', 'vars') %}
      \n{{ r if r is not none else {} }}"
    g_env: '{{ registry.get(''globals'', {}).get(''environmental'', {}) }}'
    g_hvac: '{{ registry.get(''globals'', {}).get(''hvac'', {}) }}'
    g_logic: '{{ registry.get(''globals'', {}).get(''logic_engines'', {}) }}'
    source_entity: '{{ trigger.to_state.state.split(''@'')[0] }}'
    area_key: '{{ area_id(source_entity) | default(''none'') }}'
    entity_labels: '{{ labels(source_entity) }}'
    is_ready: '{{ g_env != {} and area_key != ''none'' }}'
    lighting_off_registry: '{{ g_logic.get(''lighting_off_registry'', ''none'') }}'
    area_stack: '{{ (state_attr(g_logic.lighting_off_registry, ''active_intents'')
      | default({}, true)).get(area_key, []) }}'
  max: 20
- id: '1776013093493'
  alias: GPE - Orchestrator (V2.0)
  description: "# GPE - ORCHESTRATOR (V2.0) \n## 1. CORE PURPOSE \nActs as the central
    decision engine for environmental presence. Now fully  integrated with the Priority
    Intent Stack (Registry v5.7).\n## 2. ARCHITECTURAL LOGIC\n* **Priority Intent
    Integration**: All presence events are now tagged with \n  `intent_type: motion`
    to ensure they interact correctly with the \n  multi-layered priority stack.\n
    \ \n* **Polymorphic Execution**: Switches between `scene_cycle` and `light_call`
    \n  based on `scene_eligible` policy.\n  \n* **The Gatekeeper Pattern**: Suppresses
    redundant commands if the room \n  is already in the desired state.\n\n## 3. VERSION
    HISTORY\n* **V2.0**: Implemented Multi-Tenant Ownership tracking (`owner_id`).
    \n  Standardized event schema for Registry v5.7 compatibility. \n  Optimized variable
    block for performance and reliability.\n* **V1.5**: Updated attribute paths from
    `active_timers` to `active_intents`.\n  Standardized `intent_type` as 'motion'
    for all presence-based additions.\n  Updated variable mapping to match Registry
    v5.6. Decommissioned \n  `active_area_overrides` in favor of Registry-based override
    detection."
  triggers:
  - trigger: state
    entity_id: sensor.active_sensor_monitor_master
  conditions:
  - condition: template
    value_template: "{{ trigger.to_state.state not in ['none', 'unknown', 'unavailable']
      and\n   trigger.from_state.state != trigger.to_state.state and \n   is_ready
      }}"
  - condition: template
    value_template: '{# Veto if an ''override'' intent is currently active in the
      stack #}  {% set is_overridden = area_stack | selectattr(''type'', ''eq'', ''override'')
      | list | count > 0 %}  {{ area_key != ''none'' and not is_overridden }}

      '
  actions:
  - choose:
    - alias: Veto Log (Ghost Detected)
      conditions:
      - condition: template
        value_template: '{{ is_presence and is_on and is_ghost }}'
      sequence:
      - action: logbook.log
        data:
          name: GPE VETO
          message: 'GPE VETO: Ghost in {{ area_key }} (HVAC: {{ hvac_action }}, Door
            Age: {{ door_age | int }}s, Lock Status: {{ is_area_locked}})'
          entity_id: '{{ source_entity }}'
    - alias: Lock Presence (Sabbatical)
      conditions:
      - condition: template
        value_template: '{{ should_lock_area and not is_area_locked }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: lock
          owner_id: '{{ source_entity }}'
          area_key: '{{ area_key }}'
          intent_type: motion
      - action: logbook.log
        data:
          name: GPE LOCKED
          message: 'Locked Via {{ ''Motion'' if is_presence else ''Portal'' }} Room
            {{ area_key }} (Registry Reset{% if has_door %}, Door Age: {{ door_age
            | int }}s{% endif %})'
          entity_id: '{{ source_entity }}'
    - alias: Valid Turn On (Anti-Ghosting)
      conditions:
      - condition: template
        value_template: '{{ (is_entrance or is_door or (is_presence and not is_area_locked))
          and is_on and not is_ghost }}'
      sequence:
      - choose:
        - conditions:
          - condition: template
            value_template: '{{ not use_scene }}'
          sequence:
          - event: universal_controller_command
            event_data:
              action_type: light_call
              command_input: turn_on
              area_key: '{{ area_key }}'
              action_value: '{{ ''night_mode'' if use_night_settings else ''day_mode''
                }}'
              target_label: '{{ final_target_label }}'
              source_device: monitor
          - event: lighting_registry_update
            event_data:
              action: add
              owner_id: '{{ source_entity }}'
              area_key: '{{ area_key }}'
              seconds: -1
              intent_type: motion
        - conditions:
          - condition: template
            value_template: '{{ use_scene }}'
          sequence:
          - if:
            - condition: template
              value_template: '{{ call_scene }}'
            then:
            - event: universal_controller_command
              event_data:
                action_type: scene_cycle
                command_input: turn_on
                area_key: '{{ area_key }}'
                action_value: restore
                target_label: '{{ final_target_label }}'
                source_device: monitor
            - event: lighting_registry_update
              event_data:
                action: add
                owner_id: '{{ source_entity }}'
                area_key: '{{ area_key }}'
                seconds: -1
                intent_type: override
                locked: true
      - action: logbook.log
        data:
          name: GPE
          message: 'Turn On: Via {{''Motion'' if is_presence else ''Portal'' }} Room
            {{ area_key }} (Registry Reset, Door Age: {{ door_age | int }}s)'
          entity_id: '{{ source_entity }}'
    - alias: Presence Cleared (Start Cleaner)
      conditions:
      - condition: template
        value_template: '{{ is_presence and not is_on and not is_area_locked }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: '{{ ''remove'' if is_presence else ''add'' }}'
          owner_id: '{{ source_entity }}'
          area_key: '{{ area_key }}'
          intent_type: motion
          seconds: '{{ 120 if has_presence_capability else 1800 }}'
          skip_warning: '{{ use_scene if use_scene else not is_lock_zone }}'
      - event: cleaner_heartbeat
    - alias: Door Closed Timer Reset
      conditions:
      - condition: template
        value_template: '{{ is_door and not is_on }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: add
          owner_id: '{{ source_entity }}'
          area_key: '{{ area_key }}'
          intent_type: motion
          seconds: '{{ 30 if has_presence_capability else 5 }}'
          skip_warning: '{{ not is_lock_zone }}'
    - alias: Presence Update (Motion Reset)
      conditions:
      - condition: template
        value_template: '{{ is_presence and is_on and (not has_door or not is_door_closed
          ) }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: add
          owner_id: '{{ source_entity }}'
          area_key: '{{ area_key }}'
          intent_type: motion
          seconds: 120
    - alias: Safety Unlock (Self-Healing)
      conditions:
      - condition: template
        value_template: '{{ should_unlock_area }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: remove
          owner_id: '{{ source_entity }}'
          area_key: '{{ area_key }}'
          intent_type: motion
  - if:
    - condition: template
      value_template: '{{ should_trigger_peer }}'
    then:
    - event: universal_controller_command
      event_data:
        action_type: light_call
        command_input: turn_on
        area_key: '{{ adjoining_area }}'
        action_value: preheat
        source_device: peer_preheat
  mode: parallel
  variables:
    registry: '{{ state_attr(''sensor.global_variable_registry'', ''vars'') | default({},
      true) }}'
    g_env: '{{ registry.get(''globals'', {}).get(''environmental'', {}) }}'
    g_hvac: '{{ registry.get(''globals'', {}).get(''hvac'', {}) }}'
    g_logic: '{{ registry.get(''globals'', {}).get(''logic_engines'', {}) }}'
    source_entity: '{{ trigger.to_state.state.split(''@'')[0] }}'
    area_key: '{{ area_id(source_entity) | default(''none'') }}'
    entity_labels: '{{ labels(source_entity) }}'
    is_ready: '{{ g_env != {} and area_key != ''none'' }}'
    area_stack: '{{ (state_attr(''sensor.lighting_off_registry'', ''active_intents'')
      | default({}, true)).get(area_key, []) }}'
    is_on: '{{ is_state(source_entity, ''on'') }}'
    is_presence: '{{ ''presence'' in entity_labels }}'
    is_door: '{{ ''door'' in entity_labels }}'
    is_entrance: '{{ ''entrance'' in entity_labels }}'
    area_policy: '{{ labels(area_key) }}'
    use_scene: '{{ ''scene_eligible'' in area_policy }}'
    scene_data: '{{ state_attr(g_logic.scene_data, ''data'') | default({}, true) }}'
    current_scene: '{{ scene_data.get(area_key, {}).get(''name'', ''off'') | lower
      }}'
    is_room_off: '{{ current_scene == ''off'' }}'
    call_scene: '{{ is_room_off and is_presence and is_on and use_scene }}'
    use_night_settings: '{{ ''night_light'' in area_policy and is_state(g_env.night_posture_sensor,
      ''on'') }}'
    final_target_label: '{% if use_night_settings %} {{ [''night_light''] }}  {% elif
      ''night_light'' in area_policy %} {{ [''main''] }}  {% else %} {{ [] }} {% endif
      %}

      '
    adjoining_area: '{{ registry.get(''area_metadata'', {}).get(area_key, {}).get(''neighbors'',
      {}).get(''peer'', ''none'') }}'
    door_entity: '{{ (area_entities(area_key) | intersect(label_entities(''door'')))
      | first | default(''none'') }}'
    has_door: '{{ door_entity != ''none'' }}'
    is_door_closed: '{{ is_state(door_entity, ''off'') if has_door else false }}'
    door_age: '{{ as_timestamp(now()) - as_timestamp(states[door_entity].last_changed,
      0) if has_door else 0 }}'
    is_lock_zone: '{{ ''lock_eligible'' in area_policy }}'
    is_area_locked: '{{ area_stack | selectattr(''locked'', ''eq'', true) | list |
      count > 0 }}'
    hvac_action: '{{ state_attr(g_hvac.primary_unit, ''hvac_action'') | default(''idle'')
      }}'
    hvac_is_active: '{{ hvac_action in g_hvac.monitored_states or is_state_attr(g_hvac.primary_unit,
      ''fan'', ''on'') }}'
    is_ghost: '{{ has_door and is_presence and is_on and is_door_closed and not is_area_locked
      and (door_age > 600 or hvac_is_active) }}'
    should_lock_area: '{{ is_lock_zone and is_presence and is_on and is_door_closed
      and not is_area_locked and door_age < 120 }}'
    should_unlock_area: '{{ is_area_locked and (not is_on or (has_door and not is_door_closed))
      }}'
    should_trigger_peer: '{{ is_door and is_on and area_key != ''none'' and adjoining_area
      != ''none'' }}'
  max: 20
- id: '1776014883408'
  alias: GPE - Orchestrator (V2.1)
  description: "# GPE - ORCHESTRATOR (V2.1) \n## 1. CORE PURPOSE\nActs as the central
    decision engine for environmental presence.  Standardized on 'claimant_id' for
    Registry v5.8 compatibility. Now fully  integrated with the Priority Intent Stack.\n##
    2. ARCHITECTURAL LOGIC\n* **Priority Intent Integration**: All presence events
    are now tagged with \n  `intent_type: motion` to ensure they interact correctly
    with the \n  multi-layered priority stack.\n  \n* **Polymorphic Execution**: Switches
    between `scene_cycle` and `light_call` \n  based on `scene_eligible` policy.\n
    \ \n* **The Gatekeeper Pattern**: Suppresses redundant commands if the room \n
    \ is already in the desired state.\n\n## 3. VERSION HISTORY\n* **V2.1**: Enforced
    'claimant_id' across all actions.  * **V2.0**: Implemented Multi-Tenant Ownership.
    * **V2.0**: Implemented Multi-Tenant Ownership tracking (`owner_id`). \n  Standardized
    event schema for Registry v5.7 compatibility. \n  Optimized variable block for
    performance and reliability.\n* **V1.5**: Updated attribute paths from `active_timers`
    to `active_intents`.\n  Standardized `intent_type` as 'motion' for all presence-based
    additions.\n  Updated variable mapping to match Registry v5.6. Decommissioned
    \n  `active_area_overrides` in favor of Registry-based override detection."
  triggers:
  - trigger: state
    entity_id: sensor.active_sensor_monitor_master
  conditions:
  - condition: template
    value_template: "{{ trigger.to_state.state not in ['none', 'unknown', 'unavailable']
      and\n   trigger.from_state.state != trigger.to_state.state and \n   is_ready
      }}"
  - condition: template
    value_template: '{% set is_overridden = area_stack | selectattr(''type'', ''eq'',
      ''override'') | list | count > 0 %}  {{ area_key != ''none'' and not is_overridden
      }}

      '
  actions:
  - choose:
    - alias: Veto Log (Ghost Detected)
      conditions:
      - condition: template
        value_template: '{{ is_presence and is_on and is_ghost }}'
      sequence:
      - action: logbook.log
        data:
          name: GPE VETO
          message: Ghost Veto in {{ area_key }}
          entity_id: '{{ source_entity }}'
    - alias: Lock Presence (Sabbatical)
      conditions:
      - condition: template
        value_template: '{{ should_lock_area and not is_area_locked }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: lock
          claimant_id: '{{ source_entity }}'
          area_key: '{{ area_key }}'
          intent_type: motion
    - alias: Valid Turn On
      conditions:
      - condition: template
        value_template: '{{ (is_entrance or is_door or (is_presence and not is_area_locked))
          and is_on and not is_ghost }}'
      sequence:
      - choose:
        - conditions:
          - condition: template
            value_template: '{{ not use_scene }}'
          sequence:
          - event: universal_controller_command
            event_data:
              action_type: light_call
              command_input: turn_on
              area_key: '{{ area_key }}'
              action_value: '{{ ''night_mode'' if use_night_settings else ''day_mode''
                }}'
              target_label: '{{ final_target_label }}'
          - event: lighting_registry_update
            event_data:
              action: add
              claimant_id: '{{ source_entity }}'
              area_key: '{{ area_key }}'
              seconds: -1
              intent_type: motion
        - conditions:
          - condition: template
            value_template: '{{ use_scene }}'
          sequence:
          - if:
            - condition: template
              value_template: '{{ call_scene }}'
            then:
            - event: universal_controller_command
              event_data:
                action_type: scene_cycle
                area_key: '{{ area_key }}'
                action_value: restore
            - event: lighting_registry_update
              event_data:
                action: add
                claimant_id: '{{ source_entity }}'
                area_key: '{{ area_key }}'
                seconds: -1
                intent_type: override
                locked: true
    - alias: Presence Cleared
      conditions:
      - condition: template
        value_template: '{{ is_presence and not is_on and not is_area_locked }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: '{{ ''remove'' if is_presence else ''add'' }}'
          claimant_id: '{{ source_entity }}'
          area_key: '{{ area_key }}'
          intent_type: motion
          seconds: '{{ 120 if has_presence_capability else 1800 }}'
          skip_warning: '{{ use_scene }}'
  - if:
    - condition: template
      value_template: '{{ should_trigger_peer }}'
    then:
    - event: universal_controller_command
      event_data:
        action_type: light_call
        command_input: turn_on
        area_key: '{{ adjoining_area }}'
        action_value: preheat
  mode: parallel
  variables:
    registry: '{{ state_attr(''sensor.global_variable_registry'', ''vars'') | default({},
      true) }}'
    g_env: '{{ registry.get(''globals'', {}).get(''environmental'', {}) }}'
    source_entity: '{{ trigger.to_state.state.split(''@'')[0] }}'
    area_key: '{{ area_id(source_entity) | default(''none'') }}'
    entity_labels: '{{ labels(source_entity) }}'
    is_ready: '{{ g_env != {} and area_key != ''none'' }}'
    area_stack: '{{ (state_attr(''sensor.lighting_off_registry'', ''active_intents'')
      | default({}, true)).get(area_key, []) }}'
    is_on: '{{ is_state(source_entity, ''on'') }}'
    is_presence: '{{ ''presence'' in entity_labels }}'
    is_door: '{{ ''door'' in entity_labels }}'
    is_entrance: '{{ ''entrance'' in entity_labels }}'
    area_policy: '{{ labels(area_key) }}'
    use_scene: '{{ ''scene_eligible'' in area_policy }}'
    scene_data: '{{ state_attr(registry.get(''globals'', {}).get(''logic_engines'',
      {}).get(''scene_data''), ''data'') | default({}, true) }}'
    is_room_off: '{{ scene_data.get(area_key, {}).get(''name'', ''off'') | lower ==
      ''off'' }}'
    call_scene: '{{ is_room_off and is_presence and is_on and use_scene }}'
    use_night_settings: '{{ ''night_light'' in area_policy and is_state(g_env.night_posture_sensor,
      ''on'') }}'
    final_target_label: '{% if use_night_settings %} {{ [''night_light''] }} {% else
      %} {{ [''main''] }} {% endif %}'
    adjoining_area: '{{ registry.get(''area_metadata'', {}).get(area_key, {}).get(''neighbors'',
      {}).get(''peer'', ''none'') }}'
    door_entity: '{{ (area_entities(area_key) | intersect(label_entities(''door'')))
      | first | default(''none'') }}'
    has_door: '{{ door_entity != ''none'' }}'
    is_door_closed: '{{ is_state(door_entity, ''off'') if has_door else false }}'
    door_age: '{{ as_timestamp(now()) - as_timestamp(states[door_entity].last_changed,
      0) if has_door else 0 }}'
    is_lock_zone: '{{ ''lock_eligible'' in area_policy }}'
    is_area_locked: '{{ area_stack | selectattr(''locked'', ''eq'', true) | list |
      count > 0 }}'
    hvac_is_active: '{{ state_attr(registry.get(''globals'', {}).get(''hvac'', {}).get(''primary_unit''),
      ''hvac_action'') in [''cooling'', ''heating''] }}'
    is_ghost: '{{ has_door and is_presence and is_on and is_door_closed and not is_area_locked
      and (door_age > 600 or hvac_is_active) }}'
    should_lock_area: '{{ is_lock_zone and is_presence and is_on and is_door_closed
      and not is_area_locked and door_age < 120 }}'
    should_unlock_area: '{{ is_area_locked and (not is_on or (has_door and not is_door_closed))
      }}'
    should_trigger_peer: '{{ is_door and is_on and area_key != ''none'' and adjoining_area
      != ''none'' }}'
  max: 20
- id: '1776015155080'
  alias: Bridge - Global Presence Recursive Registry Cleaner v2.1
  description: Standardized Claimant-Based Cleaner (v5.8)
  triggers:
  - trigger: event
    event_type: cleaner_heartbeat
  - trigger: state
    entity_id: sensor.lighting_off_registry
    to: active
  actions:
  - variables:
      registry_data: '{{ state_attr(''sensor.lighting_off_registry'', ''active_intents'')
        or {} }}'
  - repeat:
      for_each: '{{ registry_data.items() | list }}'
      sequence:
      - variables:
          area_key: '{{ repeat.item[0] }}'
          winning_intent: '{{ repeat.item[1] | sort(attribute=''priority'', reverse=true)
            | first }}'
          claimant: '{{ winning_intent.claimant }}'
          expiry: '{{ as_timestamp(winning_intent.expiry) if winning_intent.expiry
            is not none else 9999999999 }}

            '
          is_locked: '{{ winning_intent.locked }}'
          is_warned: '{{ winning_intent.warned }}'
          skip_warning: '{{ winning_intent.skip_warning | default(false) }}'
          is_expired: '{{ as_timestamp(now()) >= expiry if expiry > 0 else false }}'
          area_policy: '{{ labels(area_key) | default([], true) }}'
          use_scene: '{{ ''scene_eligible'' in area_policy }}'
      - choose:
        - conditions:
          - condition: template
            value_template: '{{ not is_locked and is_expired and (skip_warning or
              is_warned) }}'
          sequence:
          - event: universal_controller_command
            event_data:
              action_type: '{{ ''scene_cycle'' if use_scene else ''light_call'' }}'
              command_input: '{{ '''' if use_scene else ''turn_off'' }}'
              action_value: 'off'
              area_key: '{{ area_key }}'
          - event: lighting_registry_update
            event_data:
              action: remove
              area_key: '{{ area_key }}'
              claimant_id: '{{ claimant }}'
        - conditions:
          - condition: template
            value_template: '{{ not is_locked and is_expired and not is_warned }}'
          sequence:
          - event: universal_controller_command
            event_data:
              action_type: light_call
              command_input: turn_on
              action_value: min
              area_key: '{{ area_key }}'
          - event: lighting_registry_update
            event_data:
              action: warned
              area_key: '{{ area_key }}'
              claimant_id: '{{ claimant }}'
  - if:
    - condition: template
      value_template: '{{ (state_attr(''sensor.lighting_off_registry'', ''active_intents'')
        or {}) | count > 0 }}'
    then:
    - delay: 00:00:05
    - event: cleaner_heartbeat
- id: '1776022650271'
  alias: Bridge - Global Presence Recursive Registry Cleaner v2.2
  description: Standardized Claimant-Based Cleaner (v6.1 Aligned)
  triggers:
  - trigger: event
    event_type: cleaner_heartbeat
  - trigger: state
    entity_id: sensor.lighting_off_registry
    to: active
  actions:
  - variables:
      registry_data: "{% set raw = state_attr('sensor.lighting_off_registry', 'active_intents')
        | default({}, true) %} {% set ns = namespace(clean={}) %} {% for k, v in raw.items()
        if k != '_global_' %}\n  {% set ns.clean = dict(ns.clean, **{k: v}) %}\n{%
        endfor %} {{ ns.clean }}"
  - repeat:
      for_each: '{{ registry_data.items() | list }}'
      sequence:
      - variables:
          area_key: '{{ repeat.item[0] }}'
          winning_intent: '{{ repeat.item[1] | sort(attribute=''priority'', reverse=true)
            | first }}'
          claimant: '{{ winning_intent.claimant }}'
          expiry: '{{ as_timestamp(winning_intent.expiry) if winning_intent.expiry
            is not none else 9999999999 }}

            '
          is_locked: '{{ winning_intent.locked | default(false) }}'
          is_warned: '{{ winning_intent.warned | default(false) }}'
          skip_warning: '{{ winning_intent.skip_warning | default(false) }}'
          is_expired: '{{ as_timestamp(now()) >= expiry }}'
          area_policy: '{{ labels(area_key) | default([], true) }}'
          use_scene: '{{ ''scene_eligible'' in area_policy }}'
      - choose:
        - conditions:
          - condition: template
            value_template: '{{ not is_locked and is_expired and (skip_warning or
              is_warned) }}'
          sequence:
          - event: universal_controller_command
            event_data:
              action_type: '{{ ''scene_cycle'' if use_scene else ''light_call'' }}'
              command_input: '{{ '''' if use_scene else ''turn_off'' }}'
              action_value: 'off'
              area_key: '{{ area_key }}'
          - event: lighting_registry_update
            event_data:
              action: remove
              area_key: '{{ area_key }}'
              claimant: '{{ claimant }}'
              claimant_id: '{{ claimant }}'
        - conditions:
          - condition: template
            value_template: '{{ not is_locked and is_expired and not is_warned }}'
          sequence:
          - event: universal_controller_command
            event_data:
              action_type: light_call
              command_input: turn_on
              action_value: min
              area_key: '{{ area_key }}'
          - event: lighting_registry_update
            event_data:
              action: warned
              area_key: '{{ area_key }}'
              claimant: '{{ claimant }}'
              claimant_id: '{{ claimant }}'
  - if:
    - condition: template
      value_template: '{{ registry_data | count > 0 }}'
    then:
    - delay: 00:00:05
    - event: cleaner_heartbeat
  mode: restart
- id: '1776024043185'
  alias: GPE - Orchestrator (V2.2)
  description: "# GPE - ORCHESTRATOR (V2.2) \n## 1. CORE PURPOSE\nActs as the central
    decision engine for environmental presence. Fully  integrated with the Priority
    Intent Stack (Registry v6.1).\n## 2. ARCHITECTURAL LOGIC\n* **Priority Intent
    Integration**: All presence events are tagged with \n  `intent_type: motion` to
    ensure they interact correctly with the \n  multi-layered priority stack.\n  \n*
    **Standardized Handshake**: Uses `claimant_id` as the primary identifier \n  to
    align with Registry v6.1 and Cleaner v2.1 standards.\n  \n* **The Handover Pattern**:
    When high-precision presence clears, the system \n  automatically hands over to
    a 120s motion-type timer instead of immediate \n  removal, preventing jarring
    light cut-offs.\n\n* **The Gatekeeper Pattern**: Suppresses redundant commands
    if the room \n  is already in the desired state and filters false-positives via
    \n  Ghost/Veto logic.\n\n## 3. VERSION HISTORY\n* **V2.1**: Standardized on `claimant_id`.
    Implemented 120s \"Handover\" logic \n  for cleared presence. Restored missing
    Door Timer and Motion Reset logic.\n* **V2.0**: Implemented Multi-Tenant Ownership
    tracking. Standardized event \n  schema for Registry v5.7 compatibility.\n* **V1.5**:
    Updated attribute paths to `active_intents`. Standardized \n  `intent_type` as
    'motion' for all presence-based additions."
  triggers:
  - trigger: state
    entity_id: sensor.active_sensor_monitor_master
  conditions:
  - condition: template
    value_template: "{{ trigger.to_state.state not in ['none', 'unknown', 'unavailable']
      and\n   trigger.from_state.state != trigger.to_state.state and \n   is_ready
      }}"
  - condition: template
    value_template: '{{ area_key != ''none'' and not is_overridden }}

      '
  actions:
  - variables:
      is_on: '{{ is_state(source_entity, ''on'') }}'
      is_presence: '{{ ''presence'' in entity_labels }}'
      is_door: '{{ ''door'' in entity_labels }}'
      is_entrance: '{{ ''entrance'' in entity_labels }}'
      area_policy: '{{ labels(area_key) }}'
      use_scene: '{{ ''scene_eligible'' in area_policy }}'
      scene_data: '{{ state_attr(g_logic.scene_data, ''data'') | default({}, true)
        }}'
      is_room_off: '{{ scene_data.get(area_key, {}).get(''name'', ''off'') | lower
        == ''off'' }}'
      call_scene: '{{ is_room_off and is_presence and is_on and use_scene }}'
      use_night_settings: '{{ ''night_light'' in area_policy and is_state(g_env.night_posture_sensor,
        ''on'') }}'
      final_target_label: '{% if use_night_settings %} {{ [''night_light''] }} {%
        else %} {{ [''main''] }} {% endif %}'
      adjoining_area: '{{ registry.get(''area_metadata'', {}).get(area_key, {}).get(''neighbors'',
        {}).get(''peer'', ''none'') }}'
      door_entity: '{{ (area_entities(area_key) | intersect(label_entities(''door'')))
        | first | default(''none'') }}'
      has_door: '{{ door_entity != ''none'' }}'
      is_door_closed: '{{ is_state(door_entity, ''off'') if has_door else false }}'
      door_age: '{{ as_timestamp(now()) - as_timestamp(states[door_entity].last_changed,
        0) if has_door else 0 }}'
      is_lock_zone: '{{ ''lock_eligible'' in area_policy }}'
      is_area_locked: '{{ area_stack | selectattr(''locked'', ''eq'', true) | list
        | count > 0 }}'
      hvac_action: '{{ state_attr(g_hvac.primary_unit, ''hvac_action'') | default(''idle'')
        }}'
      hvac_is_active: '{{ hvac_action in [''cooling'', ''heating''] }}'
      is_ghost: '{{ has_door and is_presence and is_on and is_door_closed and not
        is_area_locked and (door_age > 600 or hvac_is_active) }}'
      should_lock_area: '{{ is_lock_zone and is_presence and is_on and is_door_closed
        and not is_area_locked and door_age < 120 }}'
      should_unlock_area: '{{ is_area_locked and (not is_on or (has_door and not is_door_closed))
        }}'
      should_trigger_peer: '{{ is_door and is_on and area_key != ''none'' and adjoining_area
        != ''none'' }}'
  - choose:
    - alias: Veto Log (Ghost Detected)
      conditions:
      - condition: template
        value_template: '{{ is_presence and is_on and is_ghost }}'
      sequence:
      - action: logbook.log
        data:
          name: GPE VETO
          message: 'GPE VETO: Ghost in {{ area_key }} (HVAC: {{ hvac_action }}, Door
            Age: {{ door_age | int }}s, Lock Status: {{ is_area_locked}})'
          entity_id: '{{ source_entity }}'
    - alias: Lock Presence (Sabbatical)
      conditions:
      - condition: template
        value_template: '{{ should_lock_area and not is_area_locked }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: lock
          claimant_id: '{{ source_entity }}'
          area_key: '{{ area_key }}'
          intent_type: motion
      - action: logbook.log
        data:
          name: GPE LOCKED
          message: 'Locked Via {{ ''Motion'' if is_presence else ''Portal'' }} Room
            {{ area_key }} (Registry Reset{% if has_door %}, Door Age: {{ door_age
            | int }}s{% endif %})'
          entity_id: '{{ source_entity }}'
    - alias: Valid Turn On (Anti-Ghosting)
      conditions:
      - condition: template
        value_template: '{{ (is_entrance or is_door or (is_presence and not is_area_locked))
          and is_on and not is_ghost }}'
      sequence:
      - choose:
        - conditions:
          - condition: template
            value_template: '{{ not use_scene }}'
          sequence:
          - event: universal_controller_command
            event_data:
              action_type: light_call
              command_input: turn_on
              area_key: '{{ area_key }}'
              action_value: '{{ ''night_mode'' if use_night_settings else ''day_mode''
                }}'
              target_label: '{{ final_target_label }}'
          - event: lighting_registry_update
            event_data:
              action: add
              claimant_id: '{{ source_entity }}'
              area_key: '{{ area_key }}'
              seconds: -1
              intent_type: motion
        - conditions:
          - condition: template
            value_template: '{{ use_scene }}'
          sequence:
          - if:
            - condition: template
              value_template: '{{ call_scene }}'
            then:
            - event: universal_controller_command
              event_data:
                action_type: scene_cycle
                area_key: '{{ area_key }}'
                action_value: restore
            - event: lighting_registry_update
              event_data:
                action: add
                claimant_id: '{{ source_entity }}'
                area_key: '{{ area_key }}'
                seconds: -1
                intent_type: override
                locked: true
      - action: logbook.log
        data:
          name: GPE
          message: 'Turn On: Via {{''Motion'' if is_presence else ''Portal'' }} Room
            {{ area_key }} (Registry Reset, Door Age: {{ door_age | int }}s)'
          entity_id: '{{ source_entity }}'
    - alias: Presence Cleared (Handover)
      conditions:
      - condition: template
        value_template: '{{ is_presence and not is_on and not is_area_locked }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: add
          claimant_id: '{{ source_entity }}'
          area_key: '{{ area_key }}'
          intent_type: motion
          seconds: 120
      - event: cleaner_heartbeat
    - alias: Door Closed Timer Reset
      conditions:
      - condition: template
        value_template: '{{ is_door and not is_on }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: add
          claimant_id: '{{ source_entity }}'
          area_key: '{{ area_key }}'
          intent_type: motion
          seconds: 30
          skip_warning: '{{ not is_lock_zone }}'
    - alias: Presence Update (Motion Reset)
      conditions:
      - condition: template
        value_template: '{{ is_presence and is_on and (not has_door or not is_door_closed
          ) }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: add
          claimant_id: '{{ source_entity }}'
          area_key: '{{ area_key }}'
          intent_type: motion
          seconds: 120
    - alias: Safety Unlock (Self-Healing)
      conditions:
      - condition: template
        value_template: '{{ should_unlock_area }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: remove
          claimant_id: '{{ source_entity }}'
          area_key: '{{ area_key }}'
          intent_type: motion
  - if:
    - condition: template
      value_template: '{{ should_trigger_peer }}'
    then:
    - event: universal_controller_command
      event_data:
        action_type: light_call
        command_input: turn_on
        area_key: '{{ adjoining_area }}'
        action_value: preheat
  trace:
    stored_traces: 50
  mode: parallel
  variables:
    registry: '{{ state_attr(''sensor.global_variable_registry'', ''vars'') | default({},
      true) }}'
    g_env: '{{ registry.get(''globals'', {}).get(''environmental'', {}) }}'
    g_hvac: '{{ registry.get(''globals'', {}).get(''hvac'', {}) }}'
    g_logic: '{{ registry.get(''globals'', {}).get(''logic_engines'', {}) }}'
    source_entity: '{{ trigger.to_state.state.split(''@'')[0] }}'
    area_key: '{{ area_id(source_entity) | default(''none'') }}'
    area_stack: '{{ (state_attr(g_logic.get(''lighting_off_registry'', {}), ''active_intents'')
      | default({}, true)).get(area_key, []) }}'
    entity_labels: '{{ labels(source_entity) }}'
    is_overridden: '{{ area_stack | selectattr(''type'', ''eq'', ''override'') | list
      | count > 0 }}'
    is_ready: '{{ g_env != {} and area_key != ''none'' }}'
  max: 20
- id: '1776027405436'
  alias: GPE - Orchestrator (V2.5)
  description: "# GPE - ORCHESTRATOR (V2.5) \nDecision engine for environmental presence.\n##
    1. CORE PURPOSE\nActs as the central decision engine for environmental presence.
    Fully  integrated with the Priority Intent Stack (Registry v6.1).\n## 2. ARCHITECTURAL
    LOGIC\n* **Priority Intent Integration**: All presence events are tagged with
    \n  `intent_type: motion` to ensure they interact correctly with the \n  multi-layered
    priority stack.\n  \n* **Standardized Handshake**: Uses `claimant_id` as the primary
    identifier \n  to align with Registry v6.1 and Cleaner v2.1 standards.\n  \n*
    **The Handover Pattern**: When high-precision presence clears, the system \n  automatically
    hands over to a 120s motion-type timer instead of immediate \n  removal, preventing
    jarring light cut-offs.\n\n* **The Gatekeeper Pattern**: Suppresses redundant
    commands if the room \n  is already in the desired state and filters false-positives
    via \n  Ghost/Veto logic.\n\n## 3. VERSION HISTORY\n* **V2.4**: Implemented conditional
    'seconds' (30s for door-only transitions).\n* **V2.3.5**: Fixed Safety Unlock
    to use explicit 'add' for grace period.\n* **V2.3.3**: Hardened Presence Update/Cleared
    aliases to strictly ignore \n  locked areas. Prevents motion-off events from overwriting
    infinite locks.\n\n* **V2.3.2**: Refined Valid Turn On to ignore door events if
    area is locked.\n  Prevents race conditions between Portal Turn On and Safety
    Unlock.\n\n* **V2.3.1**: Relaxed door_age restriction in should_lock_area. \n
    \ Allows locking if motion is sustained while the door is closed, \n  even if
    the door closure was >120s ago.\n\n* **V2.3**: Removed 'Presence Off' from should_unlock_area
    to prevent \n  premature unlocking when motion clears in locked zones.\n  \n*
    **V2.2**: Fix Modified should_unlock_area to transition to a 30s grace period
    instead  of immediate removal to prevent instant blackouts when doors open.\n*
    **V2.1**: Standardized on `claimant_id`. Implemented 120s \"Handover\" logic for
    cleared presence. Restored missing Door Timer and Motion Reset logic. \n* **V2.0**:
    Implemented Multi-Tenant Ownership tracking. Standardized event \n  schema for
    Registry v5.7 compatibility.\n  \n* **V1.5**: Updated attribute paths to `active_intents`.
    Standardized \n  `intent_type` as 'motion' for all presence-based additions."
  triggers:
  - trigger: state
    entity_id: sensor.active_sensor_monitor_master
  conditions:
  - condition: template
    value_template: "{{ trigger.to_state.state not in ['none', 'unknown', 'unavailable']
      and\n   trigger.from_state.state != trigger.to_state.state and \n   is_ready
      }}"
  - condition: template
    value_template: "{% set is_overridden = current_stack | selectattr('type', 'eq',
      'override') | list | count > 0 %}  \n\n{{ area_key != 'none' and not is_overridden
      }}\n"
    enabled: false
  actions:
  - variables:
      local_registry: sensor.{{ area_key }}_presence_intent
      current_stack: "{% set raw_stack = state_attr(local_registry, 'intent_stack')
        | default([], true) %} \n{% set ns = namespace(cleaned=[]) %} \n\n{% for item
        in raw_stack %}\n  {% if 'claimant_id' in item %}\n    {% set ns.cleaned =
        ns.cleaned + [item] %}\n  {% elif 'claimant' in item %}\n    {% set ns_item
        = namespace(new_dict={'claimant_id': item.claimant}) %}\n    {% for key, value
        in item.items() if key != 'claimant' %}\n      {% set ns_item.new_dict = dict(ns_item.new_dict,
        **{key: value}) %}\n    {% endfor %}\n    {% set ns.cleaned = ns.cleaned +
        [ns_item.new_dict] %}\n  {% endif %}\n{% endfor %} \n{{ ns.cleaned }}"
      is_on: '{{ is_state(source_entity, ''on'') }}'
      is_presence: '{{ ''presence'' in entity_labels }}'
      is_door: '{{ ''door'' in entity_labels }}'
      is_entrance: '{{ ''entrance'' in entity_labels }}'
      area_policy: '{{ labels(area_key) }}'
      use_scene: '{{ ''scene_eligible'' in area_policy }}'
      use_night_settings: '{{ ''night_light'' in area_policy and is_state(g_env.night_posture_sensor,
        ''on'') }}'
      final_target_label: '{% if use_night_settings %} {{ [''night_light''] }} {%
        else %} {{ [''main''] }} {% endif %}'
      adjoining_area: '{{ registry.get(''area_metadata'', {}).get(area_key, {}).get(''neighbors'',
        {}).get(''peer'', ''none'') }}'
      door_entity: '{{ (area_entities(area_key) | intersect(label_entities(''door'')))
        | first | default(''none'') }}'
      has_door: '{{ door_entity != ''none'' }}'
      presence_entity: '{{ (area_entities(area_key) | intersect(label_entities(''presence'')))
        | first | default(''none'') }}'
      has_presence: '{{ presence_entity != ''none'' }}'
      is_door_closed: '{{ is_state(door_entity, ''off'') if has_door else false }}'
      door_age: '{{ as_timestamp(now()) - as_timestamp(states[door_entity].last_changed,
        0) if has_door else 0 }}'
      is_lock_zone: '{{ ''lock_eligible'' in area_policy }}'
      locked_intent: '{{ current_stack | selectattr(''locked'', ''eq'', true) | first
        | default(none) }}'
      is_area_locked: '{{ locked_intent is not none }}'
      locked_claimant_id: '{{ locked_intent.claimant_id if is_area_locked else ''none''
        }}'
      hvac_action: '{{ state_attr(g_hvac.primary_unit, ''hvac_action'') | default(''idle'')
        }}'
      hvac_is_active: '{{ hvac_action in [''cooling'', ''heating''] }}'
      is_ghost: '{{ has_door and is_presence and is_on and is_door_closed and not
        is_area_locked and (door_age > 600 or hvac_is_active) }}'
      should_lock_area: "{{ is_lock_zone and is_presence and is_on and is_door_closed
        and not is_area_locked and \n   (door_age < 120 or (current_stack | selectattr('type',
        'eq', 'motion') | list | count > 0)) }}"
      should_unlock_area: "{{ is_area_locked and (\n  (is_door and is_on) or\n  (has_door
        and not is_door_closed and door_age < 5)\n) }}"
      should_trigger_peer: '{{ is_door and is_on and area_key != ''none'' and adjoining_area
        != ''none'' }}'
  - variables:
      scene_data: '{{ state_attr(g_logic.scene_data, ''data'') | default({}, true)
        }}'
      target_select: select.{{ area_key }}_matrix_scene
      raw_scene: '{{ states(target_select) }}'
      is_room_off: '{% set s = raw_scene %} {{ s is defined and (s == ''0'' or s.startswith(''0:''))
        }}

        '
      call_scene: '{{ is_room_off and is_presence and is_on and use_scene }}'
      call_off_scene: '{{ not is_room_off and is_presence and not is_on and use_scene
        }}'
  - choose:
    - alias: Veto Log (Ghost Detected)
      conditions:
      - condition: template
        value_template: '{{ is_presence and is_on and is_ghost }}'
      sequence:
      - action: logbook.log
        data:
          name: GPE VETO
          message: 'GPE VETO: Ghost in {{ area_key }} (HVAC: {{ hvac_action }}, Door
            Age: {{ door_age | int }}s, Lock Status: {{ is_area_locked}})'
          entity_id: '{{ source_entity }}'
    - alias: Lock Presence (Sabbatical)
      conditions:
      - condition: template
        value_template: '{{ should_lock_area and not is_area_locked }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: lock
          claimant_id: '{{ source_entity }}'
          target:
            area_id: '{{ area_key }}'
          intent_type: motion
      - action: logbook.log
        data:
          name: GPE LOCKED
          message: 'LOCKED: {{ area_key }} via {{ source_entity }}. (Door Age: {{
            door_age | int }}s, Presence: {{ is_on }})'
          entity_id: '{{ source_entity }}'
    - alias: Valid Turn On (Anti-Ghosting)
      conditions:
      - condition: template
        value_template: '{# Only allow Portal/Motion Turn On if not locked. If locked,
          Safety Unlock handles the exit. #} {{ (is_entrance or is_door or is_presence)
          and is_on and not is_ghost and not is_area_locked }}'
      sequence:
      - action: logbook.log
        data:
          name: GPE
          message: 'Turn On: Via {{''Motion'' if is_presence else ''Portal'' }} Room
            {{ area_key }} (Registry Reset, Door Age: {{ door_age | int }}s)'
          entity_id: '{{ source_entity }}'
      - if:
        - condition: template
          value_template: '{{ not use_scene }}'
        then:
        - event: universal_controller_command
          event_data:
            action_type: light_call
            command_input: turn_on
            target:
              area_id: '{{ area_key }}'
              label_id: '{{ final_target_label }}'
            action_value: '{{ ''night_mode'' if use_night_settings else ''day_mode''
              }}'
            source_device: '{{ source_entity }}'
        - event: lighting_registry_update
          event_data:
            action: add
            claimant_id: '{{ source_entity }}'
            target:
              area_id: '{{ area_key }}'
              label_id: '{{ final_target_label }}'
            seconds: '{{ 30 if is_door and has_presence else -1 }}'
            intent_type: motion
        else:
        - event: lighting_registry_update
          event_data:
            action: remove
            claimant_id: '{{ source_entity }}'
            target:
              area_id: '{{ area_key }}'
              label_id: '{{ final_target_label }}'
            intent_type: motion
        - condition: template
          value_template: '{{ call_scene }}'
        - event: universal_controller_command
          event_data:
            action_type: scene_cycle
            target:
              area_id: '{{ area_key }}'
            action_value: restore
            source_device: '{{ source_entity }}'
    - alias: Presence Cleared (Handover)
      conditions:
      - condition: template
        value_template: '{{ is_presence and not is_on and not is_area_locked }}'
      sequence:
      - choose:
        - conditions:
          - condition: template
            value_template: '{{ not use_scene }}'
          sequence:
          - event: lighting_registry_update
            event_data:
              action: add
              claimant_id: '{{ source_entity }}'
              target:
                area_id: '{{ area_key }}'
                label_id: '{{ final_target_label }}'
              intent_type: motion
              seconds: 120
          alias: Start Expiry Timer (120s)
        - conditions:
          - condition: template
            value_template: '{{ call_off_scene }}'
          sequence:
          - event: lighting_registry_update
            event_data:
              action: add
              claimant_id: '{{ source_entity }}'
              target:
                area_id: '{{ area_key }}'
                label_id: '{{ final_target_label }}'
              intent_type: motion
              skip_warning: true
              seconds: 300
          alias: Call Off Scene
      - event: cleaner_heartbeat
    - alias: Door Closed Timer Reset
      conditions:
      - condition: template
        value_template: '{{ is_door and not is_on }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: add
          claimant_id: '{{ source_entity }}'
          target:
            area_id: '{{ area_key }}'
            label_id: '{{ final_target_label }}'
          intent_type: motion
          seconds: 30
          skip_warning: '{{ not is_lock_zone }}'
    - alias: Presence Update (Motion Reset)
      conditions:
      - condition: template
        value_template: '{{ is_presence and is_on and not is_area_locked and (not
          has_door or not is_door_closed ) }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: add
          claimant_id: '{{ source_entity }}'
          target:
            area_id: '{{ area_key }}'
            label_id: '{{ final_target_label }}'
          intent_type: motion
          seconds: 120
    - alias: Safety Unlock (Grace Period)
      conditions:
      - condition: template
        value_template: '{{ should_unlock_area }}'
      sequence:
      - action: logbook.log
        data:
          name: GPE UNLOCK
          message: 'UNLOCKING: {{ area_key }} (Handover to 30s Grace). (Reason: Door
            Opened/Ajar)'
          entity_id: '{{ source_entity }}'
      - event: lighting_registry_update
        event_data:
          action: add
          claimant_id: '{{ locked_claimant_id }}'
          target:
            area_id: '{{ area_key }}'
            label_id: '{{ final_target_label }}'
          intent_type: motion
          seconds: 30
          locked: false
  - if:
    - condition: template
      value_template: '{{ should_trigger_peer }}'
    then:
    - event: universal_controller_command
      event_data:
        action_type: light_call
        command_input: turn_on
        target:
          area_id: '{{ adjoining_area }}'
          label_id: '{{ final_target_label }}'
        action_value: preheat
  - variables:
      last_sync: '{{ this.attributes.last_triggered | as_timestamp | default(none)
        }}'
      cooldown_met: '{{ last_sync is none or (now() | as_timestamp  - last_sync) >
        20 }}'
      active_registries: "{{ label_entities('lights_off') | unique \n   | expand \n
        \  | selectattr('state', 'in', ['active']) \n   | map(attribute='entity_id')
        \n   | reject('eq', local_registry)\n   | list }}"
  - if:
    - condition: template
      value_template: '{{ active_registries | count > 0 and cooldown_met }}'
    then:
    - repeat:
        for_each: '{{ active_registries }}'
        sequence:
        - variables:
            target_area: '{{ area_id(repeat.item) }}'
        - action: mqtt.publish
          data:
            topic: homeassistant/sensor/{{ target_area }}/presence/state
            payload: reset
          enabled: true
  mode: parallel
  variables:
    registry: '{{ state_attr(''sensor.global_variable_registry'', ''vars'') | default({},
      true) }}'
    g_env: '{{ registry.get(''globals'', {}).get(''environmental'', {}) }}'
    g_hvac: '{{ registry.get(''globals'', {}).get(''hvac'', {}) }}'
    g_logic: '{{ registry.get(''globals'', {}).get(''logic_engines'', {}) }}'
    source_entity: '{{ trigger.to_state.state.split(''@'')[0] }}'
    area_key: '{{ area_id(source_entity) | default(''none'') }}'
    entity_labels: '{{ labels(source_entity) }}'
    is_ready: '{{ g_env != {} and area_key != ''none'' }}'
  max: 50
  trace:
    stored_traces: 50
- id: '1776030955159'
  alias: Bridge - Global Presence Recursive Registry Cleaner v2.3
  description: Standardized Claimant-Based Cleaner (v6.1 Aligned)
  triggers:
  - trigger: event
    event_type: cleaner_heartbeat
  - trigger: state
    entity_id: sensor.lighting_off_registry
    to: active
  actions:
  - variables:
      registry_data: "{% set raw = state_attr('sensor.lighting_off_registry', 'active_intents')
        | default({}, true) %} {% set ns = namespace(clean={}) %} {% for k, v in raw.items()
        if k != '_global_' %}\n  {% set ns.clean = dict(ns.clean, **{k: v}) %}\n{%
        endfor %} {{ ns.clean }}\n   "
  - repeat:
      for_each: '{{ registry_data.items() | list }}'
      sequence:
      - variables:
          area_key: '{{ repeat.item[0] }}'
          winning_intent: '{{ repeat.item[1] | sort(attribute=''priority'', reverse=true)
            | sort(attribute=''locked'', reverse=true) | first }}

            '
          claimant_id: '{{ winning_intent.claimant }}'
          expiry: '{{ as_timestamp(winning_intent.expiry) if winning_intent.expiry
            is not none else 9999999999 }}

            '
          is_locked: '{{ winning_intent.locked | default(false) }}'
          is_warned: '{{ winning_intent.warned | default(false) }}'
          skip_warning: '{{ winning_intent.skip_warning | default(false) }}'
          is_expired: '{{ as_timestamp(now()) >= expiry }}'
          area_policy: '{{ labels(area_key) | default([], true) }}'
          use_scene: '{{ ''scene_eligible'' in area_policy }}'
      - choose:
        - conditions:
          - condition: template
            value_template: '{{ not is_locked and is_expired and (skip_warning or
              is_warned) }}'
          sequence:
          - event: universal_controller_command
            event_data:
              action_type: '{{ ''scene_cycle'' if use_scene else ''light_call'' }}'
              command_input: '{{ '''' if use_scene else ''turn_off'' }}'
              action_value: 'off'
              area_key: '{{ area_key }}'
          - event: lighting_registry_update
            event_data:
              action: remove
              area_key: '{{ area_key }}'
              claimant: '{{ claimant_id }}'
              claimant_id: '{{ claimant_id }}'
        - conditions:
          - condition: template
            value_template: '{{ not is_locked and is_expired and not is_warned }}'
          sequence:
          - event: universal_controller_command
            event_data:
              action_type: light_call
              command_input: turn_on
              action_value: min
              area_key: '{{ area_key }}'
          - event: lighting_registry_update
            event_data:
              action: warned
              area_key: '{{ area_key }}'
              claimant: '{{ claimant_id }}'
              claimant_id: '{{ claimant_id }}'
  - if:
    - condition: template
      value_template: '{{ registry_data | count > 0 }}'
    then:
    - delay: 00:00:05
    - event: cleaner_heartbeat
  trace:
    stored_traces: 50
  mode: restart
- id: '1776088499928'
  alias: Light Call - Turn On (v2)
  description: ''
  triggers:
  - trigger: event
    id: UCC_Event
    event_type: universal_controller_command
    event_data:
      action_type: light_call
      command_input: turn_on
    enabled: true
  - trigger: event
    id: eUCC_Event
    event_type: esphome.universal_controller_command
    event_data:
      action_type: light_call
      command_input: turn_on
    enabled: true
  - trigger: mqtt
    id: MQTT_Message
    options:
      topic: home/universal/bus
      payload: light_call
      value_template: '{{ value_json.action_type }}'
  conditions: []
  actions:
  - alias: Intent and Context
    variables:
      registry: '{{ state_attr(''sensor.global_variable_registry'', ''vars'') }}'
      g_logic: '{{ registry.globals.logic_engines }}'
      target_kelvin: '{{ states(g_logic.cct_calculation) | int(3200) }}'
      target_br_dimmer: '{{ states(g_logic.brightness_calculation) | int(255) }}'
      log_dest: '{{ g_logic.system_log }}'
      payload: '{{ trigger.payload if trigger.id == ''MQTT_Message'' else trigger.event.data
        }}'
      action_val: '{{ payload.action_value | default('''') }}'
      area_key: '{{ payload.area_key }}'
      val: '{{ payload.target_label | default([], true) }}'
      target_labels: "{{ ( [val] if val is string else val) \n  | map('label_entities')
        \n  | sum(start=[]) \n  | unique \n  | list \n}}\n"
  - alias: Data Constants
    variables:
      dim_factor: 20
      command_map:
        max:
          brightness: 255
        raise:
          brightness_step: 35
        lower:
          brightness_step: -35
        min:
          brightness: 25
        night_mode:
          brightness: 25
        day_mode:
          brightness: 190
        release:
          brightness_step: 0
      payload: {}
  - alias: Hardware Bucketing and Target Expansion (The "Engine")
    variables:
      area_lights: '{{ area_entities(area_key) | select(''match'', ''light.*'') |
        list }}'
      target_entities: "{% if target_labels | length > 0 %}\n    {{ area_lights |
        intersect(target_labels) }}\n  {% else %}\n    {{ area_lights }}\n  {% endif
        %}\n"
      target_br: "{% set current_cmd = command_map.get(action_val, {}) %} {% if 'brightness_step'
        in current_cmd %}\n  {{ 255 if current_cmd.brightness_step > 0 else 1 }}\n{%
        elif action_val is number or (action_val | is_number) %}\n  {{ ([0, action_val
        | int, 255] | sort)[1] }}\n{% else %}\n  {{ current_cmd.get('brightness',
        190) }}\n{% endif %}\n"
      step_val: '{{ command_map.get(action_val, {}).get(''brightness_step'', 0) }}'
      ikea_cct_lights: "{% set ns = namespace(to_update=[]) %} \n{% for l in states.light
        \n  | selectattr('entity_id', 'in', target_entities) \n    if l.attributes.get('max_color_temp_kelvin',
        0) | int <= 4000 \n   and 'color_temp' in l.attributes.get('supported_color_modes',
        []) %}\n      {% set cur_k = l.attributes.get('color_temp_kelvin', 0) | int(0)
        %}\n      {% set cur_br = l.attributes.get('brightness', 0) | int(0) %}\n
        \     {% set clamped_k = ([l.attributes.get('min_color_temp_kelvin', 2202)
        | int, target_kelvin, 4000] | sort)[1] %}\n      {% if (cur_k - clamped_k)
        | abs > 50 or (cur_br - target_br) | abs > 3 %}\n        {% set ns.to_update
        = ns.to_update + [l.entity_id] %}\n      {% endif %}\n{% endfor %} {{ ns.to_update
        }}\n"
      standard_cct_lights: "{% set ns = namespace(to_update=[]) %} {% for l in states.light
        | selectattr('entity_id', 'in', target_entities) \n   if l.entity_id not in
        ikea_cct_lights\n   and 'color_temp' in l.attributes.get('supported_color_modes',
        []) %}\n  {% set cur_k = l.attributes.get('color_temp_kelvin', 0) | int(0)
        %}\n  {% set cur_br = l.attributes.get('brightness', 0) | int(0) %}\n  {%
        set min_hw = l.attributes.get('min_color_temp_kelvin', 2200) | int %}\n  {%
        set max_hw = l.attributes.get('max_color_temp_kelvin', 7000) | int %}\n  {%
        set clamped_k = ([min_hw, target_kelvin, max_hw] | sort)[1] %}\n  {% if (cur_k
        - clamped_k) | abs > 50 or (cur_br - target_br) | abs > 3 %}\n    {% set ns.to_update
        = ns.to_update + [l.entity_id] %}\n  {% endif %}\n{% endfor %} {{ ns.to_update
        }}\n"
      dimmer_lights: "{{ target_entities \n  | intersect(label_entities('CurrentCTDimmer'))
        \n  | list }}\n"
      binary_lights: "{% set all_binary_lights = states.light \n    | selectattr('attributes.supported_color_modes',
        'defined')\n    | selectattr('attributes.supported_color_modes', 'eq', ['onoff'])\n
        \   | map(attribute='entity_id') | list %}\n{{ target_entities | intersect(all_binary_lights)
        }}\n"
      excluded: '{{ ikea_cct_lights + standard_cct_lights + dimmer_lights + binary_lights
        | list | default([]) }}'
      standard_lights: "{{ target_entities \n  | reject('in', excluded ) \n  | list
        }}\n"
  - parallel:
    - alias: IKEA CCT Turn On
      if:
      - condition: template
        value_template: '{{ ikea_cct_lights | length > 0 }}'
      then:
      - action: light.turn_on
        target:
          entity_id: '{{ ikea_cct_lights }}'
        data: '{% set base_data = {''color_temp_kelvin'': target_kelvin} %}

          {{ dict(base_data, brightness_step=step_val) if step_val != 0 else dict(base_data,
          brightness=target_br) }}

          '
    - alias: Standard CCT Turn On
      if:
      - condition: template
        value_template: '{{ standard_cct_lights | length > 0 }}'
      then:
      - action: light.turn_on
        target:
          entity_id: '{{ standard_cct_lights }}'
        data: '{% set base_data = {''color_temp_kelvin'': target_kelvin} %} {{ dict(base_data,
          brightness_step=step_val) if step_val != 0 else dict(base_data, brightness=target_br)
          }}

          '
    - alias: Dimmer Lights Turn On
      if:
      - condition: template
        value_template: '{{ dimmer_lights | length > 0 }}'
      then:
      - action: light.turn_on
        target:
          entity_id: '{{ dimmer_lights }}'
        data:
          brightness: '{{ target_br_dimmer | int(150) }}'
    - alias: Binary Lights Turn On
      if:
      - condition: template
        value_template: '{{ binary_lights | length > 0 }}'
      then:
      - action: light.turn_on
        target:
          entity_id: '{{ binary_lights }}'
        data: {}
    - alias: Standard Lights Turn On
      if:
      - condition: template
        value_template: '{{ standard_lights | length > 0 }}'
      then:
      - action: light.turn_on
        target:
          entity_id: '{{ standard_lights }}'
        data: '{% set base_data = {} %}

          {{ dict(base_data, brightness_step=step_val) if step_val != 0 else dict(base_data,
          brightness=target_br) }}

          '
  - action: logbook.log
    data:
      name: Light Engine (On)
      message: 'Light Call Source: {{ payload.source_device | default('''') }} | Area:
        {{ area_key }} | Label: {{ val[0] | default(''All'') }} | color_temp_kelvin:
        {{ target_kelvin }} {{this.entity_id}}'
      entity_id: '{{ log_dest }}'
  mode: queued
  max: 20
- id: '1776171591154'
  alias: Discovery Generator v5.5
  description: Universal Matrix Node Discovery Generator (History Aware)
  triggers: []
  conditions: []
  actions:
  - variables:
      discoveryPrefix: homeassistant
      postureTopic: home/matrix/system/posture
      postureDevice:
        identifiers:
        - house_posture_master
        name: House Posture Engine
        model: Master State Machine
        manufacturer: Pico Cartographer
        sw_version: 3.1.0
  - action: mqtt.publish
    data:
      topic: '{{ discoveryPrefix }}/alarm_control_panel/house_posture/config'
      retain: true
      payload: "{{ {\n    \"name\": \"House Posture\",\n    \"unique_id\": \"house_posture_master\",\n
        \   \"device\": postureDevice,\n    \"state_topic\": postureTopic ~ \"/state\",\n
        \   \"command_topic\": postureTopic ~ \"/set\",\n    \"code_arm_required\":
        false,\n    \"code_disarm_required\": false,\n    \"payload_disarm\": {\n
        \     \"action\": \"default\",\n      \"reprocess\": \"reprocess_all\",\n
        \     \"source\": \"ha_discovery_engine\"\n    } | tojson,\n    \"payload_arm_night\":
        {\n      \"action\": \"night\",\n      \"reprocess\": \"reprocess_all\",\n
        \     \"source\": \"ha_discovery_engine\"\n    } | tojson,\n    \"payload_arm_away\":
        {\n      \"action\": \"away\",\n      \"reprocess\": \"reprocess_all\",\n
        \     \"source\": \"ha_discovery_engine\"\n    } | tojson,\n    \"retain\":
        true\n  } | tojson }}\n"
    enabled: true
  - action: mqtt.publish
    data:
      topic: '{{ discoveryPrefix }}/sensor/house_posture_source/config'
      retain: true
      payload: "{{ {\n  \"name\": \"Posture Source\",\n  \"unique_id\": \"house_posture_source\",\n
        \ \"device\": postureDevice,\n  \"state_topic\": postureTopic ~ \"/source\",\n
        \ \"icon\": \"mdi:information-outline\"\n} | tojson }}\n"
    enabled: true
  - repeat:
      for_each: '{{ areas() }}'
      sequence:
      - variables:
          target_area: '{{ repeat.item }}'
          displayName: '{{ area_name(target_area) | default(target_area | replace(''_'',
            '' '') | title) }}'
          discoveryPrefix: homeassistant
          deviceObj:
            identifiers:
            - matrix_area_{{ target_area }}
            name: '{{ displayName }} Matrix'
            model: Universal Matrix Node
            manufacturer: Pico Cartographer
            suggested_area: '{{ displayName }}'
      - variables:
          appId: scene_config
          topic: '{{ discoveryPrefix }}/sensor/{{ target_area }}/{{ appId }}/config'
          payload:
            name: Scene Config
            unique_id: matrix_{{ target_area }}_{{ appId }}
            default_entity_id: sensor.{{ target_area }}_matrix_{{ appId }}
            state_topic: '{{ discoveryPrefix }}/sensor/{{ target_area }}/{{ appId
              }}/attributes'
            value_template: '{% raw %}{{ value_json.last_processed | default(now().isoformat())
              }}{% endraw %}'
            json_attributes_topic: '{{ discoveryPrefix }}/sensor/{{ target_area }}/{{
              appId }}/attributes'
            json_attributes_template: '{% raw %}{{ value_json | tojson }}{% endraw
              %}'
            device: '{{ deviceObj }}'
            icon: mdi:cog
        alias: Config Definition
      - action: mqtt.publish
        data:
          topic: '{{ topic }}'
          payload: '{{ payload | tojson }}'
          retain: true
      - variables:
          appId: previous_scene
          topic: '{{ discoveryPrefix }}/sensor/{{ target_area }}/{{ appId }}/config'
          payload:
            name: Previous Scene
            unique_id: matrix_{{ target_area }}_{{ appId }}
            default_entity_id: sensor.{{ target_area }}_matrix_{{ appId }}
            state_topic: '{{ discoveryPrefix }}/select/{{ target_area }}/scene/attributes'
            value_template: '{% raw %} {% set hist = value_json.history_stack | default([],
              true) %} {{ hist[-2] if hist | count > 1 else ''0: Off'' }} {% endraw
              %}

              '
            json_attributes_topic: '{{ discoveryPrefix }}/sensor/{{ target_area }}/{{
              appId }}/state'
            json_attributes_template: '{% raw %}{{ value_json | tojson }}{% endraw
              %}'
            device: '{{ deviceObj }}'
            icon: mdi:history
        alias: Previous Scene Definition
      - action: mqtt.publish
        data:
          topic: '{{ topic }}'
          payload: '{{ payload | tojson }}'
          retain: true
      - variables:
          appId: posture
          topic: '{{ discoveryPrefix }}/sensor/{{ target_area }}/{{ appId }}/config'
          payload:
            name: Posture
            unique_id: matrix_{{ target_area }}_{{ appId }}
            default_entity_id: sensor.{{ target_area }}_matrix_{{ appId }}
            state_topic: '{{ discoveryPrefix }}/sensor/{{ target_area }}/scene_config/attributes'
            value_template: '{% raw %}{{ value_json.active_posture | default(''default'')
              }}{% endraw %}'
            device: '{{ deviceObj }}'
            icon: mdi:alarm-panel
        alias: Posture Definition
      - action: mqtt.publish
        data:
          topic: '{{ topic }}'
          payload: '{{ payload | tojson }}'
          retain: true
      - variables:
          appId: scene
          scene_options: "{% set opt = state_attr('sensor.' ~ target_area ~\n'_matrix_scene_config',
            'options') %} \n{{ opt if opt is list and opt | count > 0 else ['0: off']
            }}"
          zb_options: "{% set ns = namespace(found=[]) %}\n{%- set prefix = 'scene.'
            ~ target_area ~ '_' %}\n\n{%- for s in states.scene \n   | selectattr('entity_id',
            'search', '^' ~ prefix ~ '[0-9]*0_') -%}\n  \n  {%- set suffix = s.entity_id
            | replace(prefix, '', 1) -%}\n  {%- set parts = suffix.split('_') -%}\n
            \ \n  {%- set scene_id = parts[0] -%}\n  {%- set scene_name = parts[1:]
            | join(' ') | title -%}\n  \n  {%- set ns.found = ns.found + [ scene_id
            ~ ': ' ~ scene_name ] -%}\n{%- endfor -%}\n{{ ns.found  | unique | sort
            }}"
          is_zigbee_scene: '{{ zb_options is list and zb_options | count > 0 }}

            '
          options: '{{ zb_options if is_zigbee_scene else scene_options }}

            '
          topic: '{{ discoveryPrefix }}/select/{{ target_area }}/{{ appId }}/config'
          payload:
            name: Scene
            unique_id: matrix_{{ target_area }}_{{ appId }}_select
            default_entity_id: select.{{ target_area }}_matrix_{{ appId }}
            state_topic: '{{ discoveryPrefix }}/select/{{ target_area }}/{{ appId
              }}/state'
            value_template: "{% raw %}\n  {{ value_json.sequence_weight ~ ': ' ~ value_json.name
              }}\n{% endraw %}\n"
            command_topic: home/universal/bus
            command_template: "{% raw %}{{ {\n  \"action_type\": \"scene_cycle\",\n
              \ \"area_key\": \"{% endraw %}{{ target_area }}{% raw %}\",\n  \"action_value\":
              \ value ,\n  \"source_device\": \"ha_ui_selector\"\n} | tojson }}{%
              endraw %}\n"
            options: '{{ options }}'
            device: '{{ deviceObj }}'
            json_attributes_topic: '{{ discoveryPrefix }}/select/{{ target_area }}/{{
              appId }}/attributes'
            json_attributes_template: '{% raw %}{{ value_json | tojson }}{% endraw
              %}'
            availability_topic: '{{ discoveryPrefix }}/select/{{ target_area }}/{{
              appId }}/status'
            payload_available: online
            payload_not_available: offline
            availability_mode: all
            icon: mdi:palette-swatch
        alias: Current Scene Definition
      - action: mqtt.publish
        data:
          topic: '{{ topic }}'
          payload: '{{ payload | tojson }}'
          retain: true
      - variables:
          appId: schedule
          topic: '{{ discoveryPrefix }}/select/{{ target_area }}/{{ appId }}/config'
          payload:
            name: Schedule
            unique_id: matrix_{{ target_area }}_{{ appId }}_select
            default_entity_id: select.{{ target_area }}_matrix_{{ appId }}
            state_topic: '{{ discoveryPrefix }}/select/{{ target_area }}/{{ appId
              }}/state'
            value_template: "{% raw %}\n  {# 1. Reach out to the Global Registry #}\n
              \ {% set registry = state_attr('sensor.global_variable_registry', 'vars')
              | default({}, true) %}\n  {% set g_env = registry.get('globals', {}).get('environmental',
              {}) %}\n\n\n  {% set target_area = area_id(this.entity_id) %}\n  {%
              set posture = states(g_env.get('schedule_posture', 'daylight')) %}\n
              \ {% set area_policy = labels(target_area) | default([], true) %}\n
              \ {% set options = this.attributes.get('options', ['on','off','presence']
              ) %}\n\n  {% if value in options %}\n    {{ value }}\n  {% elif posture
              in ['morning', 'evening'] and 'auto_lights' in area_policy %}\n    on\n
              \ {% elif (posture == 'night' and 'night_light' in area_policy) or (posture
              != 'night' and 'day_light' in area_policy ) %}\n    presence\n  {% else
              %}\n    off\n  {% endif %}\n{% endraw %}\n"
            command_topic: home/matrix/{{ target_area }}/{{ appId }}/state
            command_template: '{% raw %}{{ value }}{% endraw %}

              '
            options:
            - 'off'
            - 'on'
            - presence
            device: '{{ deviceObj }}'
            availability_topic: '{{ discoveryPrefix }}/select/{{ target_area }}/{{
              appId }}/status'
            payload_available: online
            payload_not_available: offline
            availability_mode: all
            icon: mdi:sun-clock
        alias: Current Schedule Definition
      - action: mqtt.publish
        data:
          topic: '{{ topic }}'
          payload: '{{ payload | tojson }}'
          retain: true
      - action: mqtt.publish
        data:
          topic: '{{ discoveryPrefix }}/select/{{ target_area }}/{{ appId }}/state'
          payload: presence
          retain: true
      - action: mqtt.publish
        data:
          topic: '{{ discoveryPrefix }}/select/{{ target_area }}/{{ appId }}/status'
          payload: online
          retain: true
      - variables:
          history_sensor: select.{{ target_area }}_matrix_scene
          options: "{{ state_attr('sensor.' ~ target_area ~ '_matrix_scene_config',
            'options') |\n  default(['0: off']) }}\n"
          friendly_name: '{{ state_attr(history_sensor,''friendly_name'') }}

            '
          icon: '{{ state_attr(history_sensor,''icon'') }}

            '
          history_stack: '{{ state_attr(history_sensor,''history_stack'') | default([],
            true) }}

            '
          attributes:
            options: '{{ options }}'
            friendly_name: '{{ friendly_name }}'
            icon: '{{ icon }}'
            history_stack: "{{ history_stack }}   \n"
      - action: mqtt.publish
        data:
          topic: homeassistant/select/{{target_area}}/scene/attributes
          retain: true
          payload: '{{ attributes | to_json }}'
      - variables:
          appId: presence
          topic: '{{ discoveryPrefix }}/sensor/{{ target_area }}/{{ appId }}/config'
          payload:
            name: Presence Registry
            unique_id: '{{ target_area }}_presence_registry_unique'
            default_entity_id: sensor.{{ target_area }}_presence_intent
            state_topic: '{{ discoveryPrefix }}/sensor/{{ target_area }}/{{ appId
              }}/state'
            value_template: "{% raw %}\n  {# 1. Direct attribute access is faster
              and cleaner #}\n  {% set expiry = this.attributes.get('expiry') %}\n
              \ {% set stack_count = this.attributes.get('intent_stack', []) | count
              %}\n\n\n  {% set winner = this.attributes.get('intent_stack', []) |
              sort(attribute='priority', reverse=true) |\n  sort(attribute='locked',
              reverse=true) | first | default({}) %}\n\n\n  {% if stack_count == 0
              %}\n    idle\n  {% elif winner.get('locked', false) %}\n    locked\n
              \ {% elif expiry is none %}\n    {# Locked or infinite intents are always
              active #}\n    active\n  {% else %}\n    {% set t_diff = as_timestamp(expiry)
              - as_timestamp(now()) %}\n    \n    {% if t_diff <= 0 %}\n      expired\n
              \   {% elif t_diff <= 120 %}\n      {# The 'Warning Track' state #}\n
              \     expiring\n    {% else %}\n      active\n    {% endif %}\n  {%
              endif %}\n{% endraw %}"
            json_attributes_topic: '{{ discoveryPrefix }}/sensor/{{ target_area }}/{{
              appId }}/attributes'
            json_attributes_template: '{% raw %}{{ value_json | tojson }}{% endraw
              %}'
            icon: mdi:database-sync
            device: '{{ deviceObj }}'
        alias: Presence Definition
      - action: mqtt.publish
        data:
          topic: '{{ topic }}'
          payload: '{{ payload | tojson }}'
          retain: true
      - variables:
          appId: discovery
          topic: '{{ discoveryPrefix }}/sensor/{{ target_area }}/{{ appId }}/config'
          payload:
            name: Discovery
            unique_id: matrix_{{ target_area }}_{{ appId }}
            default_entity_id: sensor.{{ target_area }}_matrix_{{ appId }}
            state_topic: '{{ discoveryPrefix }}/sensor/{{ target_area }}/{{ appId
              }}/status'
            value_template: '{% raw %}{{ value }}{% endraw %}'
            device: '{{ deviceObj }}'
            icon: mdi:alarm-panel
        alias: Discovery Definition
      - action: mqtt.publish
        data:
          topic: '{{ topic }}'
          payload: '{{ payload | tojson }}'
          retain: true
      - action: mqtt.publish
        data:
          topic: homeassistant/select/{{ target_area }}/scene/status
          payload: online
          retain: true
      - action: mqtt.publish
        data:
          topic: '{{ discoveryPrefix }}/sensor/{{ target_area }}/{{ appId }}/status'
          payload: online
          retain: true
    enabled: true
- id: '1776206675600'
  alias: GPE - Intent Distributor (V1.0)
  description: 'Transitional Logic: Converts Registry Events into Area-Specific MQTT
    Registry Updates'
  triggers:
  - trigger: event
    event_type: lighting_registry_update
  - trigger: event
    event_type: esphome.lighting_registry_update
  - trigger: event
    event_type: universal_controller_command
    event_data:
      action_type: lighting_registry_update
  - trigger: event
    event_type: universal_controller_command
    event_data:
      action_type: light_override
  - trigger: mqtt
    id: MQTT_Bus
    topic: home/universal/bus
  actions:
  - variables:
      p: '{{ (trigger.payload | from_json) if trigger.platform == ''mqtt'' else trigger.event.data
        }}'
      action_type: '{{ p.action_type | default(''lighting_registry_update'') }}'
      is_valid_mqtt: '{{ trigger.platform != ''mqtt'' or action_type in [''lighting_registry_update'',
        ''light_override''] }}'
  - condition: template
    value_template: '{{ is_valid_mqtt and p.area_key is not none }}'
  - variables:
      area_key: '{{ p.area_key }}'
      action: '{{ p.action | default(''add'') }}'
      cid: '{{ (p.claimant_id | default(''system'')) | string }}'
      registry: '{{ state_attr(''sensor.global_variable_registry'', ''vars'') | default({},
        true) }}'
      g_env: '{{ registry.get(''environmental'', {}) }}'
      local_registry: sensor.{{ area_key }}_presence_intent
      current_stack: '{{ state_attr(local_registry, ''intent_stack'') | default([],
        true) }}'
  - choose:
    - conditions:
      - condition: template
        value_template: '{{ action in [''add'', ''lock'', ''override''] or action_type
          == ''light_override'' }}'
      sequence:
      - variables:
          is_off_cmd: '{{ action_type == ''light_override'' and p.action_value ==
            ''off'' }}'
          new_stack: "{% if is_off_cmd %}\n  {{ current_stack | rejectattr('type',
            'eq', 'override') | rejectattr('claimant', 'eq', cid) | list }}\n{% else
            %}\n  {% set is_override = (action_type == 'light_override' or action
            == 'override' or p.intent_type == 'override') %}\n  {% set intent_type
            = 'override' if is_override else (p.intent_type | default('motion')) %}\n
            \ {% set priority = 2 if is_override else (p.priority | default(1) | int)
            %}\n  \n  {% set existing = current_stack | selectattr('claimant', 'eq',
            cid) | first | default({}) %}\n  {% set final_lock = (action == 'lock'
            or p.locked in ['true', true, 'on'] or existing.get('locked', false))
            %}\n  \n  {# EXPIRY CALCULATIONS #}\n  {% set expiry = none %}\n  {% set
            seconds = p.seconds | default(-2) | int %}\n  \n  {% if not final_lock
            %}\n    {% if seconds == -1 %}\n      {% set expiry = none %}\n    {%
            elif is_override %}\n      {# If seconds is -2, it means it wasn't provided;
            for overrides, we default to infinite (none) #}\n      {% if seconds !=
            -2 %}\n        {% set dur_work = g_env.get('override_duration_work', 36000)
            | int %}\n        {% set dur_std = g_env.get('override_duration_standard',
            3600) | int %}\n        {% set is_work_area = ('work' in (labels(area_key)
            | default([], true))) %}\n        {% set expiry = (now() + timedelta(seconds=(p.seconds
            | default(dur_work if is_work_area else dur_std) | int))).isoformat()
            %}\n      {% else %}\n        {% set expiry = none %}\n      {% endif
            %}\n    {% else %}\n      {% set final_seconds = seconds if seconds >=
            0 else 120 %}\n      {% set expiry = (now() + timedelta(seconds=final_seconds)).isoformat()
            %}\n    {% endif %}\n  {% endif %}\n\n  {% set entry = {\n    'type':
            intent_type,\n    'claimant': cid,\n    'priority': priority,\n    'expiry':
            expiry,\n    'locked': final_lock,\n    'action_value': p.action_value
            | default('manual' if is_override else ''),\n    'warned': false,\n    'skip_warning':
            (p.skip_warning in ['true', true] or intent_type != 'motion' or final_lock),\n
            \   'last_updated': now().isoformat()\n  } %}\n  {% set others = current_stack
            | rejectattr('claimant', 'eq', cid) | list %}\n  {{ others + [entry] }}\n{%
            endif %}"
      - action: mqtt.publish
        data:
          topic: homeassistant/sensor/{{ area_key }}/presence/attributes
          payload: '{{ {''intent_stack'': new_stack, ''last_updated'': now().isoformat(),
            ''last_claimant'': cid} | tojson }}'
          retain: true
      - action: mqtt.publish
        data:
          topic: homeassistant/sensor/{{ area_key }}/presence/state
          payload: '{{ ''active'' if new_stack | count > 0 else ''idle'' }}'
          retain: true
    - conditions:
      - condition: template
        value_template: '{{ action == ''remove'' }}'
      sequence:
      - action: mqtt.publish
        data:
          topic: homeassistant/sensor/{{ area_key }}/presence/attributes
          payload: '{% set new_stack = current_stack | rejectattr(''claimant'', ''eq'',
            cid) | list %} {{ {''intent_stack'': new_stack, ''last_updated'': now().isoformat(),
            ''last_claimant'': cid} | tojson }}'
          retain: true
      - action: mqtt.publish
        data:
          topic: homeassistant/sensor/{{ area_key }}/presence/state
          payload: '{{ ''active'' if new_stack | count > 0 else ''idle'' }}'
          retain: true
    - conditions:
      - condition: template
        value_template: '{{ action == ''warned'' }}'
      sequence:
      - action: mqtt.publish
        data:
          topic: homeassistant/sensor/{{ area_key }}/presence/attributes
          payload: "{% set ns = namespace(stk=[]) %} {% for i in current_stack %}\n
            \ {% set ns.stk = ns.stk + [dict(i, warned=true, expiry=(now() + timedelta(seconds=20)).isoformat())
            if i.claimant == cid else i] %}\n{% endfor %} {{ {'intent_stack': ns.stk,
            'last_updated': now().isoformat(), 'last_claimant': cid} | tojson }}"
          retain: true
  mode: parallel
  max: 20
  trace:
    stored_traces: 50
- id: '1776222420567'
  alias: Bridge - Global Presence Reactive Cleaner v3.0
  description: '# GPE - REACTIVE CLEANER (V3.1)


    Reactive State Machine triggered by ''expired'' states. Includes a ''manual_pulse''
    event for forced house-wide sweeps or targeted debugging. Standardized: Uses native
    area_id metadata.'
  triggers:
  - trigger: state
    entity_id: sensor.expired_presence_intent_master
    id: reactive_trigger
  - trigger: event
    event_type: cleaner_heartbeat
    id: manual_pulse
  actions:
  - variables:
      trigger_entity: "{% if trigger.id == 'reactive_trigger' and trigger.to_state.state
        != 'none' %}\n  {{ trigger.to_state.state.split('@')[0] }}\n{% else %}\n  {{
        none }}\n{% endif %}\n"
      area_key: "{% if trigger.id == 'reactive_trigger' and trigger_entity is not
        none %}\n  {{ area_id(trigger_entity) }}\n{% elif trigger.id == 'manual_pulse'
        %}\n  {{ trigger.event.data.area_key | default('') }}\n{% else %}\n  {{ ''
        }}\n{% endif %}\n"
  - if:
    - condition: template
      value_template: '{{ trigger.id == ''manual_pulse'' and area_key == '''' }}'
    then:
    - repeat:
        for_each: "{{ states.sensor \n   | selectattr('entity_id', 'search', '_presence_intent')\n
          \  | selectattr('state', 'eq', 'expired')\n   | map(attribute='entity_id')
          | list }}\n"
        sequence:
        - event: cleaner_heartbeat
          event_data:
            area_key: '{{ area_id(repeat.item) }}'
  - if:
    - condition: template
      value_template: '{{ area_key != '''' }}'
    then:
    - variables:
        intent_sensor: sensor.{{ area_key }}_presence_intent
        stack: '{{ state_attr(intent_sensor, ''intent_stack'') | default([], true)
          }}'
        winning_intent: "{{ stack | sort(attribute='priority', reverse=true) | \n
          \  sort(attribute='locked', reverse=true) | first | default(none) }}\n"
    - condition: template
      value_template: '{{ winning_intent is not none }}'
    - variables:
        claimant_id: '{{ winning_intent.claimant_id | default(''None'') }}'
        is_warned: '{{ winning_intent.warned | default(false) }}'
        skip_warning: '{{ winning_intent.skip_warning | default(false) }}'
        area_policy: '{{ labels(area_key) | default([], true) }}'
        use_scene: '{{ ''scene_eligible'' in area_policy }}'
    - choose:
      - conditions:
        - condition: template
          value_template: '{{ skip_warning or is_warned }}'
        sequence:
        - event: universal_controller_command
          event_data:
            action_type: '{{ ''scene_cycle'' if use_scene else ''light_call'' }}'
            command_input: '{{ '''' if use_scene else ''turn_off'' }}'
            action_value: 'off'
            area_key: '{{ area_key }}'
        - event: lighting_registry_update
          event_data:
            action: remove
            area_key: '{{ area_key }}'
            claimant_id: '{{ claimant_id }}'
            claimant: '{{ claimant_id }}'
      - conditions:
        - condition: template
          value_template: '{{ not is_warned }}'
        sequence:
        - event: universal_controller_command
          event_data:
            action_type: light_call
            command_input: turn_on
            action_value: min
            area_key: '{{ area_key }}'
        - event: lighting_registry_update
          event_data:
            action: warned
            area_key: '{{ area_key }}'
            claimant_id: '{{ claimant_id }}'
    - action: logbook.log
      data:
        name: GPE Cleaner
        message: '{{ ''Final Removal'' if (skip_warning or is_warned) else ''Warning
          Sequence'' }}  initiated for {{ area_key }} (Claimant: {{ claimant_id }})

          '
        entity_id: sensor.{{ area_key }}_presence_intent
        domain: sensor
  mode: parallel
  max: 10
  trace:
    stored_traces: 50
- id: '1776225343554'
  alias: GPE - Intent Distributor (V1.4)
  description: "# GPE - INTENT DISTRIBUTOR (V1.4.1)\n\n## 1. ARCHITECTURAL CORE\nManages
    Area-Specific MQTT Intent Registries. It acts as the central intake for all presence
    and lighting overrides, maintaining a prioritized \"intent stack\" for every area.\n\n##
    2. VERSION LOGIC (v1.4.1)\n* **Strict Claimant ID**: Standardized usage of `claimant_id`.
    \n* **Self-Healing**: Implements legacy key detection to convert `claimant` keys
    to `claimant_id` automatically.\n* **Optimization**: Removed redundant `/presence/state`
    MQTT publications to reduce bus traffic.\n* **Lock Resolution**: Improved logic
    to distinguish between explicit lock commands, inherited locks, and payload-defined
    states.\n\n## 3. PRIORITY LEVELS\n* **Priority 3**: Schedules (Highest persistence).\n*
    **Priority 2**: Manual Overrides (User intervention).\n* **Priority 1**: Motion/Automation
    (Standard logic).\n"
  triggers:
  - trigger: event
    event_type: lighting_registry_update
  - trigger: event
    event_type: esphome.lighting_registry_update
  - trigger: event
    event_type: universal_controller_command
    event_data:
      action_type: lighting_registry_update
  - trigger: event
    event_type: universal_controller_command
    event_data:
      action_type: light_override
  - trigger: mqtt
    id: MQTT_Bus
    options:
      topic: home/universal/bus
      payload: lighting_registry_update
      value_template: '{{ value_json.action_type }}'
  actions:
  - variables:
      p: '{{ (trigger.payload | from_json) if trigger.platform == ''mqtt'' else trigger.event.data
        }}'
      target_area: '{% set t = p.get(''target'', {}) %}

        {{ t.get(''area_id'', p.get(''area_key'', ''none'')) }}'
      val: "{% set t = p.get('target', {}) %} \n\n{{ t.get('label_id') | default(p.get('target_label'),
        true) }}"
      target_labels: '{{ ( [val] if val is string else val) }}

        '
      action_type: '{{ p.action_type | default(''lighting_registry_update'') }}'
      is_valid_mqtt: '{{ trigger.platform != ''mqtt'' or action_type in [''lighting_registry_update'',
        ''light_override''] }}'
  - condition: template
    value_template: '{{ is_valid_mqtt and target_area is not none }}'
  - variables:
      action: '{{ p.action | default(''add'') }}'
      cid: '{{ p.claimant_id | default(''system'') | string }}'
      registry: '{{ state_attr(''sensor.global_variable_registry'', ''vars'') | default({},
        true) }}'
      g_env: '{{ registry.get(''environmental'', {}) }}'
      local_registry: sensor.{{ target_area }}_presence_intent
      current_stack: "{% set raw_stack = state_attr(local_registry, 'intent_stack')
        | default([], true) %} \n{% set ns = namespace(cleaned=[]) %} \n{% for item
        in raw_stack %}\n  {% if 'claimant_id' in item %}\n    {% set ns.cleaned =
        ns.cleaned + [item] %}\n  {% elif 'claimant' in item %}\n    {% set ns_item
        = namespace(new_dict={'claimant_id': item.claimant}) %}\n    {% for key, value
        in item.items() if key != 'claimant' %}\n      {% set ns_item.new_dict = dict(ns_item.new_dict,
        **{key: value}) %}\n    {% endfor %}\n    {% set ns.cleaned = ns.cleaned +
        [ns_item.new_dict] %}\n  {% endif %}\n{% endfor %} {{ ns.cleaned }}"
      new_stack: '{{ current_stack }}'
  - choose:
    - conditions:
      - condition: template
        value_template: '{{ action in [''add'', ''lock'', ''override''] or action_type
          == ''light_override'' }}'
      sequence:
      - variables:
          is_off_cmd: '{{ action_type == ''light_override'' and p.action_value ==
            ''off'' }}'
          is_schedule: '{{ (action_type == ''schedule'' or action == ''schedule''
            or p.intent_type

            == ''schedule'') }}

            '
          is_override: '{{ (action_type == ''light_override'' or action == ''override''
            or p.intent_type == ''override'') }}'
          intent_type: '{{ ''override'' if is_override else (p.intent_type | default(''motion''))
            }}'
          priority: '{{ 3 if is_schedule else ( 2 if is_override else (p.priority
            | default(1) | int)) }}'
          existing: '{{ current_stack | selectattr(''claimant_id'', ''eq'', cid) |
            first | default({}) }}'
          final_lock: '{{ (action == ''lock'' or p.locked in [''true'', true, ''on'']
            or existing.get(''locked'', false)) }}'
          explicit_lock: '{{ p.locked if p.locked is defined else none }}'
          new_stack: "{% if is_off_cmd %}\n  {{ current_stack | rejectattr('type',
            'eq', 'override') | rejectattr('claimant_id', 'eq', cid) | list }}\n{%
            else %}\n  {% set existing = current_stack | selectattr('claimant_id',
            'eq', cid) | first | default({}) %}\n\n\n  {# IMPROVED LOCK RESOLUTION
            #}\n  {# 1. Check for explicit instruction in the payload #}\n  {% set
            explicit_lock = p.locked if p.locked is defined else none %}\n  {% set
            final_lock = false %}\n  {% if action == 'lock' %}\n    {% set final_lock
            = true %}\n  {% elif explicit_lock is not none %}\n    {% set final_lock
            = explicit_lock in ['true', true, 'on', 'ON'] %}\n  {% else %}\n    {#
            Only inherit if no new instruction was provided #}\n    {% set final_lock
            = existing.get('locked', false) %}\n  {% endif %}\n\n\n  \n  {# EXPIRY
            CALCULATIONS #}\n  {% set expiry = none %}\n  {% set seconds = p.seconds
            | default(-2) | int %}\n  \n  {% if not final_lock %}\n    {% if seconds
            == -1 %}\n      {% set expiry = none %}\n    {% elif is_override %}\n
            \     {% if seconds != -2 %}\n        {% set dur_work = g_env.get('override_duration_work',
            36000) | int %}\n        {% set dur_std = g_env.get('override_duration_standard',
            3600) | int %}\n        {% set is_work_area = ('work' in (labels(target_area)
            | default([], true))) %}\n        {% set expiry = (now() + timedelta(seconds=(p.seconds
            | default(dur_work if is_work_area else dur_std) | int))).isoformat()
            %}\n      {% else %}\n        {% set expiry = none %}\n      {% endif
            %}\n    {% else %}\n      {% set default_secs = 30 if 'door' in cid else
            120 %}\n      {% set final_seconds = seconds if seconds >= 0 else default_secs
            %}\n      {% set expiry = (now() + timedelta(seconds=final_seconds)).isoformat()
            %}\n    {% endif %}\n  {% endif %}\n\n  {% set entry = {\n    'type':
            intent_type,\n    'claimant_id': cid,\n    'priority': priority,\n    'expiry':
            expiry,\n    'locked': final_lock,\n    'action_value': p.action_value
            | default('manual' if is_override else ''),\n    'warned': false,\n    'skip_warning':
            (p.skip_warning in ['true', true] or intent_type != 'motion' or final_lock),\n
            \   'target_labels': target_labels,\n    'last_updated': now().isoformat()\n
            \ } %}\n  {% set others = current_stack | rejectattr('claimant_id', 'eq',
            cid) | list %}\n  {{ others + [entry] }}\n{% endif %}"
    - conditions:
      - condition: template
        value_template: '{{ action == ''remove'' }}'
      sequence:
      - variables:
          new_stack: '{{ current_stack | rejectattr(''claimant_id'', ''eq'', cid)
            | list }}'
    - conditions:
      - condition: template
        value_template: '{{ action == ''warned'' }}'
      sequence:
      - variables:
          new_stack: "{% set ns = namespace(stk=[]) %}\n{% for i in current_stack
            %}\n  {% if i.claimant_id == cid %}\n    {% set ns.stk = ns.stk + [dict(i,
            warned=true, last_updated=now().isoformat(), expiry=(now() + timedelta(seconds=20)).isoformat())]
            %}\n  {% else %}\n    {% set ns.stk = ns.stk + [i] %}\n  {% endif %}\n{%
            endfor %}\n{{ ns.stk }}"
  - variables:
      top_expiry: "{% set winner = new_stack | sort(attribute='priority', reverse=true)
        | sort(attribute='locked', reverse=true) | first | default({}) %}\n{# If it's
        locked or no expiry is set, it stays 'none' #}\n{% if winner.get('locked',
        false) or winner.get('expiry') is none %}\n  {{ none }}\n{% else %}\n  {{
        winner.get('expiry') }}\n{% endif %}"
  - action: mqtt.publish
    data:
      topic: homeassistant/sensor/{{ target_area }}/presence/attributes
      payload: '{{ {''intent_stack'': new_stack, ''expiry'': top_expiry,''last_updated'':
        now().isoformat(), ''last_claimant'': cid} | tojson }}    '
      retain: true
  - action: mqtt.publish
    data:
      topic: homeassistant/sensor/{{ target_area }}/presence/state
      payload: active
    enabled: true
  - variables:
      active_intent_count: "{% set registries = label_entities('lights_off') | expand
        %}\n  {% set ns = namespace(count=0) %}\n  {% for r in registries %}\n    {%
        set stack = r.attributes.intent_stack | default([]) %}\n    {% if stack |
        selectattr('expiry', 'defined') \n               | rejectattr('expiry', 'in',
        [none, '']) \n               | rejectattr('locked', 'eq', true)\n               |
        list | count > 0 %}\n      {% set ns.count = ns.count + 1 %}\n    {% endif
        %}\n  {% endfor %}\n  {{ ns.count }}"
  - condition: template
    value_template: '{{ top_expiry != none }}'
  - event: gpe_heartbeat_sync
    event_data:
      active_intent_count: '{{ active_intent_count }}'
      next_check: '{{ top_expiry }}'
      origin_area: '{{ target_area }}'
      reason: '{{ ''registry_distribution_complete'' if active_intent_count == 0 else
        intent_updated }}

        '
  mode: parallel
  max: 20
  trace:
    stored_traces: 50
- id: '1776229098790'
  alias: Universal Matrix Scene Executor V3.0
  description: "# UNIVERSAL MATRIX SCENE EXECUTOR (V3.0)\n## 1. CORE PURPOSE Executes
    lighting scene changes using native `select` entity controls. Leverages Discovery
    v6.0 and maintains UI state history.\n## 2. ARCHITECTURAL LOGIC\n* **Select Native**:
    Uses `select.select_next`, `select.select_previous`, `select.select_first`, `select.select_last`.
    \n* **Memory logic**: Manages `history_stack` via MQTT attribute updates to the
    select entity. \n* **Restore Logic**: Reimplemented to pull from the `history_stack`
    [ -2 ] position. * **Boundary Control**: `cycle: false` enforced.\n## 3. DATA
    DEPENDENCIES\n* **Entity**: `select.{{ area_key }}_scene`"
  triggers:
  - trigger: event
    event_type: universal_controller_command
    event_data:
      action_type: scene_cycle
  - trigger: mqtt
    id: MQTT_Message
    topic: home/universal/bus
  actions:
  - variables:
      payload: '{{ trigger.payload_json if trigger.id == ''MQTT_Message'' else trigger.event.data
        }}'
      is_scene_cmd: '{{ trigger.id != ''MQTT_Message'' or payload.action_type == ''scene_cycle''
        }}'
      area_key: '{{ payload.area_key }}'
      action: '{{ payload.action_value | default(''next'') | string }}'
      target_select: select.{{ area_key }}_matrix_scene
      current_history: '{{ state_attr(target_select, ''history_stack'') | default([],
        true) }}'
  - condition: template
    value_template: '{{ is_scene_cmd and states(target_select) not in [''unknown'',
      ''unavailable''] }}'
  - choose:
    - conditions:
      - condition: template
        value_template: '{{ action in [''next'', ''raise'', ''select_next''] }}'
      sequence:
      - action: select.select_next
        target:
          entity_id: '{{ target_select }}'
        data:
          cycle: false
    - conditions:
      - condition: template
        value_template: '{{ action in [''previous'', ''lower'', ''select_previous'']
          }}'
      sequence:
      - action: select.select_previous
        target:
          entity_id: '{{ target_select }}'
        data:
          cycle: false
    - conditions:
      - condition: template
        value_template: '{{ action in [''off'', ''select_first''] }}'
      sequence:
      - action: select.select_first
        target:
          entity_id: '{{ target_select }}'
    - conditions:
      - condition: template
        value_template: '{{ action in [''max'', ''select_last''] }}'
      sequence:
      - action: select.select_last
        target:
          entity_id: '{{ target_select }}'
    default:
    - variables:
        options: '{{ state_attr(target_select, ''options'') }}'
        target_option: "{% if action == 'restore' %}\n  {# Restore uses the history
          stack: current is [-1], previous was [-2] #}\n  {{ current_history[-2] if
          current_history | length > 1 else options[0] }}\n{% elif action == 'min'
          %}\n  {{ options[1] if options | length > 1 else options[0] }}\n{% else
          %}\n  {% set act_s = action | string %}\n  {% set by_weight = options |
          select('match', '^' ~ act_s ~ ':') | first | default(none) %}\n  {% set
          by_name = options | select('search', act_s) | first | default(none) %}\n
          \ {{ by_weight if by_weight is not none else (by_name if by_name is not
          none else act_s) }}\n{% endif %}"
    - action: select.select_option
      target:
        entity_id: '{{ target_select }}'
      data:
        option: '{{ target_option }}'
  - variables:
      final_state: '{{ states(target_select) }}'
      history_update: "{% set new_stack = current_history %} {% if final_state !=
        current_history[-1] | default('') %}\n  {% set new_stack = (current_history
        + [final_state])[-5:] %}\n{% endif %} {{ new_stack }}"
  - action: mqtt.publish
    data:
      topic: homeassistant/select/{{ area_key }}/scene/attributes
      retain: true
      payload: "{{ {\n  \"options\": state_attr(target_select, 'options'),\n  \"friendly_name\":
        state_attr(target_select, 'friendly_name'),\n  \"icon\": state_attr(target_select,
        'icon'),\n  \"history_stack\": history_update\n} | tojson }}\n"
  - action: mqtt.publish
    data:
      topic: homeassistant/select/{{ area_key }}/scene/state
      retain: true
      payload: "{% set parts = final_state.split(': ') %} {{ {\n  \"name\": parts[1]
        | default('off'),\n  \"sequence_weight\": parts[0] | int(0)\n} | tojson }}\n"
  mode: restart
- id: '1776232344891'
  alias: Universal Matrix Scene Executor V4.1
  description: '# UNIVERSAL MATRIX SCENE EXECUTOR (V4.1)

    ## 1. CORE PURPOSE

    Executes complex lighting state changes via dynamic profile iteration. It acts
    as the "driver" for the Matrix system, converting weight-based scene selections
    into specific light and label commands.

    ## 2. ARCHITECTURAL LOGIC

    * **Profile Lookup**: Fetches scene definitions from `sensor.{{ target_area }}_matrix_scene_config`
    attribute `scenes`.

    * **Weight Keyed**: Uses string representations of sequence weights (e.g., "30")
    to identify the intended lighting profile.

    * **Recursive Dispatch**: Iterates through nested labels (e.g., accent, main)
    for both primary areas and linked secondary areas.

    * **Hybrid Payload Support**: Logic handles both integer values (global area brightness)
    and mapping objects (specific label-to-brightness correlations).

    * **History Tracking**: Manages a `history_stack` within the selection entity
    to allow for "Restore" and "Previous" logic.

    ## 3. DEPENDENCIES

    * `select.{{ area }}_matrix_scene`: The UI/State controller for area scenes.

    * `sensor.{{ area }}_matrix_scene_config`: The data source containing scene JSON.

    * `universal_controller_command`: Event bus for executing light calls.

    * `MQTT Bus`: External trigger support for remote scene cycling.'
  triggers:
  - trigger: event
    event_type: universal_controller_command
    event_data:
      action_type: scene_cycle
    enabled: false
  - trigger: mqtt
    id: MQTT_Bus
    options:
      topic: home/universal/bus
      payload: scene_cycle
      value_template: '{{ value_json.action_type }}'
    enabled: false
  actions:
  - variables:
      payload: '{{ trigger.payload_json if trigger.platform == ''mqtt'' else trigger.event.data
        }}'
      is_scene_cmd: '{{ trigger.platform != ''mqtt'' or payload.action_type == ''scene_cycle''
        }}'
      target_area: '{% set t = payload.get(''target'', {}) %}

        {{ t.get(''area_id'') | default(payload.area_key, true) }}'
      area_key: '{{ target_area }}

        '
      action: '{{ payload.action_value | default(''next'') | string }}'
      target_select: select.{{ target_area }}_matrix_scene
      current_history: '{{ state_attr(target_select, ''history_stack'') | default([],
        true) }}'
      options: '{{ state_attr(target_select, ''options'') | default([], true) }}'
      is_option: '{{ action in options }}'
  - choose:
    - conditions:
      - condition: template
        value_template: '{{ is_option }}'
      sequence:
      - variables:
          final_state: '{{ action }}'
          parts: '{{ final_state.split('': '') }}'
          weight_str: '{{ parts[0] | trim }}'
          profile_sensor: '{{ ''sensor.'' ~ target_area ~ ''_matrix_scene_config''
            }}'
          profiles: '{{ state_attr(profile_sensor, ''scenes'') | default({}, true)
            }}'
          next_scene: '{{ profiles.get(parts[0], none) }}'
      - condition: template
        value_template: '{{ next_scene is not none }}'
      - repeat:
          count: '{{ next_scene.primary.keys() | list | length if next_scene.primary
            is mapping else 1 }}'
          sequence:
          - variables:
              is_map: '{{ next_scene.primary is mapping }}'
              target: "{% if is_map %}\n  {{ [(next_scene.primary.keys() | list)[repeat.index
                - 1]] }}\n{% else %}\n  {{ [] }}\n{% endif %}"
              val: "{% if is_map %}\n  {{ (next_scene.primary.values() | list)[repeat.index
                - 1] }}\n{% else %}\n  {{ next_scene.primary | default(0) }}\n{% endif
                %}"
          - event: universal_controller_command
            event_data:
              source_device: matrix_engine
              action_type: light_call
              target:
                area_id: '{{ target_area }}'
                label_id: '{{ target }}'
              action_value: '{{ val | int(0) if val != '''' else '''' }}'
              command_input: '{{ ''turn_off'' if val | int(0) == 0 and val != ''''
                else ''turn_on'' }}'
      - repeat:
          count: '{{ next_scene.links.keys() | list | length if next_scene.links is
            mapping else 0 }}'
          sequence:
          - variables:
              link_area: '{{ (next_scene.links.keys() | list)[repeat.index - 1] }}'
              link_data: '{{ (next_scene.links.values() | list)[repeat.index - 1]
                }}'
          - repeat:
              count: '{{ link_data.keys() | list | length if link_data is mapping
                else 1 }}'
              sequence:
              - variables:
                  is_sub_map: '{{ link_data is mapping }}'
                  target: "{% if is_sub_map %}\n  {{ [(link_data.keys() | list)[repeat.index
                    - 1]] }}\n{% else %}\n  {{ [] }}\n{% endif %}"
                  val: "{% if is_sub_map %}\n  {{ (link_data.values() | list)[repeat.index
                    - 1] }}\n{% else %}\n  {{ link_data | default(0) }}\n{% endif
                    %}"
              - event: universal_controller_command
                event_data:
                  source_device: matrix_engine_link
                  action_type: light_call
                  target:
                    area_id: '{{ link_area }}'
                    label_id: '{{ target }}'
                  action_value: '{{ val | int(0) if val != '''' else '''' }}'
                  command_input: '{{ ''turn_off'' if val | int(0) == 0 and val !=
                    '''' else ''turn_on'' }}'
      - action: mqtt.publish
        data:
          topic: homeassistant/select/{{ target_area }}/scene/attributes
          retain: true
          payload: "{% set history_update = (current_history + [final_state])[-5:]
            if final_state != current_history[-1] | default('') else current_history
            %} \n{{ {\n  \"options\": state_attr(target_select, 'options'),\n  \"friendly_name\":
            state_attr(target_select, 'friendly_name'),\n  \"icon\": state_attr(target_select,
            'icon'),\n  \"history_stack\": history_update\n} | tojson }}\n"
      - action: mqtt.publish
        data:
          topic: homeassistant/select/{{ target_area }}/scene/state
          retain: true
          payload: "{\n  \"name\": \"{{ next_scene.name }}\",\n  \"sequence_weight\":
            {{ next_scene.sequence_weight }}\n}\n"
      alias: Valid Option Supplied
    - conditions:
      - condition: template
        value_template: '{{ not is_option }}'
      sequence:
      - choose:
        - conditions:
          - condition: template
            value_template: '{{ action in [''next'', ''raise'', ''select_next''] }}'
          sequence:
          - action: select.select_next
            target:
              entity_id: '{{ target_select }}'
            data:
              cycle: false
        - conditions:
          - condition: template
            value_template: '{{ action in [''previous'', ''lower'', ''select_previous'']
              }}'
          sequence:
          - action: select.select_previous
            target:
              entity_id: '{{ target_select }}'
            data:
              cycle: false
        - conditions:
          - condition: template
            value_template: '{{ action in [''off'', ''select_first''] }}'
          sequence:
          - action: select.select_first
            target:
              entity_id: '{{ target_select }}'
        - conditions:
          - condition: template
            value_template: '{{ action in [''max'', ''select_last''] }}'
          sequence:
          - action: select.select_last
            target:
              entity_id: '{{ target_select }}'
        default:
        - variables:
            target_option: "{% if action == 'restore' %}\n  {% set active_history
              = current_history | reject('match', '^0:') | reject('eq', '0') | list
              %}\n  {% if active_history | length > 0 %}\n    {{ active_history[-1]
              }}\n  {% else %}\n    {{ options[1] if options | length > 1 else options[0]
              }}\n  {% endif %}\n{% elif action == 'min' %}\n  {{ options[1] if options
              | length > 1 else options[0] }}\n{% else %}\n  {% set act_s = action
              | string %}\n  {% set by_weight = options | select('match', '^' ~ act_s
              ~ ':') | first | default(none) %}\n  {% set by_name = options | select('search',
              act_s) | first | default(none) %}\n  {{ by_weight if by_weight is not
              none else (by_name if by_name is not none else act_s) }}\n{% endif %}"
        - action: select.select_option
          target:
            entity_id: '{{ target_select }}'
          data:
            option: '{{ target_option }}'
      alias: Action required Processing
  mode: restart
- id: '1776260992889'
  alias: Bridge - Global Presence Reactive Cleaner v3.2
  description: '# GPE - REACTIVE CLEANER (V3.2)

    Reactive State Machine triggered by ''expired'' states. Standardized: Uses claimant_id
    to match V6 Registry Specs.'
  triggers:
  - trigger: state
    entity_id: sensor.expired_presence_intent_master
    id: reactive_trigger
  - trigger: event
    event_type: cleaner_heartbeat
    id: manual_pulse
  actions:
  - variables:
      trigger_entity: "{% if trigger.id == 'reactive_trigger' and trigger.to_state.state
        not in ['none', 'unknown', 'unavailable', 'idle'] %}\n  {{ trigger.to_state.state.split('@')[0]
        }}\n{% else %}\n  {{ none }}\n{% endif %}\n"
      area_key: "{% if trigger.id == 'reactive_trigger' and trigger_entity is not
        none %}\n  {{ area_id(trigger_entity) }}\n{% elif trigger.id == 'manual_pulse'
        %}\n  {{ trigger.event.data.area_key | default('') }}\n{% else %}\n  {{ ''
        }}\n{% endif %}\n"
  - if:
    - condition: template
      value_template: '{{ (trigger.id == ''manual_pulse'' and area_key == '''') }}'
    then:
    - repeat:
        for_each: '{{ state_attr(''sensor.expired_presence_intent_master'', ''expired_entities'')
          | default([], true) }}'
        sequence:
        - variables:
            resolved_area: '{{ area_id(repeat.item) }}'
        - if:
          - condition: template
            value_template: '{{ resolved_area is not none }}'
          then:
          - event: cleaner_heartbeat
            event_data:
              area_key: '{{ resolved_area }}'
          else:
          - action: logbook.log
            data:
              name: GPE Cleaner Alert
              message: 'Cleanup failed: Entity {{ repeat.item }} is expired but has
                no Area ID assigned. Fix MQTT Discovery.'
              entity_id: '{{ repeat.item }}'
              domain: sensor
    else:
    - variables:
        area_key: '{{ area_key | default(''none'', true) }}'
        intent_sensor: sensor.{{ area_key }}_presence_intent
        stack: '{{ state_attr(intent_sensor, ''intent_stack'') | default([], true)
          }}'
        winning_intent: "{% set expired_list = stack | selectattr('expiry', 'ne',
          none) \n    | selectattr('expiry', 'lt', now().isoformat()) | list %}\n{%
          if expired_list | count > 0 %}\n  {{ expired_list | sort(attribute='priority',
          reverse=true) | first }}\n{% else %}\n  {{ stack | sort(attribute='priority',
          reverse=true) | sort(attribute='locked', reverse=true) | first | default(none)
          }}\n{% endif %}"
    - condition: template
      value_template: '{{ winning_intent is not none }}'
    - variables:
        claimant_id: '{{ winning_intent.claimant_id | default(winning_intent.claimant
          | default(''system'')) }}'
        is_warned: '{{ winning_intent.warned | default(false) }}'
        skip_warning: '{{ winning_intent.skip_warning | default(false) }}'
        area_policy: '{{ labels(area_key) | default([], true) }}'
        is_stationary: '{{ ''stationary_zone'' in area_policy }}'
        is_transit: '{{ ''transit_zone'' in area_policy }}'
        should_skip_warning: '{{ skip_warning or is_transit or (not is_stationary)
          }}'
        use_scene: '{{ ''scene_eligible'' in area_policy }}'
    - choose:
      - conditions:
        - condition: template
          value_template: '{{ skip_warning or is_warned }}'
        sequence:
        - event: universal_controller_command
          event_data:
            action_type: '{{ ''scene_cycle'' if use_scene else ''light_call'' }}'
            command_input: '{{ '''' if use_scene else ''turn_off'' }}'
            action_value: 'off'
            target:
              area_id: '{{ area_key }}'
        - event: lighting_registry_update
          event_data:
            action: remove
            area_key: '{{ area_key }}'
            claimant_id: '{{ claimant_id }}'
        - action: logbook.log
          data:
            name: GPE Cleaner
            message: '{{ ''Final Removal'' if (skip_warning or is_warned) else ''Warning
              Sequence'' }}  initiated for {{ area_key }} (Claimant: {{ claimant_id
              }})

              '
            entity_id: '{{ intent_sensor }}'
            domain: sensor
      - conditions:
        - condition: template
          value_template: '{{ not is_warned }}'
        sequence:
        - event: universal_controller_command
          event_data:
            action_type: light_call
            command_input: turn_on
            action_value: min
            target:
              area_id: '{{ area_key }}'
        - event: lighting_registry_update
          event_data:
            action: warned
            area_key: '{{ area_key }}'
            claimant_id: '{{ claimant_id }}'
        - action: logbook.log
          data:
            name: GPE Cleaner
            message: '{{ ''Warning'' if (skip_warning or is_warned) else ''Warning
              Sequence'' }}  initiated for {{ area_key }} (Claimant: {{ claimant_id
              }})

              '
            entity_id: '{{ intent_sensor }}'
            domain: sensor
  mode: parallel
  max: 10
  trace:
    stored_traces: 50
- id: '1776263511060'
  alias: Night Lights Sensor Changes State
  description: Native Binary sensor Night Lights Sensor changes State
  triggers:
  - entity_id:
    - binary_sensor.night_light_sensor
    trigger: state
    to:
    - 'on'
    enabled: false
  conditions: []
  actions:
  - variables:
      rooms:
      - living_room@main@lamps
      - dining_room
      - hallway
      - garage
      - mud_room
      sweep_areas: '{{ label_areas(''Lights Off'') }}'
      sweep_entities: '{{ label_entities(''Lights Off'') }}'
      precision_areas: "{{ sweep_entities \n  | map('area_id') \n  | reject('none')
        \n  | unique \n  | list }}\n"
  - alias: Turn Off Kitchen If Empty
    if:
    - condition: state
      entity_id: binary_sensor.hallway_person
      state:
      - 'off'
    - condition: occupancy.is_not_detected
      target:
        area_id: kitchen
      options:
        behavior: all
    then:
    - alias: Turn Off Kitchen Lights
      event: universal_controller_command
      event_data:
        source_device: light
        action_type: light_call
        action_value: ''
        target:
          label_id: []
          area_id: kitchen
        command_input: turn_off
        data_payload: '{{ trigger }}'
        overrides: {}
  - if:
    - condition: state
      entity_id: binary_sensor.mark_office_presence_sensor_occupancy
      state:
      - 'on'
    then:
    - alias: Reset Mark Office Lights
      event: universal_controller_command
      event_data:
        source_device: light
        action_type: light_call
        action_value: 190
        target:
          label_id: []
          area_id: mark_office
        command_input: turn_on
        data_payload: '{{ trigger }}'
        overrides: {}
    else:
    - alias: Turn Off Mark Office Lights
      event: universal_controller_command
      event_data:
        source_device: light
        action_type: light_call
        action_value: ''
        command_input: turn_off
        target:
          area_id: mark_office
          label_id: []
        data_payload: '{{ trigger }}'
        overrides: {}
  - event: universal_controller_command
    event_data:
      action_type: light_override
      area_key: mud_room
      command_input: 'off'
      data_payload: '{{ trigger.to_state }}'
    alias: Reset Mud Room Lights Override
    enabled: false
  - event: universal_controller_command
    event_data:
      action_type: light_override
      area_key: garage
      command_input: 'off'
      data_payload: '{{ trigger.to_state }}'
    alias: Reset Garage Lights Override
    enabled: false
  - repeat:
      for_each: '{{ sweep_areas }}'
      sequence:
      - event: universal_controller_command
        event_data:
          source_device: light_out
          action_type: light_call
          action_value: ''
          target:
            area_id: '{{ repeat.item }}'
            label_id: []
          command_input: turn_off
  - repeat:
      for_each: '{{ precision_areas }}'
      sequence:
      - event: universal_controller_command
        event_data:
          source_device: light_out
          action_type: light_call
          action_value: ''
          target:
            area_id: '{{ repeat.item }}'
            label_id:
            - Lights Off
          command_input: turn_off
  - repeat:
      for_each: '{{ rooms }}'
      sequence:
      - alias: Turn Off Living Room Main Lights
        event: universal_controller_command
        event_data:
          source_device: light
          action_type: light_call
          action_value: ''
          area_key: '{{ repeat.item.split(''@'')[0] }}'
          command_input: turn_off
          target_label: '{{ repeat.item.split(''@'')[1:] }}'
          data_payload: '{{ trigger }}'
          overrides: {}
    enabled: false
  mode: single
- id: '1776319254207'
  alias: Light Call - Turn On (V3.0)
  description: 'Technical Analysis: Light Call - Turn On (V3.0)


    1. The Core Logic: "The Intersection Engine"


    The genius of this automation is that it doesn''t hardcode entities. It uses a
    Three-Tier Resolution strategy:


    Scope: area_entities(target_area) — Limits the universe to a specific room.


    Intent: label_entities(target_labels) — Filters that universe by function (e.g.,
    "Ambient", "Task").


    Resolution: area_entities | intersect(target_labels) — Finds the exact hardware
    that lives in that room AND serves that purpose.


    2. Hardware Bucketing (The "How")


    Once the targets are resolved, the automation sorts them into "Buckets" based
    on hardware capabilities to prevent service call errors:


    IKEA CCT: Filtered by a 4000K ceiling (likely due to Zigbee/Tradfri specific behavior).


    Standard CCT: General adjustable white lights.


    Dimmer Lights: Forced to use a specific target_br_dimmer (likely legacy dimmers
    that don''t support color temp).


    Binary Lights: Simple On/Off (onoff color mode).


    Standard Lights: The fallback for anything that didn''t fit elsewhere.


    3. Key Strengths


    Strict Area Enforcement: It prevents a "Turn on Ambient" command from lighting
    up the whole house.


    Delta-Checking: Before firing a light.turn_on, it checks if the color temp or
    brightness delta is significant (abs > 50 or abs > 3). This reduces Zigbee/WiFi
    traffic congestion (popcorning).


    Dynamic Command Mapping: The command_map allows for abstract inputs like raise,
    lower, or night_mode to be translated into specific brightness steps.


    4. Why the JSON Registry (V4.0 Path) helps:


    While V3.0 is brilliant, it relies on Home Assistant labels being perfectly maintained.
    A Light Registry would allow you to:


    Define Virtual Groups: Create "endpoints" in JSON that don''t exist as physical
    groups but should act as one.


    Override Hardware Limits: Instead of guessing if a light is IKEA or Standard in
    the YAML, the Registry can explicitly define the min_k and max_k for every bulb
    in a single source of truth.


    Simplify the YAML: You could replace the massive "Hardware Bucketing" section
    with a single lookup to the JSON registry, making the automation 50% shorter and
    much faster to execute.


    Summary of Data Flow


    Trigger (MQTT/Event) -> Payload Extraction -> Area/Label Intersection -> Capability
    Sorting -> Parallel Execution

    '
  triggers:
  - trigger: event
    id: UCC_Event
    event_type: universal_controller_command
    event_data:
      action_type: light_call
    enabled: false
  - trigger: event
    id: eUCC_Event
    event_type: esphome.universal_controller_command
    event_data:
      action_type: light_call
    enabled: false
  - trigger: mqtt
    id: MQTT_Message
    options:
      topic: home/universal/bus
      payload: light_call
      value_template: '{{ value_json.action_type }}'
    enabled: false
  conditions: []
  actions:
  - alias: Intent and Context
    variables:
      registry: '{{ state_attr(''sensor.global_variable_registry'', ''vars'') }}'
      g_logic: '{{ registry.globals.logic_engines }}'
      target_kelvin: '{{ states(g_logic.cct_calculation) | int(3200) }}'
      target_br_dimmer: '{{ states(g_logic.brightness_calculation) | int(255) }}'
      log_dest: '{{ g_logic.system_log }}'
      payload: '{{ trigger.payload if trigger.id == ''MQTT_Message'' else trigger.event.data
        }}'
      action_val: '{{ payload.action_value | default('''') }}'
      area_key: '{{ payload.area_key }}'
      val: '{% set t = payload.get(''target'', {}) %} {{ t.get(''label_id'') | default(payload.target_label,
        true) }}'
      target_labels: "{{ ( [val] if val is string else val) \n  | map('label_entities')
        \n  | sum(start=[]) \n  | unique \n  | list \n}}\n"
      target_area: "{% set t = payload.get('target', {}) %} \n\n{{ t.get('area_id')
        \n  | default(payload.area_key, true) }}"
  - alias: Data Constants
    variables:
      dim_factor: 20
      command_map:
        max:
          brightness: 255
        raise:
          brightness_step: 35
        lower:
          brightness_step: -35
        min:
          brightness: 25
        night_mode:
          brightness: 25
        day_mode:
          brightness: 190
        release:
          brightness_step: 0
      payload: {}
  - alias: Hardware Bucketing and Target Expansion (The "Engine")
    variables:
      area_entities: '{{ area_entities(target_area) | select(''match'', ''light.*'')
        | list }}'
      explicit_entities: '{% set t = payload.get(''target'', {}) %} {{ t.get(''entity_id'')
        | default([], true) }}             '
      intersected: "{% if target_labels | count > 0 %}\n  {{ area_entities | intersect(target_labels)
        }}\n{% else %}\n  {{ area_entities }}\n{% endif %}"
      resolved_targets: '{{ (intersected + explicit_entities) | unique | list }}'
      target_br: "{% set current_cmd = command_map.get(action_val, {}) %} {% if 'brightness_step'
        in current_cmd %}\n  {{ 255 if current_cmd.brightness_step > 0 else 1 }}\n{%
        elif action_val is number or (action_val | is_number) %}\n  {{ ([0, action_val
        | int, 255] | sort)[1] }}\n{% else %}\n  {{ current_cmd.get('brightness',
        190) }}\n{% endif %}\n"
      step_val: '{{ command_map.get(action_val, {}).get(''brightness_step'', 0) }}'
      ikea_cct_lights: "{% set ns = namespace(to_update=[]) %} \n{% for l in states.light
        \n  | selectattr('entity_id', 'in', resolved_targets) \n    if l.attributes.get('max_color_temp_kelvin',
        0) | int <= 4000 \n   and 'color_temp' in l.attributes.get('supported_color_modes',
        []) %}\n      {% set cur_k = l.attributes.get('color_temp_kelvin', 0) | int(0)
        %}\n      {% set cur_br = l.attributes.get('brightness', 0) | int(0) %}\n
        \     {% set clamped_k = ([l.attributes.get('min_color_temp_kelvin', 2202)
        | int, target_kelvin, 4000] | sort)[1] %}\n      {% if (cur_k - clamped_k)
        | abs > 50 or (cur_br - target_br) | abs > 3 %}\n        {% set ns.to_update
        = ns.to_update + [l.entity_id] %}\n      {% endif %}\n{% endfor %} {{ ns.to_update
        }}\n"
      standard_cct_lights: "{% set ns = namespace(to_update=[]) %} {% for l in states.light
        | selectattr('entity_id', 'in', resolved_targets) \n   if l.entity_id not
        in ikea_cct_lights\n   and 'color_temp' in l.attributes.get('supported_color_modes',
        []) %}\n  {% set cur_k = l.attributes.get('color_temp_kelvin', 0) | int(0)
        %}\n  {% set cur_br = l.attributes.get('brightness', 0) | int(0) %}\n  {%
        set min_hw = l.attributes.get('min_color_temp_kelvin', 2200) | int %}\n  {%
        set max_hw = l.attributes.get('max_color_temp_kelvin', 7000) | int %}\n  {%
        set clamped_k = ([min_hw, target_kelvin, max_hw] | sort)[1] %}\n  {% if (cur_k
        - clamped_k) | abs > 50 or (cur_br - target_br) | abs > 3 %}\n    {% set ns.to_update
        = ns.to_update + [l.entity_id] %}\n  {% endif %}\n{% endfor %} {{ ns.to_update
        }}\n"
      dimmer_lights: "{{ resolved_targets \n  | intersect(label_entities('CurrentCTDimmer'))
        \n  | list }}\n"
      binary_lights: "{{ resolved_targets\n  | expand\n  | selectattr('attributes.supported_color_modes',
        'defined')\n  | selectattr('attributes.supported_color_modes', 'eq', ['onoff'])\n
        \ | selectattr('state', 'in', ['off'])\n  | map(attribute='entity_id') | list
        }}\n"
      excluded: "{{ ikea_cct_lights + standard_cct_lights + dimmer_lights + binary_lights
        \n  | list \n  | default([]) }}\n"
      standard_lights: "{{ resolved_targets \n  | reject('in', excluded ) \n  | expand\n
        \ | selectattr('state', 'in', ['off'])\n  | map(attribute='entity_id') | list
        }}\n"
  - if:
    - condition: template
      alias: Check for Intersection Failure
      value_template: '{{ target_labels | count > 0 and intersected | count == 0 }}'
    then:
    - action: logbook.log
      data:
        name: GPE Intersection Error
        message: 'Area ''{{ target_area }}'' has no lights matching labels: {{ target_labels
          }}. Action ignored.'
        entity_id: '{{ g_logic.system_log | default(''sensor.global_variable_registry'')
          }}'
  - parallel:
    - alias: IKEA CCT Turn On
      if:
      - condition: template
        value_template: '{{ ikea_cct_lights | length > 0 }}'
      then:
      - action: light.turn_on
        target:
          entity_id: '{{ ikea_cct_lights }}'
        data: '{% set base_data = {''color_temp_kelvin'': target_kelvin} %}

          {{ dict(base_data, brightness_step=step_val) if step_val != 0 else dict(base_data,
          brightness=target_br) }}

          '
    - alias: Standard CCT Turn On
      if:
      - condition: template
        value_template: '{{ standard_cct_lights | length > 0 }}'
      then:
      - action: light.turn_on
        target:
          entity_id: '{{ standard_cct_lights }}'
        data: '{% set base_data = {''color_temp_kelvin'': target_kelvin} %} {{ dict(base_data,
          brightness_step=step_val) if step_val != 0 else dict(base_data, brightness=target_br)
          }}

          '
    - alias: Dimmer Lights Turn On
      if:
      - condition: template
        value_template: '{{ dimmer_lights | length > 0 }}'
      then:
      - action: light.turn_on
        target:
          entity_id: '{{ dimmer_lights }}'
        data:
          brightness: '{{ target_br_dimmer | int(150) }}'
    - alias: Binary Lights Turn On
      if:
      - condition: template
        value_template: '{{ binary_lights | length > 0 }}'
      then:
      - action: light.turn_on
        target:
          entity_id: '{{ binary_lights }}'
        data: {}
    - alias: Standard Lights Turn On
      if:
      - condition: template
        value_template: '{{ standard_lights | length > 0 }}'
      then:
      - action: light.turn_on
        target:
          entity_id: '{{ standard_lights }}'
        data: '{% set base_data = {} %}

          {{ dict(base_data, brightness_step=step_val) if step_val != 0 else dict(base_data,
          brightness=target_br) }}

          '
  - action: logbook.log
    data:
      name: Light Engine (On)
      message: 'Light Call Source: {{ payload.source_device | default('''') }} | Area:
        {{ target_area }} | Label: {{ val[0] | default(''All'') }} | color_temp_kelvin:
        {{ target_kelvin }} {{this.entity_id}}'
      entity_id: '{{ log_dest }}'
  mode: queued
  max: 20
  trace:
    stored_traces: 50
- id: '1776345333625'
  alias: Light Call - Turn Off (V2.0)
  description: ''
  triggers:
  - trigger: event
    id: UCC_Event
    event_type: universal_controller_command
    event_data:
      action_type: light_call
      command_input: turn_off
    enabled: false
  - trigger: event
    id: eUCC_Event
    event_type: esphome.universal_controller_command
    event_data:
      action_type: light_call
      command_input: turn_off
    enabled: false
  - trigger: mqtt
    id: MQTT_Message
    options:
      topic: home/universal/bus
      payload: light_call
      value_template: '{{ value_json.action_type }}'
    enabled: false
  conditions: []
  actions:
  - alias: Define Actions
    variables:
      payload: '{{ trigger.payload if trigger.id == ''MQTT_Message'' else trigger.event.data
        }}'
      area_id: '{{ payload.get(''area_key'', ''none'') }}'
      command: '{{ payload.get(''command_input'', '''') }}'
      action_type: '{{ payload.get(''action_type'', ''none'') }}'
      action_value: '{{ payload.get(''action_value'', ''none'') }}'
      val: '{% set t = payload.get(''target'', {}) %} {{ t.get(''label_id'') | default(payload.get(''target_label'',
        []), true) }}'
      target_label_entities: "{{ ( [val] if val is string else val) \n  | map('label_entities')
        \n  | sum(start=[]) \n  | unique \n  | list \n}}\n"
      target_area: '{% set t = payload.get(''target'', {}) %} {{ t.get(''area_id'')
        | default(payload.area_key, true) }}'
  - variables:
      transition: 0.2
      is_whole_area: '{{ val | length == 0 }}'
      area_light_entities: '{{ area_entities(target_area) | select(''match'', ''light.*'')
        | list }}'
      explicit_entities: '{% set t = payload.get(''target'', {}) %} {{ t.get(''entity_id'')
        | default([], true) }}             '
      intersected: "{% if target_label_entities | count > 0 %}\n  {{ area_light_entities
        | intersect(target_label_entities) }}\n{% else %}\n  {{ area_light_entities
        }}\n{% endif %}"
      resolved_targets: '{{ (intersected + explicit_entities) | unique | list }}'
      final_targets: "{{ resolved_targets\n  | expand \n  | rejectattr('state', 'eq',
        'off') \n  | map(attribute='entity_id') \n  | list }}\n"
      final_target_data: "{% if is_whole_area %}\n  {{ {\"area_id\": target_area}
        }}\n{% else %}\n  {{ {\"entity_id\": final_targets} }}\n{% endif %}\n"
      log_nominee: "{% if final_targets | length > 0 %}\n  {{ final_targets | first
        }}\n{% else %}\n  {% set main_light = area_lights | intersect(label_entities('main'))
        | first | default('none') %}\n  {{ main_light if main_light != 'none' else
        (area_lights | first | default('sensor.ucc_registry_log')) }}\n{% endif %}\n"
      telemetry: '{% set t_id = trigger.id | default(''Event'') %}

        {% set src = payload.source_device | default(''unknown'') %}

        [ID: {{ t_id }} | Src: {{ src }} | Val: {{ action_value | default(''none'')
        }}]

        '
      action: '{{ payload.action_value | default(''next'') | string }}'
      scene_id: "{% set t = payload.get('target', {}) %} \n\n{{ t.get('scene_id')
        | default('none', true) }}\n"
      scene_name: '{{ action | trim | title }}'
      target_select: select.{{ target_area }}_matrix_scene
      current_history: '{{ state_attr(target_select, ''history_stack'') | default([],
        true) }}'
      local_options: '{{ state_attr(target_select, ''options'') | default([], true)
        }}'
      zb_options: "{% set ns = namespace(found=[]) %}\n{%- set prefix = 'scene.' ~
        target_area ~ '_' %}\n\n{%- for s in states.scene \n   | selectattr('entity_id',
        'search', '^' ~ prefix ~ '[0-9]*0_') -%}\n  \n  {%- set suffix = s.entity_id
        | replace(prefix, '', 1) -%}\n  {%- set parts = suffix.split('_') -%}\n  \n
        \ {%- set scene_id = parts[0] -%}\n  {%- set scene_name = parts[1:] | join('
        ') | title -%}\n  \n  {%- set ns.found = ns.found + [ scene_id ~ ': ' ~ scene_name
        ] -%}\n{%- endfor -%}\n{{ ns.found  | unique | sort }}"
      is_zigbee_scene: '{{ zb_options is list and zb_options | count > 0 }}

        '
      options: '{{ zb_options if is_zigbee_scene else local_options }}

        '
      is_option: '{{ action in options }}'
  - if:
    - condition: template
      value_template: '{{ final_target_data.area_id is defined or (final_target_data.entity_id
        is defined and final_target_data.entity_id | length > 0) }}'
    then:
    - action: light.turn_off
      target: '{{ final_target_data }}'
      data: {}
    - action: logbook.log
      data:
        name: Light Engine (Off)
        message: 'Turned off {{ final_targets | length }} lights in {{ area_id }}.
          (Source: {{ payload.source_device | default('''') }}) {{this.entity_id}}
          {{ telemetry }}'
        entity_id: sensor.ucc_registry_log
    - action: logbook.log
      data:
        name: Light Engine (Off)
        message: 'Turned off {{ final_targets | length }} lights in {{ area_id }}.
          (Source: {{ payload.source_device | default('''') }}) {{this.entity_id}}
          {{ telemetry }}'
        entity_id: '{{ log_nominee }}'
    else:
    - alias: Silent Skip
      stop: All target lights are already off. Mesh silenced.
  mode: queued
  max: 20
- id: '1776372606900'
  alias: 'Override: Universal Engine v2'
  description: Handle manual relay overrides generically based on labels V2.0
  triggers:
  - trigger: state
    entity_id:
    - sensor.active_override_source
    from:
    to:
    id: Override_id
  - trigger: state
    entity_id:
    - binary_sensor.night_light_sensor
    from:
    to:
    id: Night_id
  - trigger: state
    entity_id: input_boolean.dummy
    id: Night_id
  conditions:
  - condition: template
    value_template: "{{ trigger.to_state.state not in ['none', 'unknown', 'unavailable']\n
      \  and trigger.from_state.state != trigger.to_state.state \n   }}\n"
  actions:
  - choose:
    - conditions:
      - condition: trigger
        id:
        - Override_id
      sequence:
      - variables:
          source_entity: '{{ trigger.to_state.state.split(''|'')[0] }}

            '
          area_key: '{{ area_id(source_entity) | default(''none'') }}'
          entity_labels: '{{ labels(source_entity) }}'
          action_type: lighting_registry_update
          action_value: '{{ states[source_entity].state }}'
          action: '{{ ''add'' if is_state(source_entity, ''on'') else ''remove'' }}'
          claimant_id: '{{ source_entity }}'
          intent_type: override
          seconds: '{{ -1 if is_state(source_entity, ''on'') else 0 }}'
          source_device: manual_action
      - event: lighting_registry_update
        event_data:
          action: '{{ action }}'
          action_type: '{{ action_type }}'
          claimant_id: '{{ claimant_id }}'
          intent_type: '{{ intent_type }}'
          target:
            area_id: '{{ area_key }}'
          seconds: '{{ seconds }}'
          source_device: '{{ source_device }}'
        enabled: true
      - action: logbook.log
        metadata: {}
        data:
          name: Lighting Override Engine
          message: 'Override for {{ area_key }} State: {{ states[source_entity].state
            }} '
          entity_id: '{{ source_entity }}'
    - conditions:
      - condition: template
        value_template: '{{ trigger.id == ''Night_id'' and trigger.to_state.state
          in [''on''] }}'
      sequence:
      - alias: Overridden Lights Still on at Nights Out
        repeat:
          for_each: "{% set eligible = label_entities('override_eligible') %} {{ states.light
            \n  | selectattr('state', 'in', ['on']) \n  | selectattr('context.parent_id',
            'none')\n  | selectattr('context.user_id', 'none')\n  | map(attribute='entity_id')\n
            \ | intersect(eligible)\n  | list }}\n"
          sequence:
          - event: lighting_registry_update
            event_data:
              action: add
              action_type: lighting_registry_update
              claimant_id: '{{ repeat.item }}'
              intent_type: override
              target:
                area_id: '{{ area_id(repeat.item) | default(''none'') }}'
              seconds: 0
              source_device: manual_action
            enabled: true
          - action: logbook.log
            metadata: {}
            data:
              name: Lighting Override Engine
              message: 'Override for {{ area_key }} State: {{ states[repeat.item].state
                }} '
              entity_id: '{{ repeat.item }}'
      - action: alarm_control_panel.alarm_arm_night
        metadata: {}
        data:
          code: '1111'
        target:
          entity_id: alarm_control_panel.home_alarm
    - conditions:
      - condition: template
        value_template: '{{ trigger.id == ''Night_id'' and trigger.to_state.state
          in [''off''] }}'
      sequence:
      - action: alarm_control_panel.alarm_disarm
        metadata: {}
        target:
          entity_id: alarm_control_panel.home_alarm
        data:
          code: '1111'
  mode: parallel
  variables:
    registry: '{{ state_attr(''sensor.global_variable_registry'', ''vars'') | default({},
      true) }}'
    g_env: '{{ registry.get(''globals'', {}).get(''environmental'', {}) }}'
    g_hvac: '{{ registry.get(''globals'', {}).get(''hvac'', {}) }}'
    g_logic: '{{ registry.get(''globals'', {}).get(''logic_engines'', {}) }}'
    is_ready: '{{ g_env != {} }}'
  max: 20
- id: '1776395038808'
  alias: Hammer Away
  description: ''
  triggers:
  - trigger: time_pattern
    seconds: /30
  conditions: []
  actions:
  - variables:
      active_registries: "{{ label_entities('lights_off') | unique \n   | expand \n
        \  | selectattr('state', 'in', ['active']) \n   | map(attribute='entity_id')
        \n   | reject('eq', local_registry)\n   | list }}"
  - if:
    - condition: template
      value_template: '{{ active_registries | count > 0  }}'
    then:
    - repeat:
        for_each: '{{ active_registries }}'
        sequence:
        - variables:
            target_area: '{{ area_id(repeat.item) }}'
        - action: mqtt.publish
          data:
            topic: homeassistant/sensor/{{ target_area }}/presence/state
            payload: reset
          enabled: true
  mode: single
- id: '1776523073896'
  alias: Switch Office Main Switch Event V1.1
  description: Single press detection for Office Main Light V1.1
  triggers:
  - trigger: mqtt
    options:
      topic: zigbee2mqtt/+
      payload: true
      value_template: '{{ value_json.detach_relay_mode and value_json.action is defined
        }}'
    id: Zigbee_id
    enabled: false
  conditions: []
  actions:
  - variables:
      payload: '{{ trigger.payload_json }}'
      device_name: '{{ trigger.topic.split(''/'')[1] }}'
      area_id: '{{ device_name.lower().replace(''relay'', '''').strip().replace(''
        '', ''_'') }}'
      target_light: "{{ label_entities('main') \n   | select('match', 'light\\.')\n
        \  | select('in', area_entities(area_id)) \n   | first | default('none') }}\n"
      intended_command: '{{ ''turn_off'' if is_state(target_light, ''on'') else ''turn_on''
        }}'
  - condition: template
    value_template: '{{ target_light != ''none'' }}'
  - alias: Emit Generic Universal Controller Command Event
    event: universal_controller_command
    event_data:
      source_device: z2m_physical_rocker
      action_type: light_call
      action_value: ''
      command_input: '{{ intended_command }}'
      target:
        area_id: '{{ area_id }}'
        label_id:
        - main
      data_payload: '{{ payload }}'
      overrides: {}
  - alias: Direct Inject into Lighting Registry
    event: lighting_registry_update
    event_data:
      action: '{{ ''add'' if intended_command == ''turn_on'' else ''remove'' }}'
      action_type: lighting_registry_update
      claimant_id: '{{ device_name }}'
      intent_type: override
      target:
        area_id: '{{ area_id }}'
        label_id:
        - main
      locked: true
      source_device: z2m_physical_rocker
  - data:
      name: UCC_SENT
      message: 'Area: {{ area_id }} | Action: light_call | Value: {{ target_light
        }}'
      entity_id: sensor.ucc_registry_log
    action: logbook.log
  - delay:
      hours: 0
      minutes: 0
      seconds: 0
      milliseconds: 250
  mode: single
- id: '1776564486018'
  alias: GPE - Orchestrator (V3)
  description: "# GPE - ORCHESTRATOR (V3.0) \nDecision engine for environmental presence.\n##
    1. CORE PURPOSE\nActs as the central decision engine for environmental presence.
    Fully  integrated with the Priority Intent Stack (Registry v6.1).\n## 2. ARCHITECTURAL
    LOGIC\n* **Priority Intent Integration**: All presence events are tagged with
    \n  `intent_type: motion` to ensure they interact correctly with the \n  multi-layered
    priority stack.\n  \n* **Standardized Handshake**: Uses `claimant_id` as the primary
    identifier \n  to align with Registry v6.1 and Cleaner v2.1 standards.\n  \n*
    **The Handover Pattern**: When high-precision presence clears, the system \n  automatically
    hands over to a 120s motion-type timer instead of immediate \n  removal, preventing
    jarring light cut-offs.\n\n* **The Gatekeeper Pattern**: Suppresses redundant
    commands if the room \n  is already in the desired state and filters false-positives
    via \n  Ghost/Veto logic.\n\n## 3. VERSION HISTORY\n* **V3.0**: Implemented schduled
    lighting via lighting schedule template sensor.\n* **V2.4**: Implemented conditional
    'seconds' (30s for door-only transitions).\n* **V2.3.5**: Fixed Safety Unlock
    to use explicit 'add' for grace period.\n* **V2.3.3**: Hardened Presence Update/Cleared
    aliases to strictly ignore \n  locked areas. Prevents motion-off events from overwriting
    infinite locks.\n\n* **V2.3.2**: Refined Valid Turn On to ignore door events if
    area is locked.\n  Prevents race conditions between Portal Turn On and Safety
    Unlock.\n\n* **V2.3.1**: Relaxed door_age restriction in should_lock_area. \n
    \ Allows locking if motion is sustained while the door is closed, \n  even if
    the door closure was >120s ago.\n\n* **V2.3**: Removed 'Presence Off' from should_unlock_area
    to prevent \n  premature unlocking when motion clears in locked zones.\n  \n*
    **V2.2**: Fix Modified should_unlock_area to transition to a 30s grace period
    instead  of immediate removal to prevent instant blackouts when doors open.\n*
    **V2.1**: Standardized on `claimant_id`. Implemented 120s \"Handover\" logic for
    cleared presence. Restored missing Door Timer and Motion Reset logic. \n* **V2.0**:
    Implemented Multi-Tenant Ownership tracking. Standardized event \n  schema for
    Registry v5.7 compatibility.\n  \n* **V1.5**: Updated attribute paths to `active_intents`.
    Standardized \n  `intent_type` as 'motion' for all presence-based additions."
  triggers:
  - trigger: state
    entity_id: sensor.active_sensor_monitor_master
    id: presence_id
  - trigger: state
    entity_id: sensor.front_yard_light_schedule
    id: schedule_id
    enabled: false
  conditions:
  - condition: template
    value_template: "{{ trigger.to_state.state not in ['none', 'unknown', 'unavailable']
      and\n   trigger.from_state.state != trigger.to_state.state and \n   is_ready
      }}"
  - condition: template
    value_template: "{% set is_overridden = current_stack | selectattr('type', 'eq',
      'override') | list | count > 0 %}  \n\n{{ area_key != 'none' and not is_overridden
      }}\n"
    enabled: false
  actions:
  - variables:
      local_registry: sensor.{{ area_key }}_presence_intent
      current_stack: "{% set raw_stack = state_attr(local_registry, 'intent_stack')
        | default([], true) %} \n{% set ns = namespace(cleaned=[]) %} \n{% for item
        in raw_stack %}\n  {% if 'claimant_id' in item %}\n    {% set ns.cleaned =
        ns.cleaned + [item] %}\n  {% elif 'claimant' in item %}\n    {% set ns_item
        = namespace(new_dict={'claimant_id': item.claimant}) %}\n    {% for key, value
        in item.items() if key != 'claimant' %}\n      {% set ns_item.new_dict = dict(ns_item.new_dict,
        **{key: value}) %}\n    {% endfor %}\n    {% set ns.cleaned = ns.cleaned +
        [ns_item.new_dict] %}\n  {% endif %}\n{% endfor %} \n{{ ns.cleaned }}"
      is_on: '{{ is_state(source_entity, ''on'') }}'
      light_schedule_state: "{% set eligible = label_entities('light_schedule') %}
        \n{% set light_schedule = area_entities(area_key)\n  | intersect(eligible)\n
        \ | first\n  | default('none') %}\n{{ 'presence' if light_schedule == 'none'
        else states(light_schedule) }}"
      is_presence: '{{ (''presence'' in entity_labels or ''person'' in entity_labels)
        and (light_schedule_state == ''presence'' ) }}'
      is_door: '{{ ''door'' in entity_labels }}'
      is_entrance: '{{ ''entrance'' in entity_labels }}'
      area_policy: '{{ labels(area_key) }}'
      use_scene: '{{ ''scene_eligible'' in area_policy }}'
      use_night_settings: '{{ ''night_light'' in area_policy and is_state(g_env.night_posture_sensor,
        ''on'') }}'
      final_target_label: "{% if use_night_settings %} \n  {{ ['night_light'] }} \n{%
        else %}\n  {{ ['main'] }}\n{% endif %}"
      adjoining_area: '{{ registry.get(''area_metadata'', {}).get(area_key, {}).get(''neighbors'',
        {}).get(''peer'', ''none'') }}'
      door_entity: '{{ (area_entities(area_key) | intersect(label_entities(''door'')))
        | first | default(''none'') }}'
      has_door: '{{ door_entity != ''none'' }}'
      presence_entity: '{{ (area_entities(area_key) | intersect(label_entities(''presence'')))
        | first | default(''none'') }}'
      has_presence: '{{ presence_entity != ''none'' }}'
      is_door_closed: '{{ is_state(door_entity, ''off'') if has_door else false }}'
      door_age: '{{ as_timestamp(now()) - as_timestamp(states[door_entity].last_changed,
        0) if has_door else 0 }}'
      is_lock_zone: '{{ ''lock_eligible'' in area_policy }}'
      locked_intent: '{{ current_stack | selectattr(''locked'', ''eq'', true) | first
        | default(none) }}'
      is_area_locked: '{{ locked_intent is not none }}'
      locked_claimant_id: '{{ locked_intent.claimant_id if is_area_locked else ''none''
        }}'
      hvac_action: '{{ state_attr(g_hvac.primary_unit, ''hvac_action'') | default(''idle'')
        }}'
      hvac_is_active: '{{ hvac_action in [''cooling'', ''heating''] }}'
      is_ghost: '{{ has_door and is_presence and is_on and is_door_closed and not
        is_area_locked and (door_age > 600 or hvac_is_active) }}'
      should_lock_area: "{{ is_lock_zone and is_presence and is_on and is_door_closed
        and not is_area_locked and \n   (door_age < 120 or (current_stack | selectattr('type',
        'eq', 'motion') | list | count > 0)) }}"
      should_unlock_area: "{{ is_area_locked and (\n  (is_door and is_on) or\n  (has_door
        and not is_door_closed and door_age < 5)\n) }}"
      should_trigger_peer: '{{ is_door and is_on and area_key != ''none'' and adjoining_area
        != ''none'' }}'
  - variables:
      target_select: select.{{ area_key }}_matrix_scene
      raw_scene: '{{ states(target_select) }}'
      is_room_off: '{% set s = raw_scene %} {{ s is defined and (s == ''0'' or s.startswith(''0:''))
        }}

        '
      call_scene: '{{ is_room_off and is_presence and is_on and use_scene }}'
      call_off_scene: '{{ not is_room_off and is_presence and not is_on and use_scene
        }}'
  - choose:
    - conditions:
      - condition: template
        value_template: '{{ trigger.id == ''presence_id'' }}'
      sequence:
      - choose:
        - alias: Veto Log (Ghost Detected)
          conditions:
          - condition: template
            value_template: '{{ is_presence and is_on and is_ghost }}'
          sequence:
          - action: logbook.log
            data:
              name: GPE VETO
              message: 'GPE VETO: Ghost in {{ area_key }} (HVAC: {{ hvac_action }},
                Door Age: {{ door_age | int }}s, Lock Status: {{ is_area_locked}})'
              entity_id: '{{ source_entity }}'
        - alias: Lock Presence (Sabbatical)
          conditions:
          - condition: template
            value_template: '{{ should_lock_area and not is_area_locked }}'
          sequence:
          - event: lighting_registry_update
            event_data:
              action: lock
              claimant_id: '{{ source_entity }}'
              target:
                area_id: '{{ area_key }}'
              intent_type: motion
          - event: universal_controller_command
            event_data:
              action_type: light_call
              command_input: turn_on
              target:
                area_id: '{{ area_key }}'
                label_id: '{{ final_target_label }}'
              action_value: '{{ ''night_mode'' if use_night_settings else ''day_mode''
                }}'
              source_device: '{{ source_entity }}'
          - action: logbook.log
            data:
              name: GPE LOCKED
              message: 'LOCKED: {{ area_key }} via {{ source_entity }}. (Door Age:
                {{ door_age | int }}s, Presence: {{ is_on }})'
              entity_id: '{{ source_entity }}'
        - alias: Valid Turn On (Anti-Ghosting)
          conditions:
          - condition: template
            value_template: '{# Only allow Portal/Motion Turn On if not locked. If
              locked, Safety Unlock handles the exit. #} {{ (is_entrance or is_door
              or is_presence) and is_on and not is_ghost and not is_area_locked }}'
          sequence:
          - action: logbook.log
            data:
              name: GPE
              message: 'Turn On: Via {{''Motion'' if is_presence else ''Portal'' }}
                Room {{ area_key }} (Registry Reset, Door Age: {{ door_age | int }}s)'
              entity_id: '{{ source_entity }}'
          - if:
            - condition: template
              value_template: '{{ not use_scene }}'
            then:
            - event: universal_controller_command
              event_data:
                action_type: light_call
                command_input: turn_on
                target:
                  area_id: '{{ area_key }}'
                  label_id: '{{ final_target_label }}'
                action_value: '{{ ''night_mode'' if use_night_settings else ''day_mode''
                  }}'
                source_device: '{{ source_entity }}'
            - event: lighting_registry_update
              event_data:
                action: add
                claimant_id: '{{ source_entity }}'
                target:
                  area_id: '{{ area_key }}'
                  label_id: '{{ final_target_label }}'
                seconds: '{{ 30 if is_door and has_presence else -1 }}'
                intent_type: motion
            else:
            - event: lighting_registry_update
              event_data:
                action: remove
                claimant_id: '{{ source_entity }}'
                target:
                  area_id: '{{ area_key }}'
                  label_id: '{{ final_target_label }}'
                intent_type: motion
            - condition: template
              value_template: '{{ call_scene }}'
            - event: universal_controller_command
              event_data:
                action_type: scene_cycle
                target:
                  area_id: '{{ area_key }}'
                action_value: restore
                source_device: '{{ source_entity }}'
        - alias: Presence Cleared (Handover)
          conditions:
          - condition: template
            value_template: '{{ is_presence and not is_on and not is_area_locked }}'
          sequence:
          - choose:
            - conditions:
              - condition: template
                value_template: '{{ not use_scene }}'
              sequence:
              - event: lighting_registry_update
                event_data:
                  action: add
                  claimant_id: '{{ source_entity }}'
                  target:
                    area_id: '{{ area_key }}'
                    label_id: '{{ final_target_label }}'
                  intent_type: motion
                  seconds: 120
              alias: Start Expiry Timer (120s)
            - conditions:
              - condition: template
                value_template: '{{ call_off_scene }}'
              sequence:
              - event: lighting_registry_update
                event_data:
                  action: add
                  claimant_id: '{{ source_entity }}'
                  target:
                    area_id: '{{ area_key }}'
                    label_id: '{{ final_target_label }}'
                  intent_type: motion
                  skip_warning: true
                  seconds: 300
              alias: Call Off Scene
          - event: cleaner_heartbeat
        - alias: Door Closed Timer Reset
          conditions:
          - condition: template
            value_template: '{{ is_door and not is_on }}'
          sequence:
          - event: lighting_registry_update
            event_data:
              action: add
              claimant_id: '{{ source_entity }}'
              target:
                area_id: '{{ area_key }}'
                label_id: '{{ final_target_label }}'
              intent_type: motion
              seconds: 30
              skip_warning: '{{ not is_lock_zone }}'
        - alias: Presence Update (Motion Reset)
          conditions:
          - condition: template
            value_template: '{{ is_presence and is_on and not is_area_locked and (not
              has_door or not is_door_closed ) }}'
          sequence:
          - event: lighting_registry_update
            event_data:
              action: add
              claimant_id: '{{ source_entity }}'
              target:
                area_id: '{{ area_key }}'
                label_id: '{{ final_target_label }}'
              intent_type: motion
              seconds: 120
        - alias: Safety Unlock (Grace Period)
          conditions:
          - condition: template
            value_template: '{{ should_unlock_area }}'
          sequence:
          - action: logbook.log
            data:
              name: GPE UNLOCK
              message: 'UNLOCKING: {{ area_key }} (Handover to 30s Grace). (Reason:
                Door Opened/Ajar)'
              entity_id: '{{ source_entity }}'
          - event: lighting_registry_update
            event_data:
              action: add
              claimant_id: '{{ locked_claimant_id }}'
              target:
                area_id: '{{ area_key }}'
                label_id: '{{ final_target_label }}'
              intent_type: motion
              seconds: 30
              locked: false
      - if:
        - condition: template
          value_template: '{{ should_trigger_peer }}'
        then:
        - event: universal_controller_command
          event_data:
            action_type: light_call
            command_input: turn_on
            target:
              area_id: '{{ adjoining_area }}'
              label_id: '{{ final_target_label }}'
            action_value: preheat
      alias: Presence Driven Events
    - conditions:
      - condition: template
        value_template: '{{ trigger.id == ''schedule_id'' }}'
      sequence:
      - variables:
          schedule_state: '{{  trigger.to_state.state.split(''@'')[2] | default(''none'',
            true)  }}'
      - choose:
        - conditions:
          - condition: template
            value_template: '{{ schedule_state == ''on'' }}'
          sequence:
          - event: lighting_registry_update
            event_data:
              action: add
              claimant_id: '{{ source_entity }}'
              target:
                area_id: '{{ area_key }}'
                label_id: '{{ final_target_label }}'
              seconds: -1
              intent_type: schedule
          - event: universal_controller_command
            event_data:
              action_type: light_call
              command_input: turn_on
              target:
                area_id: '{{ area_key }}'
                label_id: '{{ final_target_label }}'
              action_value: '{{ ''night_mode'' if use_night_settings else ''day_mode''
                }}'
              source_device: '{{ source_entity }}'
          - action: select.select_option
            metadata: {}
            target:
              entity_id: '{{ source_entity }}'
            data:
              option: 'on'
        - conditions:
          - condition: template
            value_template: '{{ schedule_state == ''off'' }}'
          sequence:
          - event: lighting_registry_update
            event_data:
              action: remove
              claimant_id: '{{ source_entity }}'
              target:
                area_id: '{{ area_key }}'
                label_id: '{{ final_target_label }}'
              intent_type: schedule
          - event: universal_controller_command
            event_data:
              action_type: light_call
              command_input: turn_off
              target:
                area_id: '{{ area_key }}'
                label_id: '{{ final_target_label }}'
              action_value: ''
              source_device: '{{ source_entity }}'
          - action: select.select_option
            metadata: {}
            target:
              entity_id: '{{ source_entity }}'
            data:
              option: '{{ ''presence'' if use_night_settings else ''off'' }}'
      alias: Schedule Driven Updates
  - variables:
      last_sync: '{{ this.attributes.last_triggered | as_timestamp | default(none)
        }}'
      cooldown_met: '{{ last_sync is none or (now() | as_timestamp  - last_sync) >
        20 }}'
      active_registries: "{{ label_entities('lights_off') | unique \n   | expand \n
        \  | selectattr('state', 'in', ['active','expired']) \n   | map(attribute='entity_id')
        \n   | reject('eq', local_registry)\n   | list }}"
  - if:
    - condition: template
      value_template: '{{ active_registries | count > 0 and cooldown_met }}'
    then:
    - repeat:
        for_each: '{{ active_registries }}'
        sequence:
        - variables:
            target_area: '{{ area_id(repeat.item) }}'
        - action: mqtt.publish
          data:
            topic: homeassistant/sensor/{{ target_area }}/presence/state
            payload: reset
          enabled: true
  mode: parallel
  variables:
    registry: '{{ state_attr(''sensor.global_variable_registry'', ''vars'') | default({},
      true) }}'
    g_env: '{{ registry.get(''globals'', {}).get(''environmental'', {}) }}'
    g_hvac: '{{ registry.get(''globals'', {}).get(''hvac'', {}) }}'
    g_logic: '{{ registry.get(''globals'', {}).get(''logic_engines'', {}) }}'
    source_entity: '{{ trigger.to_state.state.split(''@'')[0] }}'
    area_key: '{{ area_id(source_entity) | default(''none'') }}'
    entity_labels: '{{ labels(source_entity) }}'
    is_ready: '{{ g_env != {} and area_key != ''none'' }}'
  max: 50
  trace:
    stored_traces: 50
- id: '1776606173377'
  alias: Lutron Pico - Pico Registry Update (V3.0)
  description: '

    # LUTRON PICO - PICO REGISTRY UPDATE (V3.0)

    ## 1. PURPOSE

    Provides a high-performance hardware abstraction layer for Lutron Pico remotes
    within the Home Assistant environment. This engine processes raw electrical pulses
    into distinct software gestures (Press, Double, and Hold) and broadcasts them
    as Universal Controller Commands (UCC). It also manages area-level intent registration
    to ensure manual human overrides are prioritized over automated logic.

    ## 2. ARCHITECTURE

    **Hardware Interface**: Listens for the lutron_caseta_button_event bus for low-latency
    event processing.

    **Gesture Engine**: Implements a 500ms/250ms timing window for gesture discrimination.

    **Decoupling**: Converts hardware serials into semantic target_area and target_label
    context.

    **Intent Layer**: Automatically updates the lighting_registry for override_eligible
    areas to create manual state locks.

    ## 3. DEPENDENCIES

    **sensor.pico_registry**: Tracks active button sessions and isOwned flags to prevent
    race conditions.

    **sensor.pico_config_[serial]**: Configuration lookup table generated by the Pico
    Cartographer (Node-RED).

    **label:override_eligible**: Area-level metadata tag required for manual intent
    registration.'
  triggers:
  - trigger: event
    event_type: lutron_caseta_button_event
    event_data:
      action: press
  conditions:
  - condition: template
    value_template: '{{ not is_owned or is_expired }}'
  actions:
  - event: lutron_button_event
    event_data:
      device_id: '{{ device_id }}'
      isOwned: true
      owned_ts: '{{ as_timestamp(trigger.event.time_fired) }}'
  - variables:
      device_id: '{{ trigger.event.data.device_id | default(''none'') }}'
      session_id: '{{ trigger.event.context.id | default(''none'') }}'
      button_type: '{{ trigger.event.data.button_type | default(''unknown'') }}'
      button_number: '{{ trigger.event.data.button_number | default(0) }}'
      target_area: '{{ area_id(device_id) | default(none) }}'
      serial: '{{ trigger.event.data.serial | default(0) }}'
      sensor_entity: sensor.pico_config_{{ serial | string }}
      isCommission: '{{ has_value(sensor_entity) and state_attr(sensor_entity, ''config'')
        not in [none, '''', ''unknown''] }}'
      command_map: '{% set entity = sensor_entity | default(''none'') %} {{ state_attr(entity,
        ''config'') }}

        '
  - if:
    - condition: template
      value_template: '{{ isCommission }}'
    then:
    - alias: Wait for first Release Event... If None After 450ms then it's Hold
      wait_for_trigger:
      - event_type: lutron_caseta_button_event
        event_data:
          serial: '{{ serial | default(0) }}'
          device_id: '{{ device_id }}'
          button_number: '{{ button_number | default(0) }}'
          action: release
        id: release_event
        trigger: event
      timeout:
        hours: 0
        minutes: 0
        seconds: 0
        milliseconds: 500
      continue_on_timeout: true
    - variables:
        is_hold: '{{ wait.trigger is none }}'
        target_label: "{% set entity = sensor_entity | default('none') %} \n\n{{ state_attr(entity,
          'metadata').get('target_label', []) }}\n"
    - if:
      - condition: template
        value_template: '{{ not is_hold }}'
      then:
      - wait_for_trigger:
        - event_type: lutron_caseta_button_event
          event_data:
            serial: '{{ serial | default(0) }}'
            button_number: '{{ button_number | default(0) }}'
            action: press
          id: press_event
          trigger: event
        timeout:
          milliseconds: 250
        continue_on_timeout: true
        alias: Wait For Second Press
      - variables:
          is_double: '{{ wait.trigger is not none }}'
      - if:
        - condition: template
          value_template: '{{ is_double }}'
        then:
        - variables:
            command: double
          alias: Dedicated Double Variables
        else:
        - variables:
            command: press
          alias: Dedicated Press Variables
      else:
      - variables:
          command: hold
          command_type: "{{ trigger.event.data.button_type  \n  | lower \n  | replace('
            ', '') \n  | replace('_', '') }}_{{ command }}\n"
          action_map: '{{ command_map.get(command,{}) }}'
          cmd: '{{ action_map.get(button_number | string , {}) }}'
        alias: Dedicated Hold Variables
      - variables:
          repeat_delay: '{{ 125 if cmd.type == ''media_call'' else 500 }}'
          max_hold_time: 9
          max_iterations: '{{ (max_hold_time / (repeat_delay / 1000)) | round(0) }}'
        alias: Dedicated Repeat Variables
      - repeat:
          until:
          - condition: template
            value_template: '{{ wait.trigger is not none or repeat.index > max_iterations
              }}'
          sequence:
          - alias: Hold Event
            event: universal_controller_command
            event_data:
              source_device: pico
              action_type: '{{ cmd.type | default(none) }}'
              action_value: '{{ cmd.value | default(none) }}'
              command_input: '{{ cmd.action | default(none) }}'
              area_key: '{{ target_area }}'
              target_label: '{{ target_label }}'
              session_id: '{{ session_id }}'
              data_payload: '{{ trigger.event.data }}'
              overrides: '{}'
              command: '{{ command }}'
              command_type: '{{ command_type }}'
            enabled: true
          - wait_for_trigger:
            - event_type: lutron_caseta_button_event
              event_data:
                serial: '{{ serial | default(0) }}'
                device_id: '{{ device_id }}'
                button_number: '{{ button_number | default(0) }}'
                action: release
              trigger: event
            timeout:
              hours: 0
              minutes: 0
              seconds: 0
              milliseconds: '{{ repeat_delay | int }}'
            continue_on_timeout: true
          - variables:
              is_hold: '{{ wait.trigger is none }}'
              hold_duration: '{% set end = as_timestamp(wait.trigger.event.time_fired)
                if wait.trigger is not none else as_timestamp(now()) %} {{ (end -
                start_ts) | round(3) }}

                '
        enabled: true
      - variables:
          command: release
    - variables:
        command_type: "{{ trigger.event.data.button_type  \n  | lower \n  | replace('
          ', '') \n  | replace('_', '') }}_{{ command }}\n"
        action_map: '{{ command_map.get(command,{}) }}'
        cmd: '{{ action_map.get(button_number | string , none ) }}'
    else:
    - variables:
        cmd:
          type: pico_commission
          value: ''
          action: broadcast
  - if:
    - condition: template
      value_template: '{{ cmd is not none }}'
    then:
    - alias: Press Event
      event: universal_controller_command
      event_data:
        source_device: pico
        action_type: '{{ cmd.type | default(none) }}'
        action_value: '{{ cmd.value | default(none) }}'
        command_input: '{{ cmd.action | default(none) }}'
        area_key: '{{ target_area }}'
        target_label: '{{ target_label }}'
        session_id: '{{ session_id }}'
        data_payload: '{{ trigger.event.data }}'
        overrides: '{}'
        command: '{{ command }}'
        command_type: '{{ command_type }}'
      enabled: true
    - action: logbook.log
      data:
        name: UCC_SENT
        message: 'Area: {{ area_id(device_id) | default(none) }} | Action: {{cmd.type
          | default('''') }} | Value: {{cmd.value | default('''') }} | Label: {{ target_label[0]
          }} | Config: {{sensor_entity | default('''') }}'
        entity_id: sensor.ucc_registry_log
    - variables:
        is_eligable: '{{ target_area in label_areas(''override_eligible'') }}'
    - condition: template
      value_template: '{{ is_eligable and cmd.type == ''light_call'' and cmd.action
        in [''turn_on'', ''turn_off''] }}

        '
    - event: lighting_registry_update
      event_data:
        action: '{{ ''add'' if cmd.action == ''turn_on'' else ''remove'' }}'
        claimant_id: '{{ device_id }}'
        area_key: '{{ target_area }}'
        seconds: '{{ -1 if cmd.action == ''turn_on'' else 0 }}'
        intent_type: override
        locked: '{{ true if cmd.action == ''turn_on'' else false }}'
  - event: lutron_button_event
    event_data:
      device_id: '{{ device_id }}'
      isOwned: false
      owned_ts: '{{ as_timestamp(now()) }}'
  mode: parallel
  variables:
    session_id: '{{ trigger.event.context.id }}'
    sessions: '{{ state_attr(''sensor.pico_registry'', ''active_sessions'') | default({})
      }}'
    device_id: '{{ trigger.event.data.device_id | default(''none'') }}'
    session: '{{ sessions.get(device_id, {}) }}'
    is_owned: '{{ session.isOwned | default(false) }}'
    start_ts: '{{ as_timestamp(trigger.event.time_fired) | default(as_timestamp(now()))
      }}'
    is_expired: '{{start_ts >= (session.expiry | default(0)) }}'
  max: 10
- id: '1776630191924'
  alias: GPE - Reactive Cleaner v4.0
  description: "# GPE - REACTIVE CLEANER (V4.0)\n## 1. PURPOSE\nLogic: Semantic Purge
    Engine. Centralizes the expiration and cleanup of the  Global Presence Engine
    (GPE) intent registry. It ensures the environment  reacts gracefully when human
    presence is no longer detected.\n## 2. ARCHITECTURE\n1. **Batch Purge**: Efficiently
    clears all expired, non-locked intents from the registry.\n2. **Semantic Warning
    Policy**: Implements a \"Warning State\" (dimming) before \n   final extinction,
    using dynamic discovery of doors and area labels.\n   \n3. **Ownership**: Uses
    'this.entity_id' to claim warning states, preventing \n   intent collisions during
    transition.\n   \n4. **Lock Support**: Respects 'locked: true' intents as absolute
    survivors, \n   preventing purges of critical manual or system states.\n\n## 3.
    DEPENDENCIES\n* `sensor.expired_presence_intent_master`: Master stream of expiring
    registry items.\n* `label:lock_eligible`: Determines if an area should enforce
    door-based logic.\n* `label:door`: Used for semantic door-state checking during
    warnings.\n* `label:scene_eligible`: Switches output from light calls to scene
    cycles."
  triggers:
  - trigger: state
    entity_id: sensor.expired_presence_intent_master
    id: reactive_trigger
  - trigger: event
    event_type: cleaner_heartbeat
    id: manual_pulse
  actions:
  - variables:
      trigger_entity: "{% if trigger.id == 'reactive_trigger' and trigger.to_state.state
        not in ['none', 'unknown', 'unavailable', 'idle'] %}\n  {{ trigger.to_state.state.split('@')[0]
        }}\n{% else %}\n  {{ none }}\n{% endif %}\n"
      area_key: "{% if trigger.id == 'reactive_trigger' and trigger_entity is not
        none %}\n  {{ area_id(trigger_entity) }}\n{% elif trigger.id == 'manual_pulse'
        %}\n  {{ trigger.event.data.area_key | default('') }}\n{% else %}\n  {{ ''
        }}\n{% endif %}\n"
  - if:
    - condition: template
      value_template: '{{ (trigger.id == ''manual_pulse'' and area_key == '''') }}'
    then:
    - repeat:
        for_each: '{{ state_attr(''sensor.expired_presence_intent_master'', ''expired_entities'')
          | default([], true) }}'
        sequence:
        - variables:
            resolved_area: '{{ area_id(repeat.item) }}'
        - if:
          - condition: template
            value_template: '{{ resolved_area is not none }}'
          then:
          - event: cleaner_heartbeat
            event_data:
              area_key: '{{ resolved_area }}'
    else:
    - variables:
        area_key: '{{ area_key | default(''none'', true) }}'
        intent_sensor: sensor.{{ area_key }}_presence_intent
        stack: '{{ state_attr(intent_sensor, ''intent_stack'') | default([], true)
          }}'
        now_iso: '{{ now().isoformat() }}'
        purge_list: "{{ stack \n  | selectattr('locked', 'false')\n  | selectattr('expiry',
          'ne', none) \n  | selectattr('expiry', 'lt', now_iso) | list }}"
        active_survivors: "{{ (stack \n   | rejectattr('warned', 'true') \n   | selectattr('expiry',
          'gt', now_iso) \n   | list + \n   stack \n     | selectattr('locked', 'true')
          \n     | list) \n | unique(attribute='claimant_id') \n | list \n | count
          }}"
        sole_survivor_candidate: "{% if active_survivors | int == 0 %}\n  {{ purge_list
          \n    | sort(attribute='expiry', reverse=true) \n    | sort(attribute='priority',
          reverse=true) \n    | first | default(none) }}\n{% else %}\n  {{ none }}\n{%
          endif %}"
    - condition: template
      value_template: '{{ purge_list | count > 0 }}'
    - repeat:
        for_each: '{{ purge_list }}'
        sequence:
        - if:
          - condition: template
            value_template: '{{ repeat.item.claimant_id != (sole_survivor_candidate.claimant_id
              | default(''none'')) }}'
          then:
          - event: lighting_registry_update
            event_data:
              action: remove
              area_key: '{{ area_key }}'
              claimant_id: '{{ repeat.item.claimant_id }}'
          - action: logbook.log
            data:
              name: GPE Cleaner
              message: Purged expired Rank:{{ repeat.item.type }} ({{ repeat.item.claimant_id
                }}) in {{ area_key }}.
              entity_id: '{{ intent_sensor }}'
    - if:
      - condition: template
        value_template: '{{ sole_survivor_candidate is not none }}'
      then:
      - variables:
          target: '{{ sole_survivor_candidate }}'
          claimant_id: '{{ target.claimant_id }}'
          is_warned: '{{ target.warned | default(false) }}'
          area_labels: '{{ labels(area_key) | default([], true) }}'
          door_entity: '{{ (area_entities(area_key) | intersect(label_entities(''door'')))
            | first | default(''none'') }}'
          has_door: '{{ door_entity != ''none'' }}'
          is_door_closed: '{{ is_state(door_entity, ''off'') if has_door else false
            }}'
          is_lockable: '{{ ''lock_eligible'' in area_labels }}'
          should_skip_warning: "{% if is_lockable and is_door_closed %}\n  {{ false
            }}\n{% else %}\n  {{ target.skip_warning | default(false) or 'transit_zone'
            in area_labels or 'stationary_zone' not in area_labels }}\n{% endif %}"
          use_scene: '{{ ''scene_eligible'' in area_labels }}'
      - choose:
        - conditions:
          - condition: template
            value_template: '{{ should_skip_warning or is_warned }}'
          sequence:
          - event: universal_controller_command
            event_data:
              action_type: '{{ ''scene_cycle'' if use_scene else ''light_call'' }}'
              command_input: '{{ '''' if use_scene else ''turn_off'' }}'
              action_value: 'off'
              target:
                area_id: '{{ area_key }}'
          - event: lighting_registry_update
            event_data:
              action: remove
              area_key: '{{ area_key }}'
              claimant_id: '{{ claimant_id }}'
        - conditions:
          - condition: template
            value_template: '{{ not is_warned and not should_skip_warning }}'
          sequence:
          - event: universal_controller_command
            event_data:
              action_type: light_call
              command_input: turn_on
              action_value: min
              target:
                area_id: '{{ area_key }}'
          - event: lighting_registry_update
            event_data:
              action: warned
              area_key: '{{ area_key }}'
              claimant_id: '{{ this.entity_id }}'
  mode: parallel
  max: 10
  trace:
    stored_traces: 50
- id: '1776633657853'
  alias: Bridge - Global Presence Reactive Cleaner v4.1
  description: '# GPE - REACTIVE CLEANER (V4.1)

    Logic: Semantic Purge Engine.

    1. Batch-purges all expired intents from the registry.

    2. Implements Semantic Warning Policy for ''lock_eligible'' areas.

    3. Ownership: Uses ''this.entity_id'' for warning claims.

    4. Night Sweep: Automatically triggers a sweep when night_light_sensor turns ON.'
  triggers:
  - trigger: state
    entity_id: sensor.expired_presence_intent_master
    id: reactive_trigger
  - trigger: event
    event_type: cleaner_heartbeat
    id: manual_pulse
  - trigger: event
    event_type: gpe_night_sweep
    id: sweep_trigger
  - trigger: state
    entity_id: binary_sensor.night_light_sensor
    to: 'on'
    id: night_sensor_trigger
  actions:
  - variables:
      trigger_entity: "{% if trigger.id == 'reactive_trigger' and trigger.to_state.state
        not in ['none', 'unknown', 'unavailable', 'idle'] %}\n  {{ trigger.to_state.state.split('@')[0]
        }}\n{% else %}\n  {{ none }}\n{% endif %}\n"
      area_key: "{% if trigger.id == 'night_sensor_trigger' %}\n  {{ '' }}\n{% elif
        trigger.id == 'reactive_trigger' and trigger_entity is not none %}\n  {{ area_id(trigger_entity)
        }}\n{% elif trigger.id in ['manual_pulse', 'sweep_trigger'] %}\n  {{ trigger.event.data.area_key
        | default('') }}\n{% else %}\n  {{ '' }}\n{% endif %}\n"
      force_purge: "{% if trigger.id == 'reactive_trigger' %}\n  false\n{% else %}\n
        \ {{ trigger.event.data.force_purge | default(false) }}\n{% endif %}\n"
  - if:
    - condition: template
      value_template: '{{ (trigger.id in [''manual_pulse'', ''sweep_trigger'', ''night_sensor_trigger'']
        and area_key == '''') }}'
    then:
    - repeat:
        for_each: "{% if trigger.id in ['sweep_trigger', 'night_sensor_trigger'] %}\n
          \ {{ label_areas('Lights Off') }}\n{% else %}\n  {{ state_attr('sensor.expired_presence_intent_master',
          'expired_entities') | default([], true) }}\n{% endif %}"
        sequence:
        - variables:
            resolved_area: '{{ repeat.item if trigger.id in [''sweep_trigger'', ''night_sensor_trigger'']
              else area_id(repeat.item) }}'
        - if:
          - condition: template
            value_template: '{{ resolved_area is not none }}'
          then:
          - event: gpe_night_sweep
            event_data:
              area_key: '{{ resolved_area }}'
              force_purge: '{{ true if trigger.id in [''sweep_trigger'', ''night_sensor_trigger'']
                else false }}'
    else:
    - variables:
        area_key: '{{ area_key | default(''none'', true) }}'
        intent_sensor: sensor.{{ area_key }}_presence_intent
        stack: '{{ state_attr(intent_sensor, ''intent_stack'') | default([], true)
          }}'
        now_iso: '{{ now().isoformat() }}'
        purge_list: "{{ stack \n  | selectattr('locked', 'false')\n  | selectattr('expiry',
          'ne', none) \n  | selectattr('expiry', 'lt', now_iso if not force_purge
          else '2099-01-01') | list }}"
        active_survivors: "{{ (stack | rejectattr('warned', 'true') | selectattr('expiry',
          'gt', now_iso) | list + \n    stack | selectattr('locked', 'true') | list)
          \n  | unique(attribute='claimant_id') | list | count if not force_purge
          else 0 }}"
        sole_survivor_candidate: "{% if active_survivors | int == 0 %}\n  {{ purge_list
          \n    | sort(attribute='expiry', reverse=true) \n    | sort(attribute='priority',
          reverse=true) \n    | first | default(none) }}\n{% else %}\n  {{ none }}\n{%
          endif %}"
    - condition: template
      value_template: '{{ purge_list | count > 0 }}'
    - repeat:
        for_each: '{{ purge_list }}'
        sequence:
        - if:
          - condition: template
            value_template: '{{ repeat.item.claimant_id != (sole_survivor_candidate.claimant_id
              | default(''none'')) }}'
          then:
          - event: lighting_registry_update
            event_data:
              action: remove
              area_key: '{{ area_key }}'
              claimant_id: '{{ repeat.item.claimant_id }}'
    - if:
      - condition: template
        value_template: '{{ sole_survivor_candidate is not none }}'
      then:
      - variables:
          target: '{{ sole_survivor_candidate }}'
          is_warned: '{{ target.warned | default(false) }}'
          area_labels: '{{ labels(area_key) | default([], true) }}'
          door_entity: '{{ (area_entities(area_key) | intersect(label_entities(''door'')))
            | first | default(''none'') }}'
          is_door_closed: '{{ is_state(door_entity, ''off'') if door_entity != ''none''
            else false }}'
          is_lockable: '{{ ''lock_eligible'' in area_labels }}'
          should_skip_warning: '{% if is_lockable and is_door_closed %} {{ false }}
            {% else %} {{ force_purge or target.skip_warning | default(false) or ''transit_zone''
            in area_labels }} {% endif %}'
          use_scene: '{{ ''scene_eligible'' in area_labels }}'
      - choose:
        - conditions:
          - condition: template
            value_template: '{{ should_skip_warning or is_warned }}'
          sequence:
          - event: universal_controller_command
            event_data:
              action_type: '{{ ''scene_cycle'' if use_scene else ''light_call'' }}'
              command_input: '{{ '''' if use_scene else ''turn_off'' }}'
              action_value: 'off'
              target:
                area_id: '{{ area_key }}'
          - event: lighting_registry_update
            event_data:
              action: remove
              area_key: '{{ area_key }}'
              claimant_id: '{{ target.claimant_id }}'
        - conditions:
          - condition: template
            value_template: '{{ not is_warned and not should_skip_warning }}'
          sequence:
          - event: universal_controller_command
            event_data:
              action_type: light_call
              command_input: turn_on
              action_value: min
              target:
                area_id: '{{ area_key }}'
          - event: lighting_registry_update
            event_data:
              action: warned
              area_key: '{{ area_key }}'
              claimant_id: '{{ this.entity_id }}'
  mode: parallel
  max: 10
- id: '1776703722405'
  alias: 'System: Posture & Intent Gateway'
  description: "# SYSTEM: POSTURE & INTENT GATEWAY (V3.0)\nCentral processing engine
    for house-wide posture transitions.\n## 1. PURPOSE\nGatekeeps non-automated state
    changes. It acts as the bridge between physical  hardware (Relays/Switches), environmental
    sensors (Night Light), and the  Global Presence Engine (GPE) registry.\n## 2.
    ARCHITECTURE\n  \n* **Posture Branch**: Bridges the `binary_sensor.night_light_sensor`
    to the \n  House Posture Alarm Panel, triggering mode shifts.\n  \n* **Sweep Engine**:
    Listens for posture changes to perform a 'Smart Purge' \n  of manual overrides
    when transitioning into restrictive modes (Night/Away).\n\n## 3. DEPENDENCIES\n*
    `alarm_control_panel.house_posture`: The master state machine for the matrix.\n*
    `label:override_eligible`: Required on entities to participate in Smart Purges."
  triggers:
  - trigger: state
    entity_id:
    - sensor.active_override_source
    from:
    to:
    id: Override_id
    enabled: false
  - trigger: state
    entity_id:
    - binary_sensor.night_light_sensor
    from:
    to:
    id: Night_id
    enabled: true
  - trigger: state
    entity_id: input_boolean.dummy
    id: Night_id
    enabled: true
  - trigger: state
    entity_id:
    - alarm_control_panel.house_posture_engine_house_posture
    id: posture_shift_trigger
    enabled: true
  conditions:
  - condition: template
    value_template: "{{ trigger.to_state.state not in ['none', 'unknown', 'unavailable']\n
      \  and trigger.from_state.state != trigger.to_state.state \n   }}\n"
  actions:
  - choose:
    - conditions:
      - condition: trigger
        id:
        - Night_id
      sequence:
      - if:
        - condition: state
          entity_id: binary_sensor.night_light_sensor
          state: 'on'
        then:
        - action: alarm_control_panel.alarm_arm_night
          target:
            entity_id: alarm_control_panel.house_posture_engine_house_posture
          data: {}
        else:
        - if:
          - condition: state
            entity_id: alarm_control_panel.house_posture_engine_house_posture
            state:
            - armed_night
          then:
          - action: alarm_control_panel.alarm_disarm
            target:
              entity_id: alarm_control_panel.house_posture_engine_house_posture
            data: {}
    - conditions:
      - condition: trigger
        id: posture_shift_trigger
      sequence:
      - variables:
          new_state: '{{ trigger.get(''to_state'', {}).get(''state'', ''none'') }}'
          posture_slug: "{% if new_state == 'armed_night' %}\n  night \n{% elif new_state
            in ['armed_away', 'armed_vacation'] %}\n  away \n{% else %} \n  default
            \n{% endif %}"
      - if:
        - condition: template
          value_template: '{{ posture_slug in [''night'', ''away''] }}'
        then:
        - repeat:
            for_each: "{% set eligible = label_entities('override_eligible') %} \n\n{{
              states.light \n  | selectattr('state', 'eq', 'on') \n  | map(attribute='entity_id')\n
              \ | intersect(eligible)\n  | list }}"
            sequence:
            - event: lighting_registry_update
              event_data:
                action: remove
                claimant_id: '{{ repeat.item }}'
                area_key: '{{ area_id(repeat.item) }}'
                intent_type: override
  mode: parallel
  variables:
    registry: '{{ state_attr(''sensor.global_variable_registry'', ''vars'') | default({},
      true) }}'
    g_env: '{{ registry.get(''globals'', {}).get(''environmental'', {}) }}'
    g_hvac: '{{ registry.get(''globals'', {}).get(''hvac'', {}) }}'
    g_logic: '{{ registry.get(''globals'', {}).get(''logic_engines'', {}) }}'
    is_ready: '{{ g_env != {} }}'
  max: 20
- id: '1776708279590'
  alias: GPE - Schedule Heartbeat
  description: '# GPE - SCHEDULE HEARTBEAT


    ## CORE LOGIC


    Iterates through all entities labeled ''light_schedule'' (typically `select` or

    `input_select` entities).



    ## RULES


    1. **Sync Check**: If the schedule selector state (''on''/''off'') matches the

    `binary_sensor.daily_lights_sensor` state, it updates the Intent Registry.


    2. **Presence Mode**: If the selector is set to ''presence'', this engine

    ignores the area, allowing motion/presence sensors to take priority.


    3. **Priority**: Dispatches as `intent_type: schedule` with a persistent

    expiry (`seconds: -1`).

    '
  triggers:
  - trigger: state
    entity_id: binary_sensor.daily_lights_sensor
    id: DayLight
  - trigger: state
    entity_id: sensor.light_schedule_master
    id: ScheduleChange
  - trigger: state
    entity_id: input_boolean.dummy
    id: DayLight
  - trigger: state
    entity_id: binary_sensor.night_light_sensor
    id: NightLight
    enabled: false
  actions:
  - variables:
      registry: '{{ state_attr(''sensor.global_variable_registry'', ''vars'') | default({},
        true) }}'
      g_env: '{{ registry.get(''globals'', {}).get(''environmental'', {}) }}'
      g_hvac: '{{ registry.get(''globals'', {}).get(''hvac'', {}) }}'
      g_logic: '{{ registry.get(''globals'', {}).get(''logic_engines'', {}) }}'
  - choose:
    - conditions:
      - alias: Manual Schedule Change
        condition: template
        value_template: '{{ (trigger.id == ''ScheduleChange'')  }}'
      sequence:
      - variables:
          schedule_entity: '{{trigger.to_state.state.split(''|'')[0] }}'
          schedule_val: '{{ states(schedule_entity) }}'
          entity_labels: '{{ labels(schedule_entity) }}'
          area_key: '{{ area_id(schedule_entity) }}'
          area_policy: '{{ labels(area_key) }}'
          use_scene: '{{ ''scene_eligible'' in area_policy }}'
          use_daily_settings: '{{ ''day_light'' in area_policy and is_state(g_env.night_posture_sensor,
            ''off'') }}'
          use_auto_settings: '{{ ''auto_lights'' in area_policy and is_state(g_env.daily_lights_sensor,
            ''on'') }}'
          use_night_settings: '{{ ''night_light'' in area_policy and is_state(g_env.night_posture_sensor,
            ''on'') }}'
          final_target_label: "{% if use_night_settings %} \n  {{ ['night_light']
            }} \n{% else %}\n  {{ ['main'] }}\n{% endif %}"
          schedule_state: '{{ states(g_env.daily_lights_sensor) }}'
          is_active: '{{ is_state(g_env.daily_lights_sensor, ''on'') and schedule_val
            == ''on'' }}'
      - if:
        - condition: template
          value_template: '{{is_active }}'
        then:
        - event: lighting_registry_update
          event_data:
            action: add
            claimant_id: '{{ schedule_entity }}'
            target:
              area_id: '{{ area_key }}'
              label_id: '{{ final_target_label }}'
            seconds: -1
            intent_type: schedule
        - event: universal_controller_command
          event_data:
            action_type: light_call
            command_input: turn_on
            target:
              area_id: '{{ area_key }}'
              label_id: '{{ final_target_label }}'
            action_value: '{{ ''night_mode'' if use_night_settings else ''day_mode''
              }}'
            source_device: '{{ schedule_entity }}'
        else:
        - event: lighting_registry_update
          event_data:
            action: add
            claimant_id: '{{ schedule_entity }}'
            target:
              area_id: '{{ area_key }}'
              label_id: '{{ final_target_label }}'
            seconds: 0
            intent_type: schedule
    default:
    - alias: All Light Schedules Currently ON or Off
      repeat:
        for_each: "\n{{ label_entities('light_schedule')\n  | list\n  }}\n"
        sequence:
        - variables:
            schedule_entity: '{{ repeat.item }}'
            schedule_intent_state: '{{ states(repeat.item) }}'
            entity_labels: '{{ labels(schedule_entity) }}'
            area_key: '{{ area_id(schedule_entity) }}'
            area_policy: '{{ labels(area_key) }}'
            use_scene: '{{ ''scene_eligible'' in area_policy }}'
            use_daily_settings: '{{ ''day_light'' in area_policy and is_state(g_env.night_posture_sensor,
              ''off'') }}'
            use_auto_settings: '{{ ''auto_lights'' in area_policy and is_state(g_env.daily_lights_sensor,
              ''on'') }}'
            use_night_settings: '{{ ''night_light'' in area_policy and is_state(g_env.night_posture_sensor,
              ''on'') }}'
            final_target_label: "{% if use_night_settings %} \n  {{ ['night_light']
              }} \n{% else %}\n  {{ ['main'] }}\n{% endif %}"
            schedule_state: '{{ states(g_env.daily_lights_sensor) }}'
            is_active: '{{ is_state(g_env.daily_lights_sensor, ''on'') and schedule_intent_state
              == ''on'' }}'
        - choose:
          - conditions:
            - alias: Auto Light On
              condition: template
              value_template: '{{ (trigger.id == ''DayLight'') and  use_auto_settings
                }}'
            sequence:
            - alias: Set Schedule Intent to On
              if:
              - alias: Set Schedule Intent
                condition: template
                value_template: '{{ schedule_intent_state != ''on'' }}'
              then:
              - action: select.select_option
                metadata: {}
                target:
                  entity_id: '{{ schedule_entity }}'
                data:
                  option: 'on'
                alias: Set Schedule to On
            - event: lighting_registry_update
              event_data:
                action: add
                claimant_id: '{{ schedule_entity }}'
                target:
                  area_id: '{{ area_key }}'
                  label_id: '{{ final_target_label }}'
                seconds: -1
                intent_type: schedule
            - event: universal_controller_command
              event_data:
                action_type: light_call
                command_input: turn_on
                target:
                  area_id: '{{ area_key }}'
                  label_id: '{{ final_target_label }}'
                action_value: '{{ ''night_mode'' if use_night_settings else ''day_mode''
                  }}'
                source_device: '{{ schedule_entity }}'
          - conditions:
            - alias: Day Light Presence Sensors Is On
              condition: template
              value_template: '{{ (trigger.id == ''DayLight'') and (use_daily_settings
                or use_night_settings) }}'
            sequence:
            - event: lighting_registry_update
              event_data:
                action: remove
                claimant_id: '{{ schedule_entity }}'
                target:
                  area_id: '{{ area_key }}'
                  label_id: '{{ final_target_label }}'
                intent_type: schedule
            - if:
              - alias: Set Schedule Intent to Presence
                condition: template
                value_template: '{{ schedule_intent_state != ''presence'' }}'
              then:
              - action: select.select_option
                metadata: {}
                target:
                  entity_id: '{{ schedule_entity }}'
                data:
                  option: presence
                alias: Set Schedule to Presence
              alias: Set Schedule Intent to Presence
          default:
          - alias: Set Schedule Intent to Off
            if:
            - alias: Set Schedule Intent
              condition: template
              value_template: '{{ schedule_intent_state != ''off'' }}'
            then:
            - action: select.select_option
              metadata: {}
              target:
                entity_id: '{{ schedule_entity }}'
              data:
                option: 'off'
              alias: Set Schedule to Off
          - event: lighting_registry_update
            event_data:
              action: remove
              claimant_id: '{{ schedule_entity }}'
              target:
                area_id: '{{ area_key }}'
                label_id: '{{ final_target_label }}'
              intent_type: schedule
          - event: lighting_registry_update
            event_data:
              action: add
              claimant_id: '{{ schedule_entity }}'
              target:
                area_id: '{{ area_key }}'
                label_id: '{{ final_target_label }}'
              seconds: 0
              intent_type: schedule
  - choose:
    - conditions: []
      sequence: []
    - conditions:
      - alias: Auto Light Off
        condition: template
        value_template: '{{ (trigger.id == ''DayLight'') and not use_auto_settings  and
          not use_daily_settings }}'
      sequence: []
    - conditions:
      - alias: Night Light Presence Sensors Is Off
        condition: template
        value_template: '{{ (trigger.id == ''NightLight'') and not use_night_settings
          }}'
      sequence:
      - alias: Set Schedule Intent to Off
        if:
        - alias: Set Schedule Intent
          condition: template
          value_template: '{{ schedule_intent_state != ''off'' }}'
        then:
        - action: select.select_option
          metadata: {}
          target:
            entity_id: '{{ schedule_entity }}'
          data:
            option: 'off'
          alias: Set Schedule to Off
      - event: lighting_registry_update
        event_data:
          action: remove
          claimant_id: '{{ schedule_entity }}'
          target:
            area_id: '{{ area_key }}'
            label_id: '{{ final_target_label }}'
          intent_type: schedule
    - conditions:
      - alias: Night Light Presence Sensors Is On
        condition: template
        value_template: '{{ (trigger.id == ''NightLight'') and  use_night_settings
          }}'
      sequence:
      - if:
        - alias: Set Schedule Intent to Presence
          condition: template
          value_template: '{{ schedule_intent_state != ''presence'' }}'
        then:
        - action: select.select_option
          metadata: {}
          target:
            entity_id: '{{ schedule_entity }}'
          data:
            option: presence
          alias: Set Schedule to Presence
        alias: Set Schedule Intent to Presence
      - event: lighting_registry_update
        event_data:
          action: remove
          claimant_id: '{{ schedule_entity }}'
          target:
            area_id: '{{ area_key }}'
            label_id: '{{ final_target_label }}'
          intent_type: schedule
  mode: queued
  max: 50
  trace:
    stored_traces: 50
- id: '1776717741547'
  alias: Override - Unified Gateway
  description: "# SYSTEM: OVERRIDE GATEWAY (V3.0)\n\nCentral processing engine for
    manual overrides events.\n\n## 1. PURPOSE\n\nGatekeeps non-automated state changes.
    It acts as the bridge between physical \nhardware (Relays/Switches), environmental
    sensors (Night Light), and the \nGlobal Presence Engine (GPE) registry.\n\n##
    2. ARCHITECTURE\n\n* **Override Branch**: Monitors `sensor.active_override_source`
    to translate \n  physical toggles into 'Override' intents within the lighting
    registry.\n  \n\n## 3. DEPENDENCIES\n\n* `sensor.active_override_source`: Unified
    stream of physical relay events.\n\n* `light.hallway_front_main`: Physical relay
    events.\n"
  triggers:
  - trigger: state
    entity_id: light.hallway_front_main
    attribute: brightness
    id: Front Change
  - trigger: mqtt
    options:
      topic: zigbee2mqtt/+
      payload: true
      value_template: "{{ value_json.detach_relay_mode is defined \n       and value_json.detach_relay_mode
        == true \n       and value_json.action is defined }}\n"
    id: Zigbee_id
  - trigger: state
    entity_id:
    - sensor.active_override_source
    from:
    to:
    id: Override_id
  - trigger: state
    entity_id:
    - light.hallway_front_main
    from:
    to:
    enabled: false
  conditions: []
  actions:
  - choose:
    - conditions:
      - condition: trigger
        id:
        - Override_id
      sequence:
      - variables:
          source_entity: '{{ trigger.to_state.state.split(''|'')[0] }}

            '
          current_state: '{{ states(source_entity) }}'
          area_key: '{{ area_id(source_entity) | default(''none'') }}'
          entity_labels: '{{ labels(source_entity) }}'
          action_type: lighting_registry_update
          action_value: '{{ states[source_entity].state }}'
          action: '{{ ''add'' if is_state(source_entity, ''on'') else ''remove'' }}'
          claimant_id: '{{ source_entity }}'
          intent_type: override
          seconds: '{{ -1 if is_state(source_entity, ''on'') else 0 }}'
          source_device: manual_action
      - event: lighting_registry_update
        event_data:
          action: '{{ action }}'
          action_type: '{{ action_type }}'
          claimant_id: '{{ claimant_id }}'
          intent_type: '{{ intent_type }}'
          target:
            area_id: '{{ area_key }}'
          seconds: '{{ seconds }}'
          source_device: '{{ source_device }}'
        enabled: true
      - action: logbook.log
        metadata: {}
        data:
          name: Lighting Override Engine
          message: 'Override for {{ area_key }} State: {{ states[source_entity].state
            }} '
          entity_id: '{{ source_entity }}'
    - conditions:
      - condition: trigger
        id:
        - Front Change
      sequence:
      - variables:
          target_state: '{{ states(''light.hallway_front_main'') }}'
          action_value: '{% if target_state == ''off'' %} 0 {% else %} {{ state_attr(''light.hallway_front_main'',
            ''brightness'') | int(255) }} {% endif %}

            '
          command_input: turn_{{ target_state }}
      - alias: Emit Intent Event
        event: universal_controller_command
        event_data:
          source_device: physical_switch_hallway
          action_type: light_call
          action_value: '{{ action_value }}'
          command_input: '{{ command_input }}'
          target:
            label_id:
            - Front
            area_id: hallway
      - data:
          name: UCC_SENT
          message: 'Area: {{area_name(trigger.entity_id)}} | Action: light_call |
            Value: "{{ action_value }} | Label: Front | {{ trigger.entity_id }}'
          entity_id: sensor.ucc_registry_log
        action: logbook.log
      - alias: Ignore the Ramp Noise
        delay:
          seconds: 1.5
    - conditions:
      - condition: trigger
        id:
        - Zigbee_id
      sequence:
      - variables:
          payload: '{{ trigger.payload_json }}'
          device_name: '{{ trigger.topic.split(''/'')[1] }}'
          area_id: '{{ device_name.lower().replace(''relay'', '''').strip().replace(''
            '', ''_'') }}'
          area_policy: '{{ labels(area_id) }}'
          is_bind_eligible: '{{ ''bind_eligible'' in area_policy }}'
          use_scene: '{{ ''scene_eligible'' in area_policy }}'
          target_light: "{{ label_entities('main') \n   | select('match', 'light\\.')\n
            \  | select('in', area_entities(area_id)) \n   | first | default('none')
            }}\n"
          intended_command: '{{ ''turn_off'' if is_state(target_light, ''on'') else
            ''turn_on'' }}'
          continue: '{{ is_bind_eligible and target_light | count > 0 }}'
      - condition: template
        value_template: "{{ continue }}\n   "
      - alias: Emit Generic Universal Controller Command Event
        event: universal_controller_command
        event_data:
          source_device: z2m_physical_rocker
          action_type: light_call
          action_value: ''
          command_input: '{{ intended_command }}'
          target:
            area_id: '{{ area_id }}'
            label_id:
            - main
          data_payload: '{{ payload }}'
          overrides: {}
      - alias: Direct Inject into Lighting Registry
        event: lighting_registry_update
        event_data:
          action: '{{ ''add'' if intended_command == ''turn_on'' else ''remove'' }}'
          action_type: lighting_registry_update
          claimant_id: '{{ device_name }}'
          intent_type: override
          target:
            area_id: '{{ area_id }}'
            label_id:
            - main
          locked: true
          source_device: z2m_physical_rocker
      - data:
          name: UCC_SENT
          message: 'Area: {{ area_id }} | Action: light_call | Value: {{ target_light
            }}'
          entity_id: sensor.ucc_registry_log
        action: logbook.log
      - delay:
          hours: 0
          minutes: 0
          seconds: 0
          milliseconds: 250
    enabled: true
  mode: single
- id: '1776771188285'
  alias: GPE - Schedule Heartbeat V2.0
  description: "# GPE - SCHEDULE HEARTBEAT V2.0\n\n## CORE LOGIC\n\nTriggered by changes
    in the 'Daily Lights Sensor' to adjust the area specific \nschedule Intent, or
    a manual change to a Area Schedule Intent.\n\nIterates through all entities labeled
    'light_schedule' (typically `select` or\n`input_select` entities).\n\n\n## RULES\n\n1.
    **Sync Check**: If the schedule selector state ('on'/'off') matches the\n`binary_sensor.daily_lights_sensor`
    state, it updates the Intent Registry.\n\n2. **Presence Mode**: If the selector
    is set to 'presence', this engine\nignores the area, allowing motion/presence
    sensors to take priority.\n\n3. **Priority**: Dispatches as `intent_type: schedule`
    with a persistent\nexpiry (`seconds: -1`).\n "
  triggers:
  - trigger: state
    entity_id: binary_sensor.daily_lights_sensor
    id: DayLight
  - trigger: state
    entity_id: sensor.light_schedule_master
    id: ScheduleChange
  - trigger: state
    entity_id: input_boolean.dummy
    id: DayLight
  conditions: []
  actions:
  - variables:
      registry: '{{ state_attr(''sensor.global_variable_registry'', ''vars'') | default({},
        true) }}'
      g_env: '{{ registry.get(''globals'', {}).get(''environmental'', {}) }}'
      g_hvac: '{{ registry.get(''globals'', {}).get(''hvac'', {}) }}'
      g_logic: '{{ registry.get(''globals'', {}).get(''logic_engines'', {}) }}'
  - choose:
    - conditions:
      - alias: Manual Schedule Change
        condition: template
        value_template: '{{ (trigger.id == ''ScheduleChange'')  }}'
      sequence:
      - variables:
          schedule_entity: '{{trigger.to_state.state.split(''|'')[0] }}'
          schedule_val: '{{ states(schedule_entity) }}'
          entity_labels: '{{ labels(schedule_entity) }}'
          area_key: '{{ area_id(schedule_entity) }}'
          area_policy: '{{ labels(area_key) }}'
          use_scene: '{{ ''scene_eligible'' in area_policy }}'
          use_daily_settings: '{{ ''day_light'' in area_policy and is_state(g_env.night_posture_sensor,
            ''off'') }}'
          use_auto_settings: '{{ ''auto_lights'' in area_policy and is_state(g_env.daily_lights_sensor,
            ''on'') }}'
          use_night_settings: '{{ ''night_light'' in area_policy and is_state(g_env.night_posture_sensor,
            ''on'') }}'
          final_target_label: "{% if use_night_settings %} \n  {{ ['night_light']
            }} \n{% else %}\n  {{ ['main'] }}\n{% endif %}"
          schedule_state: '{{ states(g_env.daily_lights_sensor) }}'
          is_active: '{{ is_state(g_env.daily_lights_sensor, ''on'') and schedule_val
            == ''on'' }}'
      - if:
        - condition: template
          value_template: '{{is_active }}'
        then:
        - event: lighting_registry_update
          event_data:
            action: add
            claimant_id: '{{ schedule_entity }}'
            target:
              area_id: '{{ area_key }}'
              label_id: '{{ final_target_label }}'
            seconds: -1
            intent_type: schedule
        - event: universal_controller_command
          event_data:
            action_type: light_call
            command_input: turn_on
            target:
              area_id: '{{ area_key }}'
              label_id: '{{ final_target_label }}'
            action_value: '{{ ''night_mode'' if use_night_settings else ''day_mode''
              }}'
            source_device: '{{ schedule_entity }}'
        else:
        - event: lighting_registry_update
          event_data:
            action: add
            claimant_id: '{{ schedule_entity }}'
            target:
              area_id: '{{ area_key }}'
              label_id: '{{ final_target_label }}'
            seconds: 0
            intent_type: schedule
    default:
    - alias: All Light Schedules Currently ON or Off
      repeat:
        for_each: "\n{{ label_entities('light_schedule')\n  | list\n  }}\n"
        sequence:
        - variables:
            schedule_entity: '{{ repeat.item }}'
            schedule_intent_state: '{{ states(repeat.item) }}'
            entity_labels: '{{ labels(schedule_entity) }}'
            area_key: '{{ area_id(schedule_entity) }}'
            area_policy: '{{ labels(area_key) }}'
            use_scene: '{{ ''scene_eligible'' in area_policy }}'
            use_daily_settings: '{{ ''day_light'' in area_policy and is_state(g_env.night_posture_sensor,
              ''off'') }}'
            use_auto_settings: '{{ ''auto_lights'' in area_policy and is_state(g_env.daily_lights_sensor,
              ''on'') }}'
            use_night_settings: '{{ ''night_light'' in area_policy and is_state(g_env.night_posture_sensor,
              ''on'') }}'
            final_target_label: "{% if use_night_settings %} \n  {{ ['night_light']
              }} \n{% else %}\n  {{ ['main'] }}\n{% endif %}"
            schedule_state: '{{ states(g_env.daily_lights_sensor) }}'
            is_active: '{{ is_state(g_env.daily_lights_sensor, ''on'') and schedule_intent_state
              == ''on'' }}'
        - choose:
          - conditions:
            - alias: Auto Light On
              condition: template
              value_template: '{{ (trigger.id == ''DayLight'') and  use_auto_settings
                }}'
            sequence:
            - alias: Set Schedule Intent to On
              if:
              - alias: Set Schedule Intent
                condition: template
                value_template: '{{ schedule_intent_state != ''on'' }}'
              then:
              - action: select.select_option
                metadata: {}
                target:
                  entity_id: '{{ schedule_entity }}'
                data:
                  option: 'on'
                alias: Set Schedule to On
            - event: lighting_registry_update
              event_data:
                action: add
                claimant_id: '{{ schedule_entity }}'
                target:
                  area_id: '{{ area_key }}'
                  label_id: '{{ final_target_label }}'
                seconds: -1
                intent_type: schedule
            - event: universal_controller_command
              event_data:
                action_type: light_call
                command_input: turn_on
                target:
                  area_id: '{{ area_key }}'
                  label_id: '{{ final_target_label }}'
                action_value: '{{ ''night_mode'' if use_night_settings else ''day_mode''
                  }}'
                source_device: '{{ schedule_entity }}'
          - conditions:
            - alias: Day Light Presence Sensors Is On
              condition: template
              value_template: '{{ (trigger.id == ''DayLight'') and (use_daily_settings
                or use_night_settings) }}'
            sequence:
            - event: lighting_registry_update
              event_data:
                action: remove
                claimant_id: '{{ schedule_entity }}'
                target:
                  area_id: '{{ area_key }}'
                  label_id: '{{ final_target_label }}'
                intent_type: schedule
            - if:
              - alias: Set Schedule Intent to Presence
                condition: template
                value_template: '{{ schedule_intent_state != ''presence'' }}'
              then:
              - action: select.select_option
                metadata: {}
                target:
                  entity_id: '{{ schedule_entity }}'
                data:
                  option: presence
                alias: Set Schedule to Presence
              alias: Set Schedule Intent to Presence
          default:
          - alias: Set Schedule Intent to Off
            if:
            - alias: Set Schedule Intent
              condition: template
              value_template: '{{ schedule_intent_state != ''off'' }}'
            then:
            - action: select.select_option
              metadata: {}
              target:
                entity_id: '{{ schedule_entity }}'
              data:
                option: 'off'
              alias: Set Schedule to Off
          - event: lighting_registry_update
            event_data:
              action: remove
              claimant_id: '{{ schedule_entity }}'
              target:
                area_id: '{{ area_key }}'
                label_id: '{{ final_target_label }}'
              intent_type: schedule
          - event: lighting_registry_update
            event_data:
              action: add
              claimant_id: '{{ schedule_entity }}'
              target:
                area_id: '{{ area_key }}'
                label_id: '{{ final_target_label }}'
              seconds: 0
              intent_type: schedule
  mode: queued
  max: 50
  trace:
    stored_traces: 50
- id: '1776772550965'
  alias: GPE - Schedule Policy Ladder (V2.1)
  description: "# GPE - SCHEDULE POLICY LADDER (V2.1)\nA dedicated Intent Authority
    for your schedules. It specifically manages the \"Policy Ladder\"  (Auto vs. Presence
    vs. Off) and ensures the select entities in your UI stay in sync with the  current
    house posture.\n## CORE LOGIC \nPolicy-Driven Intent Engine for Area Schedules.
    Uses Area Labels (auto_lights, day_light, night_light) to determine intent.\n##
    POLICY RULES \n1. POSTURE NOT NIGHT:\n   - auto_lights -> Intent ON\n   - day_light
    \  -> Intent PRESENCE\n2. POSTURE IS NIGHT:\n   - night_light -> Intent PRESENCE\n
    \  - otherwise   -> Intent OFF"
  triggers:
  - trigger: state
    entity_id: binary_sensor.daily_lights_sensor
    id: DayLight
  - trigger: state
    entity_id:
    - binary_sensor.night_light_sensor
    to:
    - 'off'
    id: DayLight
  - trigger: state
    entity_id: sensor.light_schedule_master
    id: ScheduleChange
  - trigger: state
    entity_id: input_boolean.dummy
    id: DayLight
  actions:
  - delay:
      hours: 0
      minutes: 0
      seconds: 5
      milliseconds: 0
  - variables:
      registry: '{{ state_attr(''sensor.global_variable_registry'', ''vars'') | default({},
        true) }}'
      g_env: '{{ registry.get(''globals'', {}).get(''environmental'', {}) }}'
      night_active: '{{ is_state(g_env.night_posture_sensor, ''on'') }}'
      daily_active: '{{ is_state(g_env.daily_lights_sensor, ''on'') }}'
  - alias: Process Light Schedules
    repeat:
      for_each: "{% if trigger.id == 'ScheduleChange' %}\n  {{ [trigger.to_state.state.split('|')[0]]
        }}\n{% else %}\n  {{ label_entities('light_schedule') | list }}\n{% endif
        %}\n"
      sequence:
      - variables:
          schedule_entity: '{{ repeat.item }}'
          target_area: '{{ area_id(schedule_entity) }}'
          area_policy: '{{ labels(target_area) }}'
          use_scene: '{{ ''scene_eligible'' in area_policy }}'
          should_be_on: '{{ not night_active and ''auto_lights'' in area_policy and
            daily_active }}'
          should_be_presence: "{{ (not night_active and 'day_light' in area_policy)
            or \n   (night_active and 'night_light' in area_policy) }}\n"
          target_option: "{% if trigger.id == 'ScheduleChange' %}\n  {{  states(schedule_entity)
            }}\n{% elif should_be_on %} \n  on  \n{% elif should_be_presence %} \n
            \ presence  \n{% else %}\n  off \n{% endif %}\n"
          final_target_label: '{{ [''night_light''] if night_active else [''main'']
            }}'
          target_select: select.{{ target_area }}_matrix_scene
          raw_scene: '{{ states(target_select) }}'
      - parallel:
        - sequence:
          - if:
            - condition: template
              value_template: '{{ states(schedule_entity) != target_option and trigger.id
                == ''DayLight'' }}'
            then:
            - action: select.select_option
              target:
                entity_id: '{{ schedule_entity }}'
              data:
                option: '{{ target_option }}'
          - event: lighting_registry_update
            event_data:
              action: '{{ ''add'' if target_option != ''off'' else ''remove'' }}'
              claimant_id: '{{ schedule_entity }}'
              target:
                area_id: '{{ target_area }}'
                label_id: '{{ final_target_label }}'
              seconds: '{{ -1 if target_option == ''on'' else 0 }}'
              intent_type: schedule
        - if:
          - condition: template
            value_template: '{{ target_option == ''on'' }}'
          then:
          - choose:
            - conditions:
              - condition: template
                value_template: '{{ use_scene }}'
                alias: Area Uses Scenes
              sequence:
              - event: universal_controller_command
                event_data:
                  action_type: scene_cycle
                  target:
                    area_id: '{{ target_area }}'
                  action_value: restore
                  source_device: '{{ source_entity }}'
            default:
            - event: universal_controller_command
              event_data:
                action_type: light_call
                command_input: turn_on
                target:
                  area_id: '{{ target_area }}'
                  label_id: '{{ final_target_label }}'
                action_value: '{{ ''night_mode'' if night_active else ''day_mode''
                  }}'
                source_device: '{{ schedule_entity }}'
  mode: queued
  max: 50
  trace:
    stored_traces: 50
- id: '1776778448485'
  alias: 'Adaptive Lighting: Sync Active CCT & Dimmer Targets'
  description: Syncs active lights to solar targets with deadzone checks to minimize  network
    chatter and accommodate legacy hardware.
  triggers:
  - trigger: state
    entity_id: sensor.cct_calculation
    id: target_change
    for: 00:00:10
  conditions: []
  actions:
  - variables:
      registry: '{{ state_attr(''sensor.global_variable_registry'', ''vars'') }}'
      g_logic: '{{ registry.globals.logic_engines }}'
      target_kelvin: '{{ states(g_logic.cct_calculation) | int(3200) }}'
      target_br_dimmer: '{{ states(g_logic.brightness_calculation) | int(150) }}'
      native_cct_targets: "{% set ns = namespace(targets=[]) %}\n{% for l in states.light
        | selectattr('state', 'eq', 'on') %}\n  {% set modes = l.attributes.get('supported_color_modes',
        []) %}\n  {% if 'color_temp' in modes %}\n    {% set cur_k = l.attributes.get('color_temp_kelvin',
        0) | int(0) %}\n    {% set min_k = l.attributes.get('min_color_temp_kelvin',
        2000) | int(2000) %}\n    {% set max_k = l.attributes.get('max_color_temp_kelvin',
        9000) | int(9000) %}\n    {% if (cur_k - target_kelvin) | abs > 50 \n       and
        target_kelvin >= min_k \n       and target_kelvin <= max_k %}\n      {% set
        ns.targets = ns.targets + [l.entity_id] %}\n    {% endif %}\n  {% endif %}\n{%
        endfor %}\n{{ ns.targets }}\n"
      dimmer_targets: "{% set ns = namespace(targets=[]) %}\n{% set labeled = label_entities('CurrentCTDimmer')
        %}\n{% for l in states.light | selectattr('entity_id', 'in', labeled) | selectattr('state',
        'eq', 'on') %}\n  {% set cur_br = l.attributes.get('brightness', 0) | int
        %}\n  {% if (cur_br - target_br_dimmer) | abs > 5 %}\n    {% set ns.targets
        = ns.targets + [l.entity_id] %}\n  {% endif %}\n{% endfor %}\n{{ ns.targets
        }}\n"
  - parallel:
    - alias: Update Native Kelvin Lights
      if:
      - condition: template
        value_template: '{{ native_cct_targets | length > 0 }}'
      then:
      - action: light.turn_on
        target:
          entity_id: '{{ native_cct_targets }}'
        data:
          color_temp_kelvin: '{{ target_kelvin }}'
          transition: 10
    - alias: Update Dim-2-Temp Groups (Legacy Compatible)
      if:
      - condition: template
        value_template: '{{ dimmer_targets | length > 0 }}'
      then:
      - action: light.turn_on
        target:
          entity_id: '{{ dimmer_targets }}'
        data:
          brightness: '{{ target_br_dimmer }}'
  mode: single
- id: '1776830974558'
  alias: 'GPE - Orchestrator (V3.5) '
  description: "# GPE - ORCHESTRATOR (V3.0) \nDecision engine for environmental presence.\n##
    1. CORE PURPOSE\nActs as the central decision engine for environmental presence.
    Fully  integrated with the Priority Intent Stack (Registry v6.1).\n## 2. ARCHITECTURAL
    LOGIC\n* **Priority Intent Integration**: All presence events are tagged with
    \n  `intent_type: motion` to ensure they interact correctly with the \n  multi-layered
    priority stack.\n  \n* **Standardized Handshake**: Uses `claimant_id` as the primary
    identifier \n  to align with Registry v6.1 and Cleaner v2.1 standards.\n  \n*
    **The Handover Pattern**: When high-precision presence clears, the system \n  automatically
    hands over to a 120s motion-type timer instead of immediate \n  removal, preventing
    jarring light cut-offs.\n\n* **The Gatekeeper Pattern**: Suppresses redundant
    commands if the room \n  is already in the desired state and filters false-positives
    via \n  Ghost/Veto logic.\n\n## 3. VERSION HISTORY\n* **V3.0**: Implemented schduled
    lighting via lighting schedule template sensor.\n* **V2.4**: Implemented conditional
    'seconds' (30s for door-only transitions).\n* **V2.3.5**: Fixed Safety Unlock
    to use explicit 'add' for grace period.\n* **V2.3.3**: Hardened Presence Update/Cleared
    aliases to strictly ignore \n  locked areas. Prevents motion-off events from overwriting
    infinite locks.\n\n* **V2.3.2**: Refined Valid Turn On to ignore door events if
    area is locked.\n  Prevents race conditions between Portal Turn On and Safety
    Unlock.\n\n* **V2.3.1**: Relaxed door_age restriction in should_lock_area. \n
    \ Allows locking if motion is sustained while the door is closed, \n  even if
    the door closure was >120s ago.\n\n* **V2.3**: Removed 'Presence Off' from should_unlock_area
    to prevent \n  premature unlocking when motion clears in locked zones.\n  \n*
    **V2.2**: Fix Modified should_unlock_area to transition to a 30s grace period
    instead  of immediate removal to prevent instant blackouts when doors open.\n*
    **V2.1**: Standardized on `claimant_id`. Implemented 120s \"Handover\" logic for
    cleared presence. Restored missing Door Timer and Motion Reset logic. \n* **V2.0**:
    Implemented Multi-Tenant Ownership tracking. Standardized event \n  schema for
    Registry v5.7 compatibility.\n  \n* **V1.5**: Updated attribute paths to `active_intents`.
    Standardized \n  `intent_type` as 'motion' for all presence-based additions."
  triggers:
  - trigger: state
    entity_id: sensor.active_sensor_monitor_master
    id: presence_id
  conditions:
  - condition: template
    value_template: "{{ trigger.to_state.state not in ['none', 'unknown', 'unavailable']
      and\n   trigger.from_state.state != trigger.to_state.state and \n   is_ready
      }}"
  actions:
  - variables:
      local_registry: sensor.{{ target_area }}_presence_intent
      current_stack: "{% set raw_stack = state_attr(local_registry, 'intent_stack')
        | default([], true) %} \n{% set ns = namespace(cleaned=[]) %} \n{% for item
        in raw_stack %}\n  {% if 'claimant_id' in item %}\n    {% set ns.cleaned =
        ns.cleaned + [item] %}\n  {% elif 'claimant' in item %}\n    {% set ns_item
        = namespace(new_dict={'claimant_id': item.claimant}) %}\n    {% for key, value
        in item.items() if key != 'claimant' %}\n      {% set ns_item.new_dict = dict(ns_item.new_dict,
        **{key: value}) %}\n    {% endfor %}\n    {% set ns.cleaned = ns.cleaned +
        [ns_item.new_dict] %}\n  {% endif %}\n{% endfor %} \n{{ ns.cleaned }}"
      is_on: '{{ is_state(source_entity, ''on'') }}'
      light_schedule_state: "{% set eligible = label_entities('light_schedule') %}
        \n{% set light_schedule = area_entities(target_area)\n  | intersect(eligible)\n
        \ | first\n  | default('none') %}\n{{ 'presence' if light_schedule == 'none'
        else states(light_schedule) }}"
      is_presence: '{{ (''presence'' in entity_labels or ''person'' in entity_labels)
        and (light_schedule_state == ''presence'' ) }}'
      is_door: '{{ ''door'' in entity_labels }}'
      is_entrance: '{{ ''entrance'' in entity_labels }}'
      area_policy: '{{ labels(target_area) }}'
      use_scene: '{{ ''scene_eligible'' in area_policy }}'
      use_night_settings: '{{ ''night_light'' in area_policy and is_state(g_env.night_posture_sensor,
        ''on'') }}'
      final_target_label: "{% if use_night_settings %} \n  {{ ['night_light'] }} \n{%
        else %}\n  {{ ['main'] }}\n{% endif %}"
      adjoining_area: '{{ registry.get(''area_metadata'', {}).get(target_area, {}).get(''neighbors'',
        {}).get(''peer'', ''none'') }}'
      door_entity: '{{ (area_entities(target_area) | intersect(label_entities(''door'')))
        | first | default(''none'') }}'
      has_door: '{{ door_entity != ''none'' }}'
      presence_entity: '{{ (area_entities(target_area) | intersect(label_entities(''presence'')))
        | first | default(''none'') }}'
      has_presence: '{{ presence_entity != ''none'' }}'
      door_state: '{{ states(door_entity) if has_door else ''none'' }}'
      is_door_closed: '{{ is_state(door_entity, ''off'') if has_door else false }}'
      door_age: '{{ as_timestamp(now()) - as_timestamp(states[door_entity].last_changed,
        0) if has_door else 0 }}'
      is_lock_zone: '{{ ''lock_eligible'' in area_policy }}'
      locked_intent: '{{ current_stack | selectattr(''locked'', ''eq'', true) | first
        | default(none) }}'
      is_area_locked: '{{ locked_intent is not none }}'
      locked_claimant_id: '{{ locked_intent.claimant_id if is_area_locked else ''none''
        }}'
      hvac_action: '{{ state_attr(g_hvac.primary_unit, ''hvac_action'') | default(''idle'')
        }}'
      hvac_is_active: '{{ hvac_action in [''cooling'', ''heating''] }}'
      is_ghost: '{{ has_door and is_presence and is_on and is_door_closed and not
        is_area_locked and (door_age > 600 or hvac_is_active) }}'
      should_lock_area: "{{ is_lock_zone and is_presence and is_on and is_door_closed
        and not is_area_locked and \n   (door_age < 120 or (current_stack | selectattr('type',
        'eq', 'motion') | list | count > 0)) }}"
      should_unlock_area: "{{ is_area_locked and (\n  (is_door and is_on) or\n  (has_door
        and not is_door_closed and door_age < 5)\n) }}"
      should_trigger_peer: '{{ is_door and is_on and target_area != ''none'' and adjoining_area
        != ''none'' }}'
  - variables:
      target_select: select.{{ target_area }}_matrix_scene
      raw_scene: '{{ states(target_select) }}'
      is_room_off: '{% set s = raw_scene %} {{ s is defined and (s == ''0'' or s.startswith(''0:''))
        }}

        '
      call_scene: '{{ is_room_off and is_presence and is_on and use_scene }}'
      call_off_scene: '{{ not is_room_off and is_presence and not is_on and use_scene
        }}'
  - choose:
    - alias: Veto Log (Ghost Detected)
      conditions:
      - condition: template
        value_template: '{{ is_presence and is_on and is_ghost }}'
      sequence:
      - action: logbook.log
        data:
          name: GPE VETO
          message: 'GPE VETO: Ghost in {{ target_area }} (HVAC: {{ hvac_action }},
            Door Age: {{ door_age | int }}s, Lock Status: {{ is_area_locked}})'
          entity_id: '{{ source_entity }}'
    - alias: Lock Presence (Sabbatical)
      conditions:
      - condition: template
        value_template: '{{ should_lock_area and not is_area_locked }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: lock
          claimant_id: '{{ source_entity }}'
          target:
            area_id: '{{ target_area }}'
          intent_type: motion
      - event: universal_controller_command
        event_data:
          action_type: light_call
          command_input: turn_on
          target:
            area_id: '{{ target_area }}'
            label_id: '{{ final_target_label }}'
          action_value: '{{ ''night_mode'' if use_night_settings else ''day_mode''
            }}'
          source_device: '{{ source_entity }}'
      - action: logbook.log
        data:
          name: GPE LOCKED
          message: 'LOCKED: {{ target_area }} via {{ source_entity }}. (Door Age:
            {{ door_age | int }}s, Presence: {{ is_on }})'
          entity_id: '{{ source_entity }}'
    - alias: Valid Turn On (Anti-Ghosting)
      conditions:
      - condition: template
        value_template: '{# Only allow Portal/Motion Turn On if not locked. If locked,
          Safety Unlock handles the exit. #} {{ (is_entrance or is_door or is_presence)
          and is_on and not is_ghost and not is_area_locked }}'
      sequence:
      - action: logbook.log
        data:
          name: GPE
          message: 'Turn On: Via {{''Motion'' if is_presence else ''Portal'' }} Room
            {{ target_area }} (Registry Reset, Door Age: {{ door_age | int }}s)'
          entity_id: '{{ source_entity }}'
      - if:
        - condition: template
          value_template: '{{ not use_scene }}'
        then:
        - event: universal_controller_command
          event_data:
            action_type: light_call
            command_input: turn_on
            target:
              area_id: '{{ target_area }}'
              label_id: '{{ final_target_label }}'
            action_value: '{{ ''night_mode'' if use_night_settings else ''day_mode''
              }}'
            source_device: '{{ source_entity }}'
        - event: lighting_registry_update
          event_data:
            action: add
            claimant_id: '{{ source_entity }}'
            target:
              area_id: '{{ target_area }}'
              label_id: '{{ final_target_label }}'
            seconds: '{{ 30 if is_door and has_presence else -1 }}'
            intent_type: motion
        else:
        - event: lighting_registry_update
          event_data:
            action: remove
            claimant_id: '{{ source_entity }}'
            target:
              area_id: '{{ target_area }}'
              label_id: '{{ final_target_label }}'
            intent_type: motion
        - condition: template
          value_template: '{{ call_scene }}'
          enabled: false
        - event: universal_controller_command
          event_data:
            action_type: scene_cycle
            target:
              area_id: '{{ target_area }}'
            action_value: restore
            source_device: '{{ source_entity }}'
    - alias: Presence Cleared (Handover)
      conditions:
      - condition: template
        value_template: '{{ is_presence and not is_on and not is_area_locked }}'
      sequence:
      - choose:
        - conditions:
          - condition: template
            value_template: '{{ not use_scene }}'
          sequence:
          - event: lighting_registry_update
            event_data:
              action: add
              claimant_id: '{{ source_entity }}'
              target:
                area_id: '{{ target_area }}'
                label_id: '{{ final_target_label }}'
              intent_type: motion
              seconds: 120
          alias: Start Expiry Timer (120s)
        - conditions:
          - condition: template
            value_template: '{{ call_off_scene }}'
          sequence:
          - event: lighting_registry_update
            event_data:
              action: add
              claimant_id: '{{ source_entity }}'
              target:
                area_id: '{{ target_area }}'
                label_id: '{{ final_target_label }}'
              intent_type: motion
              skip_warning: true
              seconds: 300
          alias: Call Off Scene
      - event: cleaner_heartbeat
        enabled: false
    - alias: Door Closed Timer Reset
      conditions:
      - condition: template
        value_template: '{{ is_door and not is_on }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: add
          claimant_id: '{{ source_entity }}'
          target:
            area_id: '{{ target_area }}'
            label_id: '{{ final_target_label }}'
          intent_type: motion
          seconds: 30
          skip_warning: '{{ not is_lock_zone }}'
    - alias: Presence Update (Motion Reset)
      conditions:
      - condition: template
        value_template: '{{ is_presence and is_on and not is_area_locked and (not
          has_door or not is_door_closed ) }}'
      sequence:
      - event: lighting_registry_update
        event_data:
          action: add
          claimant_id: '{{ source_entity }}'
          target:
            area_id: '{{ target_area }}'
            label_id: '{{ final_target_label }}'
          intent_type: motion
          seconds: 120
    - alias: Safety Unlock (Grace Period)
      conditions:
      - condition: template
        value_template: '{{ should_unlock_area }}'
      sequence:
      - action: logbook.log
        data:
          name: GPE UNLOCK
          message: 'UNLOCKING: {{ target_area }} (Handover to 30s Grace). (Reason:
            Door Opened/Ajar)'
          entity_id: '{{ source_entity }}'
      - event: lighting_registry_update
        event_data:
          action: add
          claimant_id: '{{ locked_claimant_id }}'
          target:
            area_id: '{{ target_area }}'
            label_id: '{{ final_target_label }}'
          intent_type: motion
          seconds: 30
          locked: false
    enabled: true
  - if:
    - condition: template
      value_template: '{{ should_trigger_peer }}'
    then:
    - event: universal_controller_command
      event_data:
        action_type: light_call
        command_input: turn_on
        target:
          area_id: '{{ adjoining_area }}'
          label_id: '{{ final_target_label }}'
        action_value: ''
    enabled: true
  - variables:
      last_sync: '{{ this.attributes.last_triggered | as_timestamp | default(0) }}'
      cooldown_met: '{{ last_sync is none or (now() | as_timestamp  - last_sync) >
        20 }}'
      active_registries: "{{ label_entities('lights_off') | unique \n   | expand \n
        \  | selectattr('state', 'in', ['active','expired']) \n   | map(attribute='entity_id')
        \n   | reject('eq', local_registry)\n   | list }}"
    enabled: false
  - if:
    - condition: template
      value_template: '{{ active_registries | count > 0 and cooldown_met }}'
    then:
    - repeat:
        for_each: '{{ active_registries }}'
        sequence:
        - variables:
            target_area: '{{ area_id(repeat.item) }}'
        - action: mqtt.publish
          data:
            topic: homeassistant/sensor/{{ target_area }}/presence/state
            payload: reset
          enabled: true
    enabled: false
  mode: parallel
  variables:
    registry: '{{ state_attr(''sensor.global_variable_registry'', ''vars'') | default({},
      true) }}'
    g_env: '{{ registry.get(''globals'', {}).get(''environmental'', {}) }}'
    g_hvac: '{{ registry.get(''globals'', {}).get(''hvac'', {}) }}'
    g_logic: '{{ registry.get(''globals'', {}).get(''logic_engines'', {}) }}'
    source_entity: '{{ trigger.to_state.state.split(''@'')[0] }}'
    target_area: '{{ area_id(source_entity) | default(''none'') }}'
    entity_labels: '{{ labels(source_entity) }}'
    is_ready: '{{ g_env != {} and target_area != ''none'' }}'
  max: 50
  trace:
    stored_traces: 50
- id: '1776868830105'
  alias: Universal Matrix Scene Executor V4.2
  description: '# UNIVERSAL MATRIX SCENE EXECUTOR (V4.1)

    ## 1. CORE PURPOSE

    Executes complex lighting state changes via dynamic profile iteration. It acts
    as the "driver" for the Matrix system, converting weight-based scene selections
    into specific light and label commands.

    ## 2. ARCHITECTURAL LOGIC

    * **Profile Lookup**: Fetches scene definitions from `sensor.{{ target_area }}_matrix_scene_config`
    attribute `scenes`.

    * **Weight Keyed**: Uses string representations of sequence weights (e.g., "30")
    to identify the intended lighting profile.

    * **Recursive Dispatch**: Iterates through nested labels (e.g., accent, main)
    for both primary areas and linked secondary areas.

    * **Hybrid Payload Support**: Logic handles both integer values (global area brightness)
    and mapping objects (specific label-to-brightness correlations).

    * **History Tracking**: Manages a `history_stack` within the selection entity
    to allow for "Restore" and "Previous" logic.

    ## 3. DEPENDENCIES

    * `select.{{ area }}_matrix_scene`: The UI/State controller for area scenes.

    * `sensor.{{ area }}_matrix_scene_config`: The data source containing scene JSON.

    * `universal_controller_command`: Event bus for executing light calls.

    * `MQTT Bus`: External trigger support for remote scene cycling.'
  triggers:
  - trigger: event
    event_type: universal_controller_command
    event_data:
      action_type: scene_cycle
  - trigger: mqtt
    id: MQTT_Bus
    options:
      topic: home/universal/bus
      payload: scene_cycle
      value_template: '{{ value_json.action_type }}'
  conditions: []
  actions:
  - variables:
      payload: '{{ trigger.payload_json if trigger.platform == ''mqtt'' else trigger.event.data
        }}'
      is_scene_cmd: '{{ trigger.platform != ''mqtt'' or payload.action_type == ''scene_cycle''
        }}'
      target_area: '{% set t = payload.get(''target'', {}) %}

        {{ t.get(''area_id'') | default(payload.area_key, true) }}'
      area_key: '{{ target_area }}

        '
      action: '{{ payload.action_value | default(''next'') | string }}'
      target_select: select.{{ target_area }}_matrix_scene
      current_history: '{{ state_attr(target_select, ''history_stack'') | default([],
        true) }}'
      local_options: '{{ state_attr(target_select, ''options'') | default([], true)
        }}'
      zb_options: "{% set ns = namespace(found=[]) %}\n{%- set prefix = 'scene.' ~
        area_key ~ '_' %}\n\n{%- for s in states.scene \n   | selectattr('entity_id',
        'search', '^' ~ prefix ~ '[0-9]*0_') -%}\n  \n  {# Strip the prefix: 'scene.powder_room_20_night'
        -> '20_night' #}\n  {%- set suffix = s.entity_id | replace(prefix, '', 1)
        -%}\n  {%- set parts = suffix.split('_') -%}\n  \n  {# Now parts[0] is ALWAYS
        the ID, and parts[1:] is ALWAYS the name #}\n  {%- set scene_id = parts[0]
        -%}\n  {%- set scene_name = parts[1:] | join(' ') | title -%}\n  \n  {%- set
        ns.found = ns.found + [ scene_id ~ ': ' ~ scene_name ] -%}\n{%- endfor -%}\n{{
        ns.found  | unique | sort }}"
      is_zigbee_scene: '{{ zb_options is list and zb_options | count > 0 }}

        '
      options: '{{ zb_options if is_zigbee_scene else local_options }}

        '
      is_option: '{{ action in options }}'
  - choose:
    - conditions:
      - condition: template
        value_template: '{{ is_option }}'
      sequence:
      - variables:
          final_state: '{{ action }}'
          parts: '{{ final_state.split('': '') }}'
          weight_str: '{{ parts[0] | trim }}'
          profile_sensor: '{{ ''sensor.'' ~ target_area ~ ''_matrix_scene_config''
            }}'
          profiles: '{{ state_attr(profile_sensor, ''scenes'') | default({}, true)
            }}'
          next_scene: '{{ profiles.get(parts[0], none) }}'
          primary_indexed: "{% if next_scene.primary is mapping %}\n  {% set ns =
            namespace(indexed={}) %}\n  {% for label, rawVal in next_scene.primary.items()
            %}\n    {% set actual_val = rawVal.brightness if rawVal is mapping else
            rawVal %}\n    {% set clean_val = actual_val | int(0) %}\n    {% set level
            = (([0, [clean_val, 255]|min]|max) / 25.5) | round(0, 'floor') | int %}\n
            \   {% set levelKey = level | string %}\n    {% set current_list = ns.indexed.get(levelKey,
            []) %}\n    {% set ns.indexed = dict(ns.indexed, **{levelKey: current_list
            + [label]}) %}\n  {% endfor %}\n  {{ ns.indexed }}\n{% else %}\n  {{ {}
            \ }}\n{% endif %}     "
      - condition: template
        value_template: '{{ next_scene is not none }}'
      - choose:
        - conditions:
          - condition: template
            value_template: '{{ next_scene.primary is mapping and next_scene.primary
              | count > 0 and not is_zigbee_scene }}'
          sequence:
          - repeat:
              for_each: '{{ primary_indexed.items() | list }}'
              sequence:
              - event: universal_controller_command
                event_data:
                  source_device: matrix_engine_batched
                  action_type: light_call
                  target:
                    area_id: '{{ target_area }}'
                    label_id: '{{ repeat.item[1] }}'
                  action_value: '{{ ((repeat.item[0] | int * 25.5) + 12) | int }}'
                  command_input: '{{ ''turn_off'' if repeat.item[0]|int == 0 else
                    ''turn_on'' }}'
        default:
        - variables:
            area_id_param: '{{ target_area }}'
            scene_id_param: '{{ weight_str | int }}'
            action_value_param: '{{ '''' if is_zigbee_scene else next_scene.primary
              | default(0) }}

              '
        - variables:
            command_input_param: '{{ ''turn_on'' if is_zigbee_scene or (next_scene.primary
              is number or (next_scene.primary | is_number)) else ''turn_off'' }}'
        - event: universal_controller_command
          event_data:
            source_device: matrix_engine_legacy
            action_type: light_call
            target:
              area_id: '{{ target_area }}'
              scene_id: '{{ weight_str | int }}'
            action_value: '{{ '''' if is_zigbee_scene else next_scene.primary | default(0)
              }}

              '
            command_input: "{{ 'turn_on' if is_zigbee_scene or (next_scene.primary
              is number or (next_scene.primary |\n  is_number)) else 'turn_off' }}\n"
      - variables:
          link_keys: '{{ next_scene.links.keys() | list }}'
      - choose:
        - conditions:
          - condition: template
            value_template: '{{ link_keys | list | count > 0 }}'
          sequence:
          - repeat:
              for_each: '{{ link_keys }}'
              sequence:
              - variables:
                  linked_area: '{{ repeat.item }}'
                  link_labels: '{{ next_scene.get(''links'', {}).get(linked_area,{})
                    }}'
                  links_indexed: "{% if link_labels is mapping and link_labels | count
                    > 0 %}\n  {% set ns = namespace(indexed={}) %}\n  {% for label,
                    rawVal in link_labels.items() %}\n    {% set actual_val = rawVal.brightness
                    if rawVal is mapping else rawVal %}\n    {% set clean_val = actual_val
                    | int(0) %}\n    {% set level = (([0, [clean_val, 255]|min]|max)
                    / 25.5) | round(0, 'floor') | int %}\n    {% set levelKey = level
                    | string %}\n    {% set current_list = ns.indexed.get(levelKey,
                    []) %}\n    {% set ns.indexed = dict(ns.indexed, **{levelKey:
                    current_list + [label]}) %}\n  {% endfor %}\n  {{ ns.indexed }}\n{%
                    else %}\n  {{ {} }}\n{% endif %}"
              - repeat:
                  for_each: '{{ links_indexed.items() | list }}'
                  sequence:
                  - event: universal_controller_command
                    event_data:
                      source_device: matrix_engine_batched
                      action_type: light_call
                      target:
                        area_id: '{{ linked_area }}'
                        label_id: '{{ repeat.item[1] }}'
                      action_value: '{{ ((repeat.item[0] | int * 25.5) + 12) | int
                        }}'
                      command_input: '{{ ''turn_off'' if repeat.item[0]|int == 0 else
                        ''turn_on'' }}'
        default:
        - event: universal_controller_command
          event_data:
            source_device: matrix_engine_legacy
            action_type: light_call
            target:
              area_id: '{{ target_area }}'
            action_value: '{{ next_scene.links | default(0) }}'
            command_input: '{{ ''turn_off'' if next_scene.links|int == 0 else ''turn_on''
              }}'
          enabled: false
      - action: mqtt.publish
        data:
          topic: homeassistant/select/{{ target_area }}/scene/attributes
          retain: true
          payload: "{% set history_update = (current_history + [final_state])[-5:]
            if final_state != current_history[-1] | default('') else current_history
            %} \n{{ {\n  \"options\": state_attr(target_select, 'options'),\n  \"friendly_name\":
            state_attr(target_select, 'friendly_name'),\n  \"icon\": state_attr(target_select,
            'icon'),\n  \"history_stack\": history_update\n} | tojson }}\n"
      - action: mqtt.publish
        data:
          topic: homeassistant/select/{{ target_area }}/scene/state
          retain: true
          payload: "{\n  \"name\": \"{{ next_scene.name }}\",\n  \"sequence_weight\":
            {{ next_scene.sequence_weight }}\n}\n"
      alias: Valid Option Supplied
    - conditions:
      - condition: template
        value_template: '{{ not is_option }}'
      sequence:
      - choose:
        - conditions:
          - condition: template
            value_template: '{{ action in [''next'', ''raise'', ''select_next''] }}'
          sequence:
          - action: select.select_next
            target:
              entity_id: '{{ target_select }}'
            data:
              cycle: false
        - conditions:
          - condition: template
            value_template: '{{ action in [''previous'', ''lower'', ''select_previous'']
              }}'
          sequence:
          - action: select.select_previous
            target:
              entity_id: '{{ target_select }}'
            data:
              cycle: false
        - conditions:
          - condition: template
            value_template: '{{ action in [''off'', ''select_first''] }}'
          sequence:
          - action: select.select_first
            target:
              entity_id: '{{ target_select }}'
        - conditions:
          - condition: template
            value_template: '{{ action in [''max'', ''select_last''] }}'
          sequence:
          - action: select.select_last
            target:
              entity_id: '{{ target_select }}'
        default:
        - variables:
            target_option: "{% if action == 'restore' %}\n  {% set active_history
              = current_history | reject('match', '^0:') | reject('eq', '0') | list
              %}\n  {% if active_history | length > 0 %}\n    {{ active_history[-1]
              }}\n  {% else %}\n    {{ options[1] if options | length > 1 else options[0]
              }}\n  {% endif %}\n{% elif action == 'min' %}\n  {{ options[1] if options
              | length > 1 else options[0] }}\n{% else %}\n  {% set act_s = action
              | string %}\n  {% set by_weight = options | select('match', '^' ~ act_s
              ~ ':') | first | default(none) %}\n  {% set by_name = options | select('search',
              act_s) | first | default(none) %}\n  {{ by_weight if by_weight is not
              none else (by_name if by_name is not none else act_s) }}\n{% endif %}"
        - action: select.select_option
          target:
            entity_id: '{{ target_select }}'
          data:
            option: '{{ target_option }}'
      alias: Action required Processing
  mode: restart
- id: '1776910612303'
  alias: Light Call - Turn On (V4.0)
  description: 'Technical Analysis: Light Call - Turn On (V4.0)


    1. The Core Logic: "The Intersection Engine"


    The genius of this automation is that it doesn''t hardcode entities. It uses a
    Three-Tier Resolution strategy:


    Scope: area_entities(target_area) — Limits the universe to a specific room.


    Intent: label_entities(target_labels) — Filters that universe by function (e.g.,
    "Ambient", "Task").


    Resolution: area_entities | intersect(target_labels) — Finds the exact hardware
    that lives in that room AND serves that purpose.


    2. Hardware Bucketing (The "How")


    Once the targets are resolved, the automation sorts them into "Buckets" based
    on hardware capabilities to prevent service call errors:


    IKEA CCT: Filtered by a 4000K ceiling (likely due to Zigbee/Tradfri specific behavior).


    Standard CCT: General adjustable white lights.


    Dimmer Lights: Forced to use a specific target_br_dimmer (likely legacy dimmers
    that don''t support color temp).


    Binary Lights: Simple On/Off (onoff color mode).


    Standard Lights: The fallback for anything that didn''t fit elsewhere.


    3. Key Strengths


    Strict Area Enforcement: It prevents a "Turn on Ambient" command from lighting
    up the whole house.


    Delta-Checking: Before firing a light.turn_on, it checks if the color temp or
    brightness delta is significant (abs > 50 or abs > 3). This reduces Zigbee/WiFi
    traffic congestion (popcorning).


    Dynamic Command Mapping: The command_map allows for abstract inputs like raise,
    lower, or night_mode to be translated into specific brightness steps.


    4. Why the JSON Registry (V4.0 Path) helps:


    While V3.0 is brilliant, it relies on Home Assistant labels being perfectly maintained.
    A Light Registry would allow you to:


    Define Virtual Groups: Create "endpoints" in JSON that don''t exist as physical
    groups but should act as one.


    Override Hardware Limits: Instead of guessing if a light is IKEA or Standard in
    the YAML, the Registry can explicitly define the min_k and max_k for every bulb
    in a single source of truth.


    Simplify the YAML: You could replace the massive "Hardware Bucketing" section
    with a single lookup to the JSON registry, making the automation 50% shorter and
    much faster to execute.


    Summary of Data Flow


    Trigger (MQTT/Event) -> Payload Extraction -> Area/Label Intersection -> Capability
    Sorting -> Parallel Execution

    '
  triggers:
  - trigger: event
    id: UCC_Event
    event_type: universal_controller_command
    event_data:
      action_type: light_call
      command_input: turn_on
    enabled: false
  - trigger: event
    id: eUCC_Event
    event_type: esphome.universal_controller_command
    event_data:
      action_type: light_call
      command_input: turn_on
    enabled: false
  - trigger: mqtt
    id: MQTT_Message
    options:
      topic: home/universal/bus
      payload: light_call
      value_template: '{{ value_json.action_type }}'
    enabled: false
  conditions: []
  actions:
  - alias: Intent and Context
    variables:
      registry: '{{ state_attr(''sensor.global_variable_registry'', ''vars'') }}'
      g_logic: '{{ registry.globals.logic_engines }}'
      g_env: '{{ registry.globals.environmental }}'
      target_kelvin: '{{ states(g_logic.cct_calculation) | int(3200) }}'
      target_color_temp: '{{ 1000000/target_kelvin | int }}'
      target_br_dimmer: '{{ states(g_logic.brightness_calculation) | int(255) }}'
      log_dest: '{{ g_logic.system_log }}'
      payload: '{{ trigger.payload if trigger.id == ''MQTT_Message'' else trigger.event.data
        }}'
      action_val: '{{ payload.action_value | default('''') }}'
      area_key: '{{ payload.area_key }}'
      val: '{% set t = payload.get(''target'', {}) %} {{ t.get(''label_id'') | default(payload.target_label,
        true) }}'
      target_labels: "{{ ( [val] if val is string else val) \n  | map('label_entities')
        \n  | sum(start=[]) \n  | unique \n  | list \n}}\n"
      target_area: "{% set t = payload.get('target', {}) %} \n\n{{ t.get('area_id',
        payload.area_key) }}"
      target_scene: "{% set t = payload.get('target', {}) %} \n\n{{ t.get('scene_id',
        -1 ) }}"
  - alias: Valid Option Supplied
    if:
    - condition: template
      value_template: '{{ target_scene == -1 }}'
    then:
    - alias: Data Constants
      variables:
        dim_factor: 20
        command_map:
          max:
            brightness: 255
          raise:
            brightness_step: 35
          lower:
            brightness_step: -35
          min:
            brightness: 25
          night_mode:
            brightness: 25
          day_mode:
            brightness: 190
          release:
            brightness_step: 0
        payload: {}
    - alias: Hardware Bucketing and Target Expansion (The "Engine")
      variables:
        area_entities: '{{ area_entities(target_area) | select(''match'', ''light.*'')
          | list }}'
        explicit_entities: '{% set t = payload.get(''target'', {}) %} {{ t.get(''entity_id'')
          | default([], true) }}             '
        intersected: "{% if target_labels | count > 0 %}\n  {{ area_entities | intersect(target_labels)
          }}\n{% else %}\n  {{ area_entities }}\n{% endif %}"
        resolved_targets: '{{ (intersected + explicit_entities) | unique | list }}'
        target_br: "{% set current_cmd = command_map.get(action_val, {}) %} {% if
          'brightness_step' in current_cmd %}\n  {{ 255 if current_cmd.brightness_step
          > 0 else 1 }}\n{% elif action_val is number or (action_val | is_number)
          %}\n  {{ ([0, action_val | int, 255] | sort)[1] }}\n{% else %}\n  {{ current_cmd.get('brightness',
          190) }}\n{% endif %}\n"
        step_val: '{{ command_map.get(action_val, {}).get(''brightness_step'', 0)
          }}'
        ikea_cct_lights: "{% set ns = namespace(to_update=[]) %} \n{% for l in states.light
          \n  | selectattr('entity_id', 'in', resolved_targets) \n    if l.attributes.get('max_color_temp_kelvin',
          0) | int <= 4000 \n   and 'color_temp' in l.attributes.get('supported_color_modes',
          []) %}\n      {% set cur_k = l.attributes.get('color_temp_kelvin', 0) |
          int(0) %}\n      {% set cur_br = l.attributes.get('brightness', 0) | int(0)
          %}\n      {% set clamped_k = ([l.attributes.get('min_color_temp_kelvin',
          2202) | int, target_kelvin, 4000] | sort)[1] %}\n      {% if (cur_k - clamped_k)
          | abs > 50 or (cur_br - target_br) | abs > 3 %}\n        {% set ns.to_update
          = ns.to_update + [l.entity_id] %}\n      {% endif %}\n{% endfor %} {{ ns.to_update
          }}\n"
        standard_cct_lights: "{% set ns = namespace(to_update=[]) %} {% for l in states.light
          | selectattr('entity_id', 'in', resolved_targets) \n   if l.entity_id not
          in ikea_cct_lights\n   and 'color_temp' in l.attributes.get('supported_color_modes',
          []) %}\n  {% set cur_k = l.attributes.get('color_temp_kelvin', 0) | int(0)
          %}\n  {% set cur_br = l.attributes.get('brightness', 0) | int(0) %}\n  {%
          set min_hw = l.attributes.get('min_color_temp_kelvin', 2200) | int %}\n
          \ {% set max_hw = l.attributes.get('max_color_temp_kelvin', 7000) | int
          %}\n  {% set clamped_k = ([min_hw, target_kelvin, max_hw] | sort)[1] %}\n
          \ {% if (cur_k - clamped_k) | abs > 50 or (cur_br - target_br) | abs > 3
          %}\n    {% set ns.to_update = ns.to_update + [l.entity_id] %}\n  {% endif
          %}\n{% endfor %} {{ ns.to_update }}\n"
        dimmer_lights: "{{ resolved_targets \n  | intersect(label_entities('CurrentCTDimmer'))
          \n  | list }}\n"
        binary_lights: "{{ resolved_targets\n  | expand\n  | selectattr('attributes.supported_color_modes',
          'defined')\n  | selectattr('attributes.supported_color_modes', 'eq', ['onoff'])\n
          \ | selectattr('state', 'in', ['off'])\n  | map(attribute='entity_id') |
          list }}\n"
        excluded: "{{ ikea_cct_lights + standard_cct_lights + dimmer_lights + binary_lights
          \n  | list \n  | default([]) }}\n"
        standard_lights: "{{ resolved_targets \n  | reject('in', excluded ) \n  |
          expand\n  | selectattr('state', 'in', ['off'])\n  | map(attribute='entity_id')
          | list }}\n"
    - if:
      - condition: template
        alias: Check for Intersection Failure
        value_template: '{{ target_labels | count > 0 and intersected | count == 0
          }}'
      then:
      - action: logbook.log
        data:
          name: GPE Intersection Error
          message: 'Area ''{{ target_area }}'' has no lights matching labels: {{ target_labels
            }}. Action ignored.'
          entity_id: '{{ g_logic.system_log | default(''sensor.global_variable_registry'')
            }}'
    - parallel:
      - alias: IKEA CCT Turn On
        if:
        - condition: template
          value_template: '{{ ikea_cct_lights | length > 0 }}'
        then:
        - action: light.turn_on
          target:
            entity_id: '{{ ikea_cct_lights }}'
          data: '{% set base_data = {''color_temp_kelvin'': target_kelvin} %}

            {{ dict(base_data, brightness_step=step_val) if step_val != 0 else dict(base_data,
            brightness=target_br) }}

            '
      - alias: Standard CCT Turn On
        if:
        - condition: template
          value_template: '{{ standard_cct_lights | length > 0 }}'
        then:
        - action: light.turn_on
          target:
            entity_id: '{{ standard_cct_lights }}'
          data: '{% set base_data = {''color_temp_kelvin'': target_kelvin} %} {{ dict(base_data,
            brightness_step=step_val) if step_val != 0 else dict(base_data, brightness=target_br)
            }}

            '
      - alias: Dimmer Lights Turn On
        if:
        - condition: template
          value_template: '{{ dimmer_lights | length > 0 }}'
        then:
        - action: light.turn_on
          target:
            entity_id: '{{ dimmer_lights }}'
          data:
            brightness: '{{ target_br_dimmer | int(150) }}'
      - alias: Binary Lights Turn On
        if:
        - condition: template
          value_template: '{{ binary_lights | length > 0 }}'
        then:
        - action: light.turn_on
          target:
            entity_id: '{{ binary_lights }}'
          data: {}
      - alias: Standard Lights Turn On
        if:
        - condition: template
          value_template: '{{ standard_lights | length > 0 }}'
        then:
        - action: light.turn_on
          target:
            entity_id: '{{ standard_lights }}'
          data: '{% set base_data = {} %}

            {{ dict(base_data, brightness_step=step_val) if step_val != 0 else dict(base_data,
            brightness=target_br) }}

            '
      enabled: true
    - action: logbook.log
      data:
        name: Light Engine (On)
        message: 'Light Call Source: {{ payload.source_device | default('''') }} |
          Area: {{ target_area }} | Label: {{ val[0] | default(''All'') }} | color_temp_kelvin:
          {{ target_kelvin }} {{this.entity_id}}'
        entity_id: '{{ log_dest }}'
      enabled: true
    else:
    - variables:
        posture_offset_map:
          disarmed: 0
          armed_night: 5
          armed_away: 1
        current_posture: '{{ states(g_env.get(''home_posture'', {})) | default(''disarmed'')
          }}'
        offset: '{{ posture_offset_map.get(current_posture, 0) | default(0) | int
          }}'
        base_id: '{{ target_scene }}'
        night_shift_id: '{{ target_scene + offset }}'
        night_prefix: '{{ ''scene.'' ~ target_area ~ ''_''  ~ night_shift_id | string  ~
          ''_'' }}'
        base_prefix: '{{ ''scene.'' ~ target_area ~ ''_''  ~ base_id | string  ~ ''_''
          }}'
        night_entity: "{{ states.scene | selectattr('entity_id', 'search',   '^' ~
          night_prefix ) \n  | map(attribute='entity_id') | first }}"
        base_entity: "{{ states.scene | selectattr('entity_id', 'search',   '^' ~
          base_prefix ) \n  | map(attribute='entity_id') | first }}"
        night_name: '{{ night_entity | replace(night_prefix, '''', 1) | replace(''_'',
          '' '') | title }}'
        base_name: '{{ base_entity | replace(base_prefix, '''', 1) | replace(''_'',
          '' '') | title }}

          '
        scene_id: '{{ base_id if night_entity == '''' else night_shift_id }}'
        scene_name: '{{ base_name if night_name == '''' else night_name }}'
        action: '{{ base_id  ~ '': '' ~ scene_name }}'
        target_select: select.{{ target_area }}_matrix_scene
        current_history: '{{ state_attr(target_select, ''history_stack'') | default([],
          true) }}'
        current_scene: '{{ state_attr(target_select, ''scene'') | default({}, true)
          }}'
        local_options: '{{ state_attr(target_select, ''options'') | default([], true)
          }}'
        zb_options: "{% set ns = namespace(found=[]) %}\n{%- set prefix = 'scene.'
          ~ target_area ~ '_' %}\n\n{%- for s in states.scene \n   | selectattr('entity_id',
          'search', '^' ~ prefix ~ '[0-9]*0_') -%}\n  \n  {%- set suffix = s.entity_id
          | replace(prefix, '', 1) -%}\n  {%- set parts = suffix.split('_') -%}\n
          \ \n  {%- set found_scene_id = parts[0] -%}\n  {%- set found_scene_name
          = parts[1:] | join(' ') | title -%}\n  \n  {%- set ns.found = ns.found +
          [ found_scene_id ~ ': ' ~ found_scene_name ] -%}\n{%- endfor -%}\n{{ ns.found
          \ | unique | sort }}"
        is_zigbee_scene: '{{ zb_options is list and zb_options | count > 0 }}

          '
        options: '{{ zb_options if is_zigbee_scene else local_options }}

          '
        is_option: '{{ action in options }}'
    - if:
      - condition: template
        value_template: '{{ scene_id != current_scene.get(''scene_id'', '''') }}'
      then:
      - action: mqtt.publish
        metadata: {}
        data:
          evaluate_payload: false
          qos: 0
          topic: 'zigbee2mqtt/{{ area_name(target_area) }}/set

            '
          payload: '{{ {''scene_recall'': scene_id,''transition'': 2} | to_json }}'
      - action: mqtt.publish
        data:
          topic: homeassistant/select/{{ target_area }}/scene/attributes
          retain: true
          payload: "{% set history_update = (current_history + [action])[-5:] if action
            != current_history[-1] | default('') else current_history %} \n{{ {\n
            \ \"options\": options,\n  \"scene\": {\n    \"scene_id\": base_id,\n
            \   \"scene_name\": scene_name\n    },\n  \"friendly_name\": state_attr(target_select,
            'friendly_name'),\n  \"icon\": state_attr(target_select, 'icon'),\n  \"history_stack\":
            history_update\n} | tojson }}\n"
      - action: mqtt.publish
        data:
          topic: homeassistant/select/{{ target_area }}/scene/state
          retain: true
          payload: "{\n  \"name\": \"{{ scene_name }}\",\n  \"sequence_weight\": {{base_id
            }}\n}\n"
      - delay:
          hours: 0
          minutes: 0
          seconds: 0
          milliseconds: 100
    - action: mqtt.publish
      metadata: {}
      data:
        evaluate_payload: false
        qos: 0
        topic: 'zigbee2mqtt/{{ area_name(target_area) }}/set

          '
        payload: '{{ {''color_temp'':   ([ 182, target_color_temp | int, 545] | sort)[1]
          } | to_json }}'
  mode: queued
  max: 20
  trace:
    stored_traces: 50
- id: '1777080768629'
  alias: Light Call - Turn Off (v2.1)
  description: ''
  triggers:
  - trigger: event
    id: UCC_Event
    event_type: universal_controller_command
    event_data:
      action_type: light_call
      action_value: 0
    enabled: true
  - trigger: event
    id: eUCC_Event
    event_type: esphome.universal_controller_command
    event_data:
      action_type: light_call
      action_value: 0
    enabled: true
  - trigger: mqtt
    id: MQTT_Message
    options:
      topic: home/universal/bus
      payload: light_call
      value_template: '{{ value_json.action_type }}'
  conditions: []
  actions:
  - alias: Define Actions
    variables:
      payload: '{{ trigger.payload if trigger.id == ''MQTT_Message'' else trigger.event.data
        }}'
      area_key: '{{ payload.area_key }}'
      command: '{{ payload.command_input }}'
      action_type: '{{ payload.action_type }}'
      action_value: '{{ payload.action_value }}'
  - condition: template
    value_template: '{{ action_value == 0 }}'
  - variables:
      transition: 0.2
      labels: "{{ trigger.event.data.target_label \n  | lower \n  | default([], true)\n}}\n"
      target_labels: "{{ ( [labels] if labels is string else labels ) \n  | map('label_entities')
        \n  | sum(start=[]) \n  | unique \n  | list \n}}\n"
      is_whole_area: '{{ labels | length == 0 }}'
      area_lights: '{{ area_entities(area_key) | select(''match'', ''light.*'') |
        list }}'
      expanded_targets: '{{ area_lights | intersect(target_labels) if target_labels
        | length > 0 else area_lights }}

        '
      final_targets: "{{ states.light \n  | selectattr('entity_id', 'in', expanded_targets)
        \n  | rejectattr('state', 'eq', 'off') \n  | map(attribute='entity_id') \n
        \ | list }}\n"
      final_target_data: "{% if is_whole_area %}\n  {{ {\"area_id\": area_key} }}\n{%
        else %}\n  {{ {\"entity_id\": final_targets} }}\n{% endif %}\n"
      log_nominee: "{% if final_targets | length > 0 %}\n  {{ final_targets | first
        }}\n{% else %}\n  {% set main_light = area_lights | intersect(label_entities('main'))
        | first | default('none') %}\n  {{ main_light if main_light != 'none' else
        (area_lights | first | default('sensor.ucc_registry_log')) }}\n{% endif %}\n"
      telemetry: '{% set t_id = trigger.id | default(''Event'') %}

        {% set src = payload.source_device | default(''unknown'') %}

        [ID: {{ t_id }} | Src: {{ src }} | Val: {{ action_value | default(''none'')
        }}]

        '
  - if:
    - condition: template
      value_template: '{{ final_target_data.area_id is defined or (final_target_data.entity_id
        is defined and final_target_data.entity_id | length > 0) }}'
    then:
    - action: light.turn_off
      target: '{{ final_target_data }}'
      data: {}
    - action: logbook.log
      data:
        name: Light Engine (Off)
        message: 'Turned off {{ final_targets | length }} lights in {{ area_key }}.
          (Source: {{ payload.source_device | default('''') }}) {{this.entity_id}}
          {{ telemetry }}'
        entity_id: sensor.ucc_registry_log
    - action: logbook.log
      data:
        name: Light Engine (Off)
        message: 'Turned off {{ final_targets | length }} lights in {{ area_key }}.
          (Source: {{ payload.source_device | default('''') }}) {{this.entity_id}}
          {{ telemetry }}'
        entity_id: '{{ log_nominee }}'
    else:
    - alias: Silent Skip
      stop: All target lights are already off. Mesh silenced.
  mode: queued
  max: 20
- id: '1777087667455'
  alias: Universal Matrix Scene Executor (V5.2)
  description: '# UNIVERSAL MATRIX SCENE EXECUTOR (V4.1)

    ## 1. CORE PURPOSE

    Executes complex lighting state changes via dynamic profile iteration. It acts
    as the "driver" for the Matrix system, converting weight-based scene selections
    into specific light and label commands.

    ## 2. ARCHITECTURAL LOGIC

    * **Profile Lookup**: Fetches scene definitions from `sensor.{{ target_area }}_matrix_scene_config`
    attribute `scenes`.

    * **Weight Keyed**: Uses string representations of sequence weights (e.g., "30")
    to identify the intended lighting profile.

    * **Recursive Dispatch**: Iterates through nested labels (e.g., accent, main)
    for both primary areas and linked secondary areas.

    * **Hybrid Payload Support**: Logic handles both integer values (global area brightness)
    and mapping objects (specific label-to-brightness correlations).

    * **History Tracking**: Manages a `history_stack` within the selection entity
    to allow for "Restore" and "Previous" logic.

    ## 3. DEPENDENCIES

    * `select.{{ area }}_matrix_scene`: The UI/State controller for area scenes.

    * `sensor.{{ area }}_matrix_scene_config`: The data source containing scene JSON.

    * `universal_controller_command`: Event bus for executing light calls.

    * `MQTT Bus`: External trigger support for remote scene cycling.'
  triggers:
  - trigger: event
    event_type: universal_controller_command
    event_data:
      action_type: scene_cycle
  - trigger: mqtt
    id: MQTT_Bus
    options:
      topic: home/universal/bus
      payload: scene_cycle
      value_template: '{{ value_json.action_type }}'
  conditions: []
  actions:
  - variables:
      payload: '{{ trigger.payload_json if trigger.platform == ''mqtt'' else trigger.event.data
        }}'
      is_scene_cmd: '{{ trigger.platform != ''mqtt'' or payload.action_type == ''scene_cycle''
        }}'
      target_area: '{% set t = payload.get(''target'', {}) %}

        {{ t.get(''area_id'', payload.get(''area_key'', ''none'')) }}'
      action: '{{ payload.action_value | default(''next'') | string }}'
      parts: '{{ action.split('': '') }}'
      scene_id: '{{ parts[0] | trim }}'
      scene_name: '{{ parts[1] | trim if parts | length > 1 else ''none'' }}'
      target_select: select.{{ target_area }}_matrix_scene
      current_history: '{{ state_attr(target_select, ''history_stack'') | default([],
        true) }}'
      local_options: '{{ state_attr(target_select, ''options'') | default([], true)
        }}'
      zb_options: "{% set ns = namespace(found=[]) %}\n{%- set prefix = 'scene.' ~
        target_area ~ '_' %}\n\n{%- for s in states.scene \n   | selectattr('entity_id',
        'search', '^' ~ prefix ~ '[0-9]*0_') -%}\n  \n  {%- set suffix = s.entity_id
        | replace(prefix, '', 1) -%}\n  {%- set parts = suffix.split('_') -%}\n  \n
        \ {%- set scene_id = parts[0] -%}\n  {%- set scene_name = parts[1:] | join('
        ') | title -%}\n  \n  {%- set ns.found = ns.found + [ scene_id ~ ': ' ~ scene_name
        ] -%}\n{%- endfor -%}\n{{ ns.found  | unique | sort }}"
      is_zigbee_scene: '{{ zb_options is list and zb_options | count > 0 }}

        '
      options: '{{ zb_options if is_zigbee_scene else local_options }}

        '
      is_option: '{{ action in options }}'
  - choose:
    - conditions:
      - condition: template
        value_template: '{{ is_option }}'
      sequence:
      - choose:
        - conditions:
          - condition: template
            value_template: '{{ is_zigbee_scene }}'
            alias: Zigbee Scene
          sequence:
          - event: universal_controller_command
            event_data:
              source_device: matrix_engine_legacy
              action_type: light_call
              target:
                area_id: '{{ target_area }}'
                scene_id: '{{ scene_id | int }}'
              action_value: ''
              command_input: '{{ ''turn_on'' }}

                '
        - conditions:
          - condition: template
            value_template: '{{ not is_zigbee_scene }}'
          sequence:
          - variables:
              final_state: '{{ action }}'
              parts: '{{ final_state.split('': '') }}'
              weight_str: '{{ parts[0] | trim }}'
              profile_sensor: '{{ ''sensor.'' ~ target_area ~ ''_matrix_scene_config''
                }}'
              profiles: '{{ state_attr(profile_sensor, ''scenes'') | default({}, true)
                }}'
              next_scene: '{{ profiles.get(parts[0], none) }}'
          - repeat:
              count: '{{ next_scene.primary.keys() | list | length if next_scene.primary
                is mapping else 1 }}'
              sequence:
              - variables:
                  is_map: '{{ next_scene.primary is mapping }}'
                  target: "{% if is_map %}\n  {{ [(next_scene.primary.keys() | list)[repeat.index
                    - 1]] }}\n{% else %}\n  {{ [] }}\n{% endif %}"
                  val: "{% if is_map %}\n  {{ (next_scene.primary.values() | list)[repeat.index
                    - 1] }}\n{% else %}\n  {{ next_scene.primary | default(0) }}\n{%
                    endif %}"
              - event: universal_controller_command
                event_data:
                  source_device: matrix_engine
                  action_type: light_call
                  target:
                    area_id: '{{ target_area }}'
                    label_id: '{{ target }}'
                  action_value: '{{ val | int(0) if val != '''' else '''' }}'
                  command_input: '{{ ''turn_off'' if val | int(0) == 0 and val !=
                    '''' else ''turn_on'' }}'
          - variables:
              link_keys: '{{ next_scene.links.keys() | list }}'
          - choose:
            - conditions:
              - condition: template
                value_template: '{{ link_keys | list | count > 0 }}'
              sequence:
              - repeat:
                  for_each: '{{ link_keys }}'
                  sequence:
                  - variables:
                      link_area: '{{ (next_scene.links.keys() | list)[repeat.index
                        - 1] }}'
                      link_data: '{{ (next_scene.links.values() | list)[repeat.index
                        - 1] }}'
                  - repeat:
                      count: '{{ link_data.keys() | list | length if link_data is
                        mapping else 1 }}'
                      sequence:
                      - variables:
                          is_sub_map: '{{ link_data is mapping }}'
                          target: "{% if is_sub_map %}\n  {{ [(link_data.keys() |
                            list)[repeat.index - 1]] }}\n{% else %}\n  {{ [] }}\n{%
                            endif %}"
                          val: "{% if is_sub_map %}\n  {{ (link_data.values() | list)[repeat.index
                            - 1] }}\n{% else %}\n  {{ link_data | default(0) }}\n{%
                            endif %}"
                      - event: universal_controller_command
                        event_data:
                          source_device: matrix_engine_link
                          action_type: light_call
                          target:
                            area_id: '{{ link_area }}'
                            label_id: '{{ target }}'
                          action_value: '{{ val | int(0) if val != '''' else ''''
                            }}'
                          command_input: '{{ ''turn_off'' if val | int(0) == 0 and
                            val != '''' else ''turn_on'' }}'
            default:
            - event: universal_controller_command
              event_data:
                source_device: matrix_engine_legacy
                action_type: light_call
                target:
                  area_id: '{{ target_area }}'
                action_value: '{{ next_scene.links | default(0) }}'
                command_input: '{{ ''turn_off'' if next_scene.links|int == 0 else
                  ''turn_on'' }}'
              enabled: false
          - action: mqtt.publish
            data:
              topic: homeassistant/select/{{ target_area }}/scene/attributes
              retain: true
              payload: "{% set history_update = (current_history + [action])[-5:]
                if action != current_history[-1] | default('') else current_history
                %} \n{{ {\n  \"options\": options,\n  \"scene\": {\n    \"scene_id\":
                scene_id,\n    \"scene_name\": scene_name\n    },\n  \"friendly_name\":
                state_attr(target_select, 'friendly_name'),\n  \"icon\": state_attr(target_select,
                'icon'),\n  \"history_stack\": history_update\n} | tojson }}\n"
          - action: mqtt.publish
            data:
              topic: homeassistant/select/{{ target_area }}/scene/state
              retain: true
              payload: "{\n  \"name\": \"{{ scene_name }}\",\n  \"sequence_weight\":
                {{scene_id }}\n}\n"
      alias: Valid Option Supplied
    - conditions:
      - condition: template
        value_template: '{{ not is_option }}'
      sequence:
      - choose:
        - conditions:
          - condition: template
            value_template: '{{ action in [''next'', ''raise'', ''select_next''] }}'
          sequence:
          - action: select.select_next
            target:
              entity_id: '{{ target_select }}'
            data:
              cycle: false
        - conditions:
          - condition: template
            value_template: '{{ action in [''previous'', ''lower'', ''select_previous'']
              }}'
          sequence:
          - action: select.select_previous
            target:
              entity_id: '{{ target_select }}'
            data:
              cycle: false
        - conditions:
          - condition: template
            value_template: '{{ action in [''off'', ''select_first''] }}'
          sequence:
          - action: select.select_first
            target:
              entity_id: '{{ target_select }}'
        - conditions:
          - condition: template
            value_template: '{{ action in [''max'', ''select_last''] }}'
          sequence:
          - action: select.select_last
            target:
              entity_id: '{{ target_select }}'
        default:
        - variables:
            target_option: "{% if action == 'restore' %}\n  {% set active_history
              = current_history | reject('match', '^0:') | reject('eq', '0') | list
              %}\n  {% if active_history | length > 0 %}\n    {{ active_history[-1]
              }}\n  {% else %}\n    {{ options[1] if options | length > 1 else options[0]
              }}\n  {% endif %}\n{% elif action == 'min' %}\n  {{ options[1] if options
              | length > 1 else options[0] }}\n{% else %}\n  {% set act_s = action
              | string %}\n  {% set by_weight = options | select('match', '^' ~ act_s
              ~ ':') | first | default(none) %}\n  {% set by_name = options | select('search',
              act_s) | first | default(none) %}\n  {{ by_weight if by_weight is not
              none else (by_name if by_name is not none else act_s) }}\n{% endif %}"
        - action: select.select_option
          target:
            entity_id: '{{ target_select }}'
          data:
            option: '{{ target_option }}'
      alias: Action required Processing
  mode: queued
  trace:
    stored_traces: 50
  max: 10
- id: '1777214367426'
  alias: GPE - Reactive Cleaner v4.1
  description: "# GPE - REACTIVE CLEANER (V4.1)\n## 1. PURPOSE\nLogic: Semantic Purge
    Engine. Centralizes the expiration and cleanup of the  Global Presence Engine
    (GPE) intent registry. It ensures the environment  reacts gracefully when human
    presence is no longer detected.\n## 2. ARCHITECTURE\n1. **Batch Purge**: Efficiently
    clears all expired, non-locked intents from the registry.\n2. **Semantic Warning
    Policy**: Implements a \"Warning State\" (dimming) before \n   final extinction,
    using dynamic discovery of doors and area labels.\n   \n3. **Ownership**: Uses
    'this.entity_id' to claim warning states, preventing \n   intent collisions during
    transition.\n   \n4. **Lock Support**: Respects 'locked: true' intents as absolute
    survivors, \n   preventing purges of critical manual or system states.\n\n## 3.
    DEPENDENCIES\n* `sensor.expired_presence_intent_master`: Master stream of expiring
    registry items.\n* `label:lock_eligible`: Determines if an area should enforce
    door-based logic.\n* `label:door`: Used for semantic door-state checking during
    warnings.\n* `label:scene_eligible`: Switches output from light calls to scene
    cycles."
  triggers:
  - trigger: state
    entity_id: sensor.expired_presence_intent_master
    id: reactive_trigger
  - trigger: event
    event_type: cleaner_heartbeat
    id: manual_pulse
  conditions: []
  actions:
  - variables:
      trigger_entity: "{% if trigger.id == 'reactive_trigger' and trigger.to_state.state
        not in ['none', 'unknown', 'unavailable', 'idle'] %}\n  {{ trigger.to_state.state.split('@')[0]
        }}\n{% else %}\n  {{ none }}\n{% endif %}\n"
      target_area: "{% if trigger.id == 'reactive_trigger' and trigger_entity is not
        none %}\n  {{ area_id(trigger_entity) }}\n{% elif trigger.id == 'manual_pulse'
        %}\n  {{ trigger.event.data.area_key | default('') }}\n{% else %}\n  {{ ''
        }}\n{% endif %}\n"
  - if:
    - condition: template
      value_template: '{{ (trigger.id == ''manual_pulse'' and target_area == '''')
        }}'
    then:
    - repeat:
        for_each: '{{ state_attr(''sensor.expired_presence_intent_master'', ''expired_entities'')
          | default([], true) }}'
        sequence:
        - variables:
            resolved_area: '{{ area_id(repeat.item) }}'
        - if:
          - condition: template
            value_template: '{{ resolved_area is not none }}'
          then:
          - event: cleaner_heartbeat
            event_data:
              area_key: '{{ resolved_area }}'
    else:
    - variables:
        intent_sensor: sensor.{{ target_area }}_presence_intent
        stack: '{{ state_attr(intent_sensor, ''intent_stack'') | default([], true)
          }}'
        now_iso: '{{ now().isoformat() }}'
        purge_list: "{{ stack \n  | selectattr('locked', 'defined')\n  | selectattr('locked',
          'eq', false)\n  | selectattr('expiry', 'string') \n  | selectattr('expiry',
          'lt', now_iso) \n  | list }}"
        active_survivors: "{{ (stack \n  | rejectattr('warned', 'eq', true) \n  |
          selectattr('expiry', 'string')\n  | selectattr('expiry', 'gt', now_iso)
          \n  | list + \n  stack \n    | selectattr('locked', 'eq', true) \n    |
          list) \n | unique(attribute='claimant_id') \n | list \n | count }}"
        sole_survivor_candidate: "{% if active_survivors | int == 0 %}\n  {{ purge_list
          \n    | sort(attribute='expiry', reverse=true) \n    | sort(attribute='priority',
          reverse=true) \n    | first | default(none) }}\n{% else %}\n  {{ none }}\n{%
          endif %}"
    - condition: template
      value_template: '{{ purge_list | count > 0 }}'
    - repeat:
        for_each: '{{ purge_list }}'
        sequence:
        - if:
          - condition: template
            value_template: '{{ repeat.item.claimant_id != (sole_survivor_candidate.claimant_id
              | default(''none'')) }}'
          then:
          - event: lighting_registry_update
            event_data:
              action: remove
              area_key: '{{ target_area }}'
              claimant_id: '{{ repeat.item.claimant_id }}'
          - action: logbook.log
            data:
              name: GPE Cleaner
              message: Purged expired Rank:{{ repeat.item.type }} ({{ repeat.item.claimant_id
                }}) in {{ target_area }}.
              entity_id: '{{ intent_sensor }}'
    - if:
      - condition: template
        value_template: '{{ sole_survivor_candidate is not none }}'
      then:
      - variables:
          target: '{{ sole_survivor_candidate }}'
          claimant_id: '{{ target.claimant_id }}'
          is_warned: '{{ target.warned | default(false) }}'
          area_labels: '{{ labels(target_area) | default([], true) }}'
          door_entity: '{{ (area_entities(target_area) | intersect(label_entities(''door'')))
            | first | default(''none'') }}'
          has_door: '{{ door_entity != ''none'' }}'
          is_door_closed: '{{ is_state(door_entity, ''off'') if has_door else false
            }}'
          is_lockable: '{{ ''lock_eligible'' in area_labels }}'
          should_skip_warning: "{% if not is_lockable or not has_door or 'transit_zone'
            in area_labels or 'stationary_zone' not in area_labels %}\n  {{ true }}\n{%
            elif is_lockable and is_door_closed %}\n  {{ false }}\n{% else %}  \n
            \ {{ target.skip_warning | default(false) }}\n{% endif %}"
          use_scene: '{{ ''scene_eligible'' in area_labels }}'
      - choose:
        - conditions:
          - condition: template
            value_template: '{{ should_skip_warning or is_warned }}'
          sequence:
          - event: universal_controller_command
            event_data:
              action_type: '{{ ''scene_cycle'' if use_scene else ''light_call'' }}'
              command_input: '{{ '''' if use_scene else ''turn_off'' }}'
              action_value: 'off'
              target:
                area_id: '{{ target_area }}'
                scene_id: '{{ 0 if use_scene else -1 }}'
          - event: lighting_registry_update
            event_data:
              action: remove
              area_key: '{{ target_area }}'
              claimant_id: '{{ claimant_id }}'
        - conditions:
          - condition: template
            value_template: '{{ not is_warned and not should_skip_warning }}'
          sequence:
          - event: universal_controller_command
            event_data:
              action_type: light_call
              command_input: turn_on
              action_value: min
              target:
                area_id: '{{ target_area }}'
          - event: lighting_registry_update
            event_data:
              action: warned
              area_key: '{{ target_area }}'
              claimant_id: '{{ this.entity_id }}'
  mode: parallel
  max: 10
  trace:
    stored_traces: 50
- id: '1777247689798'
  alias: Light Call V5
  description: 'Technical Analysis: Light Call - Turn On (V4.0)


    1. The Core Logic: "The Intersection Engine"


    The genius of this automation is that it doesn''t hardcode entities. It uses a
    Three-Tier Resolution strategy:


    Scope: area_entities(target_area) — Limits the universe to a specific room.


    Intent: label_entities(target_labels) — Filters that universe by function (e.g.,
    "Ambient", "Task").


    Resolution: area_entities | intersect(target_labels) — Finds the exact hardware
    that lives in that room AND serves that purpose.


    2. Hardware Bucketing (The "How")


    Once the targets are resolved, the automation sorts them into "Buckets" based
    on hardware capabilities to prevent service call errors:


    IKEA CCT: Filtered by a 4000K ceiling (likely due to Zigbee/Tradfri specific behavior).


    Standard CCT: General adjustable white lights.


    Dimmer Lights: Forced to use a specific target_br_dimmer (likely legacy dimmers
    that don''t support color temp).


    Binary Lights: Simple On/Off (onoff color mode).


    Standard Lights: The fallback for anything that didn''t fit elsewhere.


    3. Key Strengths


    Strict Area Enforcement: It prevents a "Turn on Ambient" command from lighting
    up the whole house.


    Delta-Checking: Before firing a light.turn_on, it checks if the color temp or
    brightness delta is significant (abs > 50 or abs > 3). This reduces Zigbee/WiFi
    traffic congestion (popcorning).


    Dynamic Command Mapping: The command_map allows for abstract inputs like raise,
    lower, or night_mode to be translated into specific brightness steps.


    4. Why the JSON Registry (V4.0 Path) helps:


    While V3.0 is brilliant, it relies on Home Assistant labels being perfectly maintained.
    A Light Registry would allow you to:


    Define Virtual Groups: Create "endpoints" in JSON that don''t exist as physical
    groups but should act as one.


    Override Hardware Limits: Instead of guessing if a light is IKEA or Standard in
    the YAML, the Registry can explicitly define the min_k and max_k for every bulb
    in a single source of truth.


    Simplify the YAML: You could replace the massive "Hardware Bucketing" section
    with a single lookup to the JSON registry, making the automation 50% shorter and
    much faster to execute.


    Summary of Data Flow


    Trigger (MQTT/Event) -> Payload Extraction -> Area/Label Intersection -> Capability
    Sorting -> Parallel Execution

    '
  triggers:
  - trigger: event
    id: UCC_Event
    event_type: universal_controller_command
    event_data:
      action_type: light_call
    enabled: true
  - trigger: event
    id: eUCC_Event
    event_type: esphome.universal_controller_command
    event_data:
      action_type: light_call
    enabled: true
  - trigger: mqtt
    id: MQTT_Message
    options:
      topic: home/universal/bus
      payload: light_call
      value_template: '{{ value_json.action_type }}'
  conditions: []
  actions:
  - alias: Intent and Context
    variables:
      registry: '{{ state_attr(''sensor.global_variable_registry'', ''vars'') }}'
      g_logic: '{{ registry.globals.logic_engines }}'
      g_env: '{{ registry.globals.environmental }}'
      target_kelvin: '{{ states(g_logic.cct_calculation) | int(3200) }}'
      target_color_temp: '{{ 1000000/target_kelvin | int }}'
      target_br_dimmer: '{{ states(g_logic.brightness_calculation) | int(255) }}'
      log_dest: '{{ g_logic.system_log }}'
      payload: '{{ trigger.payload if trigger.id == ''MQTT_Message'' else trigger.event.data
        }}'
      action_val: '{{ payload.action_value | default('''') }}'
      val: '{% set t = payload.get(''target'', {}) %} {{ t.get(''label_id'') | default(payload.target_label,
        true) }}'
      target_labels: "{{ ( [val] if val is string else val) \n  | map('label_entities')
        \n  | sum(start=[]) \n  | unique \n  | list \n}}\n"
      target_area: "{% set t = payload.get('target', {}) %} \n\n{{ t.get('area_id',
        payload.get('area_key','none')) }}"
      target_scene: "{% set t = payload.get('target', {}) %} \n\n{{ t.get('scene_id',
        -1 ) }}"
      action_type: '{{ ''turn_off'' if payload.get(''action_value'', '''') in [0,''0'',''off'']
        else payload.get(''command_input'', ''turn_on'') }}

        '
  - choose:
    - conditions:
      - alias: Target Scene Supplied
        condition: template
        value_template: '{{ target_scene != -1 }}'
      sequence:
      - variables:
          posture_offset_map:
            disarmed: 0
            armed_night: 5
            armed_away: 1
          current_posture: '{{ states(g_env.get(''home_posture'', {})) | default(''disarmed'')
            }}'
          offset: '{{ posture_offset_map.get(current_posture, 0) | default(0) | int
            }}'
          base_id: '{{ target_scene }}'
          night_shift_id: '{{ target_scene + offset }}'
          night_prefix: '{{ ''scene.'' ~ target_area ~ ''_''  ~ night_shift_id | string  ~
            ''_'' }}'
          base_prefix: '{{ ''scene.'' ~ target_area ~ ''_''  ~ base_id | string  ~
            ''_'' }}'
          night_entity: "{{ states.scene | selectattr('entity_id', 'search',   '^'
            ~ night_prefix ) \n  | map(attribute='entity_id') | first | default('')
            }}"
          base_entity: "{{ states.scene | selectattr('entity_id', 'search',   '^'
            ~ base_prefix ) \n  | map(attribute='entity_id') | first }}"
          night_name: '{{ night_entity | replace(night_prefix, '''', 1) | replace(''_'',
            '' '') | title }}'
          base_name: '{{ base_entity | replace(base_prefix, '''', 1) | replace(''_'',
            '' '') | title }}

            '
          scene_id: '{{ base_id if night_entity == '''' else night_shift_id }}'
          scene_name: '{{ base_name if night_name == '''' else night_name }}'
          action: '{{ base_id  ~ '': '' ~ scene_name }}'
          target_select: select.{{ target_area }}_matrix_scene
          current_history: '{{ state_attr(target_select, ''history_stack'') | default([],
            true) }}'
          current_scene: '{{ state_attr(target_select, ''scene'') | default({}, true)
            }}'
          local_options: '{{ state_attr(target_select, ''options'') | default([],
            true) }}'
          zb_options: "{% set ns = namespace(found=[]) %}\n{%- set prefix = 'scene.'
            ~ target_area ~ '_' %}\n\n{%- for s in states.scene \n   | selectattr('entity_id',
            'search', '^' ~ prefix ~ '[0-9]*0_') -%}\n  \n  {%- set suffix = s.entity_id
            | replace(prefix, '', 1) -%}\n  {%- set parts = suffix.split('_') -%}\n
            \ \n  {%- set found_scene_id = parts[0] -%}\n  {%- set found_scene_name
            = parts[1:] | join(' ') | title -%}\n  \n  {%- set ns.found = ns.found
            + [ found_scene_id ~ ': ' ~ found_scene_name ] -%}\n{%- endfor -%}\n{{
            ns.found  | unique | sort }}"
          is_zigbee_scene: '{{ zb_options is list and zb_options | count > 0 }}

            '
          options: '{{ zb_options if is_zigbee_scene else local_options }}

            '
          is_option: '{{ action in options }}'
      - if:
        - condition: template
          value_template: '{{ scene_id != current_scene.get(''scene_id'', '''') }}'
        then:
        - action: mqtt.publish
          metadata: {}
          data:
            evaluate_payload: false
            qos: 0
            topic: 'zigbee2mqtt/{{ area_name(target_area) }}/set

              '
            payload: '{{ {''scene_recall'': scene_id,''transition'': 2} | to_json
              }}'
        - action: mqtt.publish
          data:
            topic: homeassistant/select/{{ target_area }}/scene/attributes
            retain: true
            payload: "{% set history_update = (current_history + [action])[-5:] if
              action != current_history[-1] | default('') else current_history %}
              \n{{ {\n  \"options\": options,\n  \"scene\": {\n    \"scene_id\": base_id,\n
              \   \"scene_name\": scene_name\n    },\n  \"friendly_name\": state_attr(target_select,
              'friendly_name'),\n  \"icon\": state_attr(target_select, 'icon'),\n
              \ \"history_stack\": history_update\n} | tojson }}\n"
        - action: mqtt.publish
          data:
            topic: homeassistant/select/{{ target_area }}/scene/state
            retain: true
            payload: "{\n  \"name\": \"{{ scene_name }}\",\n  \"sequence_weight\":
              {{base_id }}\n}\n"
        - delay:
            hours: 0
            minutes: 0
            seconds: 0
            milliseconds: 100
      - action: mqtt.publish
        metadata: {}
        data:
          evaluate_payload: false
          qos: 0
          topic: 'zigbee2mqtt/{{ area_name(target_area) }}/set

            '
          payload: '{{ {''color_temp'':   ([ 182, target_color_temp | int, 545] |
            sort)[1] } | to_json }}'
        enabled: true
    - conditions:
      - alias: Lights Turn Off No Target Scene
        condition: template
        value_template: '{{ target_scene == -1 and action_type == ''turn_off'' }}'
      sequence:
      - alias: Hardware Bucketing and Target Expansion (The "Engine")
        variables:
          area_entities: '{{ area_entities(target_area) | select(''match'', ''light.*'')
            | list }}'
          explicit_entities: "{% set t = payload.get('target', {}) %} \n{{ t.get('entity_id')
            | default([], true) }}             "
          intersected: "{% if target_labels | count > 0 %}\n  {{ area_entities | intersect(target_labels)
            }}\n{% else %}\n  {{ area_entities }}\n{% endif %}"
          target_entities: '{{ (intersected + explicit_entities) | unique | list }}'
          is_whole_area: '{{ val | count == 0 }}'
          lights_off: "{% if action_type == 'turn_off' %}\n  {{ target_entities\n
            \   | expand \n    | rejectattr('state', 'eq', 'off') \n    | map(attribute='entity_id')
            \n    | list }}\n{% else %}\n  []\n{% endif %}\n"
          off_target_data: "{% if is_whole_area %}\n  {{ {\"area_id\": target_area}
            }}\n{% else %}\n  {{ {\"entity_id\": lights_off} }}\n{% endif %}\n"
      - alias: Standard Lights Turn Off
        if:
        - condition: template
          value_template: '{{ lights_off | count > 0 }}'
        then:
        - action: light.turn_off
          target: '{{ off_target_data }}'
          data: {}
          enabled: true
      - action: logbook.log
        data:
          name: Light Engine (On)
          message: 'Light Call Source: {{ payload.source_device | default('''') }}
            | Area: {{ target_area }} | Label: {{ val[0] | default(''All'') }} | color_temp_kelvin:
            {{ target_kelvin }} {{this.entity_id}}'
          entity_id: '{{ log_dest }}'
        enabled: true
    - conditions:
      - alias: Lights Turn On No Target Scene
        condition: template
        value_template: '{{ target_scene == -1 and action_type == ''turn_on''}}'
      sequence:
      - alias: Data Constants
        variables:
          dim_factor: 20
          command_map:
            max:
              brightness: 255
            raise:
              brightness_step: 35
            lower:
              brightness_step: -35
            min:
              brightness: 25
            night_mode:
              brightness: 25
            day_mode:
              brightness: 190
            release:
              brightness_step: 0
      - alias: Hardware Bucketing and Target Expansion (The "Engine")
        variables:
          area_entities: '{{ area_entities(target_area) | select(''match'', ''light.*'')
            | list }}'
          explicit_entities: "{% set t = payload.get('target', {}) %} \n{{ t.get('entity_id')
            | default([], true) }}             "
          intersected: "{% if target_labels | count > 0 %}\n  {{ area_entities | intersect(target_labels)
            }}\n{% else %}\n  {{ area_entities }}\n{% endif %}"
          target_entities: '{{ (intersected + explicit_entities) | unique | list }}'
          resolved_targets: "{% if action_type == 'turn_on' %}\n  {{ target_entities
            }}\n{% else %}\n  []\n{% endif %}\n"
          target_br: "{% set current_cmd = command_map.get(action_val, {}) %} {% if
            'brightness_step' in current_cmd %}\n  {{ 255 if current_cmd.brightness_step
            > 0 else 1 }}\n{% elif action_val is number or (action_val | is_number)
            %}\n  {{ ([0, action_val | int, 255] | sort)[1] }}\n{% else %}\n  {{ current_cmd.get('brightness',
            190) }}\n{% endif %}\n"
          step_val: '{{ command_map.get(action_val, {}).get(''brightness_step'', 0)
            }}'
          ikea_cct_lights: "{% set ns = namespace(to_update=[]) %} \n{% for l in states.light
            \n  | selectattr('entity_id', 'in', resolved_targets) \n    if l.attributes.get('max_color_temp_kelvin',
            0) | int <= 4000 \n   and 'color_temp' in l.attributes.get('supported_color_modes',
            []) %}\n      {% set cur_k = l.attributes.get('color_temp_kelvin', 0)
            | int(0) %}\n      {% set cur_br = l.attributes.get('brightness', 0) |
            int(0) %}\n      {% set clamped_k = ([l.attributes.get('min_color_temp_kelvin',
            2202) | int, target_kelvin, 4000] | sort)[1] %}\n      {% if (cur_k -
            clamped_k) | abs > 50 or (cur_br - target_br) | abs > 3 %}\n        {%
            set ns.to_update = ns.to_update + [l.entity_id] %}\n      {% endif %}\n{%
            endfor %} {{ ns.to_update }}\n"
          standard_cct_lights: "{% set ns = namespace(to_update=[]) %} {% for l in
            states.light | selectattr('entity_id', 'in', resolved_targets) \n   if
            l.entity_id not in ikea_cct_lights\n   and 'color_temp' in l.attributes.get('supported_color_modes',
            []) %}\n  {% set cur_k = l.attributes.get('color_temp_kelvin', 0) | int(0)
            %}\n  {% set cur_br = l.attributes.get('brightness', 0) | int(0) %}\n
            \ {% set min_hw = l.attributes.get('min_color_temp_kelvin', 2200) | int
            %}\n  {% set max_hw = l.attributes.get('max_color_temp_kelvin', 7000)
            | int %}\n  {% set clamped_k = ([min_hw, target_kelvin, max_hw] | sort)[1]
            %}\n  {% if (cur_k - clamped_k) | abs > 50 or (cur_br - target_br) | abs
            > 3 %}\n    {% set ns.to_update = ns.to_update + [l.entity_id] %}\n  {%
            endif %}\n{% endfor %} {{ ns.to_update }}\n"
          dimmer_lights: "{{ resolved_targets \n  | intersect(label_entities('CurrentCTDimmer'))
            \n  | list }}\n"
          binary_lights: "{{ resolved_targets\n  | expand\n  | selectattr('attributes.supported_color_modes',
            'defined')\n  | selectattr('attributes.supported_color_modes', 'eq', ['onoff'])\n
            \ | selectattr('state', 'in', ['off'])\n  | map(attribute='entity_id')
            | list }}\n"
          excluded: "{{ ikea_cct_lights + standard_cct_lights + dimmer_lights + binary_lights
            \n  | list \n  | default([]) }}\n"
          standard_lights: "{{ resolved_targets \n  | reject('in', excluded ) \n  |
            expand\n  | selectattr('state', 'in', ['off'])\n  | map(attribute='entity_id')
            | list }}\n"
      - parallel:
        - if:
          - condition: template
            alias: Area has no matching labels. Action ignored.
            value_template: '{{ target_labels | count > 0 and intersected | count
              == 0 }}'
          then:
          - action: logbook.log
            data:
              name: GPE Intersection Error
              message: 'Area ''{{ target_area }}'' has no lights matching labels:
                {{ target_labels }}. Action ignored.'
              entity_id: '{{ g_logic.system_log | default(''sensor.global_variable_registry'')
                }}'
            enabled: true
        - alias: IKEA CCT Turn On
          if:
          - condition: template
            value_template: '{{ ikea_cct_lights | length > 0 }}'
          then:
          - action: light.turn_on
            target:
              entity_id: '{{ ikea_cct_lights }}'
            data: '{% set base_data = {''color_temp_kelvin'': target_kelvin} %}

              {{ dict(base_data, brightness_step=step_val) if step_val != 0 else dict(base_data,
              brightness=target_br) }}

              '
            enabled: true
          - action: logbook.log
            data:
              name: Light Engine (On)
              message: 'Light Call Source: {{ payload.source_device | default('''')
                }} | Area: {{ target_area }} | Label: {{ val[0] | default(''All'')
                }} | color_temp_kelvin: {{ target_kelvin }} {{this.entity_id}}'
              entity_id: '{{ ikea_cct_lights | first }}'
            enabled: true
        - alias: Standard CCT Turn On
          if:
          - condition: template
            value_template: '{{ standard_cct_lights | length > 0 }}'
          then:
          - action: light.turn_on
            target:
              entity_id: '{{ standard_cct_lights }}'
            data: "{% set base_data = {'color_temp_kelvin': target_kelvin} %} \n\n{{
              dict(base_data, brightness_step=step_val) if step_val != 0 else dict(base_data,\nbrightness=target_br)
              }}\n"
            enabled: true
          - action: logbook.log
            data:
              name: Light Engine (On)
              message: 'Light Call Source: {{ payload.source_device | default('''')
                }} | Area: {{ target_area }} | Label: {{ val[0] | default(''All'')
                }} {{this.entity_id}}'
              entity_id: '{{ standard_cct_lights | first }}'
            enabled: true
        - alias: Dimmer Lights Turn On
          if:
          - condition: template
            value_template: '{{ dimmer_lights | length > 0 }}'
          then:
          - action: light.turn_on
            target:
              entity_id: '{{ dimmer_lights }}'
            data:
              brightness: '{{ target_br_dimmer | int(150) }}'
            enabled: true
          - action: logbook.log
            data:
              name: Light Engine (On)
              message: 'Light Call Source: {{ payload.source_device | default('''')
                }} | Area: {{ target_area }} | Label: {{ val[0] | default(''All'')
                }} {{this.entity_id}}'
              entity_id: '{{ dimmer_lights | first }}'
            enabled: true
        - alias: Binary Lights Turn On
          if:
          - condition: template
            value_template: '{{ binary_lights | length > 0 }}'
          then:
          - action: light.turn_on
            target:
              entity_id: '{{ binary_lights }}'
            data: {}
            enabled: true
          - action: logbook.log
            data:
              name: Light Engine (On)
              message: 'Light Call Source: {{ payload.source_device | default('''')
                }} | Area: {{ target_area }} | Label: {{ val[0] | default(''All'')
                }} {{this.entity_id}}'
              entity_id: '{{ binary_lights | first }}'
            enabled: true
        - alias: Standard Lights Turn On
          if:
          - condition: template
            value_template: '{{ standard_lights | length > 0 }}'
          then:
          - action: light.turn_on
            target:
              entity_id: '{{ standard_lights }}'
            data: '{% set base_data = {} %}


              {{ dict(base_data, brightness_step=step_val) if step_val != 0 else

              dict(base_data, brightness=target_br) }}

              '
            enabled: true
          - action: logbook.log
            data:
              name: Light Engine (On)
              message: 'Light Call Source: {{ payload.source_device | default('''')
                }} | Area: {{ target_area }} | Label: {{ val[0] | default(''All'')
                }} {{this.entity_id}}'
              entity_id: '{{ standard_lights | first }}'
            enabled: true
        enabled: true
  mode: queued
  max: 20
  trace:
    stored_traces: 50
- id: '1777557806847'
  alias: 'System: Posture & Intent Gateway (V4.0)'
  description: "# SYSTEM: POSTURE & INTENT GATEWAY (V4.0)\nCentral processing engine
    for house-wide posture transitions.\n## 1. PURPOSE\nGatekeeps non-automated state
    changes. It acts as the bridge between physical  hardware (Relays/Switches), environmental
    sensors (Night Light), and the  Global Presence Engine (GPE) registry.\n## 2.
    ARCHITECTURE\n  \n* **Posture Branch**: Bridges the `binary_sensor.night_light_sensor`
    to the \n  House Posture Alarm Panel, triggering mode shifts.\n  \n* **Sweep Engine**:
    Listens for posture changes to perform a 'Smart Purge' \n  of manual overrides
    when transitioning into restrictive modes (Night/Away).\n\n## 3. DEPENDENCIES\n*
    `alarm_control_panel.house_posture`: The master state machine for the matrix.\n*
    `label:override_eligible`: Required on entities to participate in Smart Purges."
  triggers:
  - trigger: state
    entity_id:
    - sensor.schedule_posture
    from:
    id: Night_id
    enabled: true
    to:
  - trigger: state
    entity_id: input_boolean.dummy
    id: Night_id
    enabled: true
  - trigger: state
    entity_id:
    - alarm_control_panel.house_posture_engine_house_posture
    id: posture_shift_trigger
    enabled: true
  conditions:
  - condition: template
    value_template: "{{ trigger.to_state.state not in ['none', 'unknown', 'unavailable']\n
      \  and trigger.from_state.state != trigger.to_state.state \n   }}\n"
  actions:
  - choose:
    - conditions:
      - condition: trigger
        id:
        - Night_id
      sequence:
      - if:
        - condition: state
          entity_id: sensor.schedule_posture
          state: night
        then:
        - action: alarm_control_panel.alarm_arm_night
          target:
            entity_id: alarm_control_panel.house_posture_engine_house_posture
          data: {}
        else:
        - if:
          - condition: state
            entity_id: alarm_control_panel.house_posture_engine_house_posture
            state:
            - armed_night
          then:
          - action: alarm_control_panel.alarm_disarm
            target:
              entity_id: alarm_control_panel.house_posture_engine_house_posture
            data: {}
      - alias: Process Light Schedules
        repeat:
          for_each: '{{ label_entities(''light_schedule'') | list }}

            '
          sequence:
          - action: mqtt.publish
            metadata: {}
            data:
              qos: 0
              topic: homeassistant/select/{{ area_id(repeat.item) }}/schedule/state
              payload: update
    - conditions:
      - condition: trigger
        id: posture_shift_trigger
      sequence:
      - variables:
          new_state: '{{ trigger.to_state.state | default(''none'') }}'
          posture_slug: "{% if new_state == 'armed_night' %}\n  night \n{% elif new_state
            in ['armed_away', 'armed_vacation'] %}\n  away \n{% else %} \n  default
            \n{% endif %}"
      - if:
        - condition: template
          value_template: '{{ posture_slug in [''night'', ''away''] }}'
        then:
        - repeat:
            for_each: "{% set eligible = label_entities('override_eligible') %} \n\n{{
              states.light \n  | selectattr('state', 'eq', 'on') \n  | map(attribute='entity_id')\n
              \ | intersect(eligible)\n  | list }}"
            sequence:
            - event: lighting_registry_update
              event_data:
                action: remove
                claimant_id: '{{ repeat.item }}'
                area_key: '{{ area_id(repeat.item) }}'
                intent_type: override
  mode: parallel
  variables:
    registry: '{{ state_attr(''sensor.global_variable_registry'', ''vars'') | default({},
      true) }}'
    g_env: '{{ registry.get(''globals'', {}).get(''environmental'', {}) }}'
    g_hvac: '{{ registry.get(''globals'', {}).get(''hvac'', {}) }}'
    g_logic: '{{ registry.get(''globals'', {}).get(''logic_engines'', {}) }}'
    is_ready: '{{ g_env != {} }}'
  max: 20
- id: '1777562852373'
  alias: GPE - Schedule Policy Ladder (V3)
  description: "# GPE - SCHEDULE POLICY LADDER (V3.0)\nA dedicated Intent Authority
    for your schedules. It specifically manages the \"Policy Ladder\"  (Auto vs. Presence
    vs. Off) and ensures the select entities in your UI stay in sync with the  current
    house posture.\n## CORE LOGIC \nPolicy-Driven Intent Engine for Area Schedules.
    Uses Area Labels (auto_lights, day_light, night_light) to determine intent.\n##
    POLICY RULES \n1. POSTURE NOT NIGHT:\n   - auto_lights -> Intent ON\n   - day_light
    \  -> Intent PRESENCE\n2. POSTURE IS NIGHT:\n   - night_light -> Intent PRESENCE\n
    \  - otherwise   -> Intent OFF"
  triggers:
  - trigger: mqtt
    id: ScheduleChange
    options:
      topic: home/matrix/+/schedule/state
  actions:
  - variables:
      topic: '{{ trigger.topic.split(''/'') | default([]) }}'
      target_area: '{{ topic[2] }}'
      area_policy: '{{ labels(target_area) }}'
      use_scene: '{{ ''scene_eligible'' in area_policy }}'
      target_option: '{{ trigger.payload | default(''none'') }}'
  - if:
    - condition: template
      value_template: '{{ target_option == ''on'' }}'
    then:
    - choose:
      - conditions:
        - condition: template
          value_template: '{{ use_scene }}'
          alias: Area Uses Scenes
        sequence:
        - event: universal_controller_command
          event_data:
            action_type: scene_cycle
            target:
              area_id: '{{ target_area }}'
            action_value: restore
            source_device: '{{ topic[2:] }}'
          enabled: false
      default:
      - event: universal_controller_command
        event_data:
          action_type: light_call
          command_input: turn_on
          target:
            area_id: '{{ target_area }}'
            label_id:
            - main
          action_value: day_mode
          source_device: '{{ topic[2:] }}'
        enabled: false
    enabled: true
  - action: mqtt.publish
    metadata: {}
    data:
      qos: 0
      topic: homeassistant/select/{{ target_area }}/schedule/state
      payload: '{{ target_option }}'
    enabled: false
  - parallel:
    - sequence:
      - event: lighting_registry_update
        event_data:
          action: '{{ ''add'' if target_option != ''off'' else ''remove'' }}'
          claimant_id: '{{ schedule_entity }}'
          target:
            area_id: '{{ target_area }}'
            label_id: '{{ final_target_label }}'
          seconds: '{{ -1 if target_option == ''on'' else 0 }}'
          intent_type: schedule
        enabled: false
    enabled: false
  mode: queued
  max: 50
  trace:
    stored_traces: 50
- id: '1777565357349'
  alias: GPE - Schedule Policy Ladder (V2.2)
  description: "# GPE - SCHEDULE POLICY LADDER (V2.1)\nA dedicated Intent Authority
    for your schedules. It specifically manages the \"Policy Ladder\"  (Auto vs. Presence
    vs. Off) and ensures the select entities in your UI stay in sync with the  current
    house posture.\n## CORE LOGIC \nPolicy-Driven Intent Engine for Area Schedules.
    Uses Area Labels (auto_lights, day_light, night_light) to determine intent.\n##
    POLICY RULES \n1. POSTURE NOT NIGHT:\n   - auto_lights -> Intent ON\n   - day_light
    \  -> Intent PRESENCE\n2. POSTURE IS NIGHT:\n   - night_light -> Intent PRESENCE\n
    \  - otherwise   -> Intent OFF"
  triggers:
  - trigger: state
    entity_id: binary_sensor.daily_lights_sensor
    id: DayLight
  - trigger: state
    entity_id:
    - binary_sensor.night_light_sensor
    to:
    - 'off'
    id: DayLight
  - trigger: state
    entity_id: sensor.light_schedule_master
    id: ScheduleChange
  - trigger: state
    entity_id: input_boolean.dummy
    id: DayLight
  actions:
  - delay:
      hours: 0
      minutes: 0
      seconds: 5
      milliseconds: 0
  - variables:
      registry: '{{ state_attr(''sensor.global_variable_registry'', ''vars'') | default({},
        true) }}'
      g_env: '{{ registry.get(''globals'', {}).get(''environmental'', {}) }}'
      night_active: '{{ is_state(g_env.night_posture_sensor, ''on'') }}'
      daily_active: '{{ is_state(g_env.daily_lights_sensor, ''on'') }}'
  - alias: Process Light Schedules
    repeat:
      for_each: "{% if trigger.id == 'ScheduleChange' %}\n  {{ [trigger.to_state.state.split('|')[0]]
        }}\n{% else %}\n  {{ label_entities('light_schedule') | list }}\n{% endif
        %}\n"
      sequence:
      - variables:
          schedule_entity: '{{ repeat.item }}'
          target_area: '{{ area_id(schedule_entity) }}'
          area_policy: '{{ labels(target_area) }}'
          use_scene: '{{ ''scene_eligible'' in area_policy }}'
          should_be_on: '{{ not night_active and ''auto_lights'' in area_policy and
            daily_active }}'
          should_be_presence: "{{ (not night_active and 'day_light' in area_policy)
            or \n   (night_active and 'night_light' in area_policy) }}\n"
          target_option: "{% if trigger.id == 'ScheduleChange' %}\n  {{  states(schedule_entity)
            }}\n{% elif should_be_on %} \n  on  \n{% elif should_be_presence %} \n
            \ presence  \n{% else %}\n  off \n{% endif %}\n"
          final_target_label: '{{ [''night_light''] if night_active else [''main'']
            }}'
          target_select: select.{{ target_area }}_matrix_scene
          raw_scene: '{{ states(target_select) }}'
      - parallel:
        - sequence:
          - if:
            - condition: template
              value_template: '{{ states(schedule_entity) != target_option and trigger.id
                == ''DayLight'' }}'
            then:
            - action: select.select_option
              target:
                entity_id: '{{ schedule_entity }}'
              data:
                option: '{{ target_option }}'
          - event: lighting_registry_update
            event_data:
              action: '{{ ''add'' if target_option != ''off'' else ''remove'' }}'
              claimant_id: '{{ schedule_entity }}'
              target:
                area_id: '{{ target_area }}'
                label_id: '{{ final_target_label }}'
              seconds: '{{ -1 if target_option == ''on'' else 0 }}'
              intent_type: schedule
        - if:
          - condition: template
            value_template: '{{ target_option == ''on'' }}'
          then:
          - choose:
            - conditions:
              - condition: template
                value_template: '{{ use_scene }}'
                alias: Area Uses Scenes
              sequence:
              - event: universal_controller_command
                event_data:
                  action_type: scene_cycle
                  target:
                    area_id: '{{ target_area }}'
                  action_value: restore
                  source_device: '{{ source_entity }}'
            default:
            - event: universal_controller_command
              event_data:
                action_type: light_call
                command_input: turn_on
                target:
                  area_id: '{{ target_area }}'
                  label_id: '{{ final_target_label }}'
                action_value: '{{ ''night_mode'' if night_active else ''day_mode''
                  }}'
                source_device: '{{ schedule_entity }}'
  mode: queued
  max: 50
  trace:
    stored_traces: 50
- id: '1777565626381'
  alias: GPE - Schedule Policy Ladder (V3.1)
  description: "# GPE - SCHEDULE POLICY LADDER (V3.0)\nA dedicated Intent Authority
    for your schedules. It specifically manages the \"Policy Ladder\"  (Auto vs. Presence
    vs. Off) and ensures the select entities in your UI stay in sync with the  current
    house posture.\n## CORE LOGIC \nPolicy-Driven Intent Engine for Area Schedules.
    Uses Area Labels (auto_lights, day_light, night_light) to determine intent.\n##
    POLICY RULES \n1. POSTURE NOT NIGHT:\n   - auto_lights -> Intent ON\n   - day_light
    \  -> Intent PRESENCE\n2. POSTURE IS NIGHT:\n   - night_light -> Intent PRESENCE\n
    \  - otherwise   -> Intent OFF"
  triggers:
  - trigger: mqtt
    id: ScheduleChange
    options:
      topic: home/matrix/+/schedule/state
  actions:
  - variables:
      topic: '{{ trigger.topic.split(''/'') | default([]) }}'
      target_area: '{{ topic[2] }}'
      area_policy: '{{ labels(target_area) }}'
      use_scene: '{{ ''scene_eligible'' in area_policy }}'
      target_option: '{{ trigger.payload | default(''none'') }}'
  - if:
    - condition: template
      value_template: '{{ target_option == ''on'' }}'
    then:
    - choose:
      - conditions:
        - condition: template
          value_template: '{{ use_scene }}'
          alias: Area Uses Scenes
        sequence:
        - event: universal_controller_command
          event_data:
            action_type: scene_cycle
            target:
              area_id: '{{ target_area }}'
            action_value: restore
            source_device: '{{ topic[3:] | join(''_'') }}'
          enabled: true
      default:
      - event: universal_controller_command
        event_data:
          action_type: light_call
          command_input: turn_on
          target:
            area_id: '{{ target_area }}'
            label_id:
            - main
          action_value: day_mode
          source_device: '{{ topic[3:] | join(''_'') }}'
        enabled: true
    enabled: true
  - event: lighting_registry_update
    event_data:
      action: '{{ ''add'' if target_option != ''off'' else ''remove'' }}'
      claimant_id: schedule_entity
      target:
        area_id: '{{ target_area }}'
      seconds: '{{ -1 if target_option == ''on'' else 0 }}'
      intent_type: schedule
    enabled: true
  - action: mqtt.publish
    metadata: {}
    data:
      qos: 0
      topic: homeassistant/select/{{ target_area }}/schedule/state
      payload: '{{ target_option }}'
    enabled: true
  mode: queued
  max: 50
  trace:
    stored_traces: 50
- id: '1777643037832'
  alias: GPE - Presence Heartbeat V1
  description: ''
  triggers:
  - trigger: mqtt
    id: MQTT_Bus
    options:
      topic: homeassistant/sensor/+/presence/state
      value_template: '{{ value in [''active'',''expired'',''expiring'',''reset'']
        }}'
      payload: true
    enabled: false
  actions:
  - delay:
      hours: 0
      minutes: 0
      seconds: 15
      milliseconds: 0
  - variables:
      last_sync: '{{ this.attributes.last_triggered | as_timestamp | default(none)
        }}'
      cooldown_met: '{{ last_sync is none or (now() | as_timestamp  - last_sync) >
        15 }}'
      active_registries: "{% set registries = label_entities('lights_off') \n  | expand
        \n  | selectattr('state', 'ne', 'idle')\n  | selectattr('attributes.expiry',
        'defined')\n  | selectattr('attributes.expiry', 'ne', none) \n  | list %}\n
        \ \n{% set ns = namespace(targets=[]) %}\n{% for s in registries %}\n  {%
        if (as_timestamp(s.attributes.expiry) - as_timestamp(now())) < 15 %}\n    {%
        set ns.targets = ns.targets + [s.entity_id] %}\n  {% endif %}\n{% endfor %}\n{{
        ns.targets }}"
  - if:
    - condition: template
      value_template: '{{ active_registries | count > 0 }}'
    then:
    - repeat:
        for_each: '{{ active_registries }}'
        sequence:
        - action: mqtt.publish
          data:
            topic: homeassistant/sensor/{{ area_id(repeat.item) }}/presence/state
            payload: reset
          enabled: true
    - variables:
        active_registries: "{% set registries = label_entities('lights_off') \n  |
          expand \n  | selectattr('state', 'ne', 'idle')\n  | selectattr('attributes.expiry',
          'defined')\n  | selectattr('attributes.expiry', 'ne', none) \n  | list %}\n
          \ \n{% set ns = namespace(targets=[]) %}\n{% for s in registries %}\n  {%
          if (as_timestamp(s.attributes.expiry) - as_timestamp(now())) < 15 %}\n    {%
          set ns.targets = ns.targets + [s.entity_id] %}\n  {% endif %}\n{% endfor
          %}\n{{ ns.targets }}"
  trace:
    stored_traces: 50
- id: '1777657746109'
  alias: GPE - Presence Heartbeat V1.2
  description: ''
  triggers:
  - trigger: mqtt
    id: MQTT_Bus
    options:
      topic: homeassistant/sensor/+/presence/state
      value_template: '{{ value in [''active'',''expired'',''expiring'',''reset'']
        }}'
      payload: true
  conditions: []
  actions:
  - variables:
      last_sync: '{{ this.attributes.last_triggered | as_timestamp | default(none)
        }}'
      cooldown_met: '{{ last_sync is none or (now() | as_timestamp  - last_sync) >
        15 }}'
      registries: "{{ label_entities('lights_off') \n  | expand \n  | selectattr('state',
        'ne', 'idle')\n  | map(attribute='entity_id')      \n  | list }}"
      active_registries_15: "{% set registries = registries \n  | expand \n  | selectattr('attributes.expiry',
        'defined')\n  | selectattr('attributes.expiry', 'ne', none) \n  | list %}\n
        \ \n{% set ns = namespace(targets=[]) %}\n{% for s in registries %}\n  {%
        if (as_timestamp(s.attributes.expiry) - as_timestamp(now())) < 15 %}\n    {%
        set ns.targets = ns.targets + [s.entity_id] %}\n  {% endif %}\n{% endfor %}\n{{
        ns.targets }}"
      active_registries_30: "{% set registries = registries \n  | expand \n  | selectattr('attributes.expiry',
        'defined')\n  | selectattr('attributes.expiry', 'ne', none) \n  | list %}\n
        \ \n{% set ns = namespace(targets=[]) %}\n{% for s in registries %}\n  {%
        if (as_timestamp(s.attributes.expiry) - as_timestamp(now())) < 30 %}\n    {%
        set ns.targets = ns.targets + [s.entity_id] %}\n  {% endif %}\n{% endfor %}\n{{
        ns.targets }}"
      active_registries_120: "{% set registries = registries \n  | expand \n  | selectattr('attributes.expiry',
        'defined')\n  | selectattr('attributes.expiry', 'ne', none) \n  | list %}\n
        \ \n{% set ns = namespace(targets=[]) %}\n{% for s in registries %}\n  {%
        if (as_timestamp(s.attributes.expiry) - as_timestamp(now())) < 120 %}\n    {%
        set ns.targets = ns.targets + [s.entity_id] %}\n  {% endif %}\n{% endfor %}\n{{
        ns.targets }}"
      active_registries_infinite: "{{ registries \n  | expand \n  | selectattr('attributes.expiry',
        'defined')\n  | selectattr('attributes.expiry', 'eq', none)\n  | map(attribute='entity_id')\n
        \ | list }}"
      next_check: "{{ 15 if active_registries_15 | count > 0 else \n  30 if active_registries_30
        | count > 0 else \n  60 if active_registries_120 | count > 0 or active_registries_infinite
        | count > 0 else\n  0 }}\n"
  - if:
    - condition: template
      value_template: '{{ registries | count > 0 }}'
    then:
    - repeat:
        for_each: '{{ registries }}'
        sequence:
        - action: mqtt.publish
          data:
            topic: homeassistant/sensor/{{ area_id(repeat.item) }}/presence/state
            payload: reset
          enabled: true
    - variables:
        active_registries: "{% set registries = label_entities('lights_off') \n  |
          expand \n  | selectattr('state', 'ne', 'idle')\n  | selectattr('attributes.expiry',
          'defined')\n  | selectattr('attributes.expiry', 'ne', none) \n  | list %}\n
          \ \n{% set ns = namespace(targets=[]) %}\n{% for s in registries %}\n  {%
          if (as_timestamp(s.attributes.expiry) - as_timestamp(now())) < 15 %}\n    {%
          set ns.targets = ns.targets + [s.entity_id] %}\n  {% endif %}\n{% endfor
          %}\n{{ ns.targets }}"
  - delay:
      hours: 0
      minutes: 0
      seconds: '{{ next_check }}'
      milliseconds: 0
  mode: single
  trace:
    stored_traces: 50
- id: '1777662267324'
  alias: GPE - Presence Heartbeat (V1.5)
  description: Event-driven watchdog for presence expiry. Triggered by gpe_heartbeat_sync.
    Implements the "Dormant Watchdog" strategy to conserve resources during quiet
    times.
  triggers:
  - trigger: event
    event_type: gpe_heartbeat_sync
    id: sync_event
  - trigger: event
    event_type: gpe_heartbeat_clear
    id: clear_cmd
  actions:
  - variables:
      registries: "{{ label_entities('lights_off') \n  | expand \n  | selectattr('state',
        'ne', 'idle')\n  | selectattr('attributes.expiry', 'defined')\n  | rejectattr('attributes.expiry',
        'in', [none, ''])\n  | rejectattr('locked', 'eq', true)\n  | map(attribute='entity_id')
        \n  | list }}"
      urgent_deadline: "{% set items = registries | expand \n  | selectattr('attributes.expiry',
        'defined')\n  | selectattr('attributes.expiry', 'ne', none) | list %}\n{%
        set ns = namespace(min_diff=3600) %}\n{% for i in items %}\n  {% set diff
        = as_timestamp(i.attributes.expiry) - as_timestamp(now()) %}\n  {% if diff
        > 0 and diff < ns.min_diff %}\n    {% set ns.min_diff = diff %}\n  {% endif
        %}\n{% endfor %}\n{{ ns.min_diff }}"
      next_check: '{% set count = registries | count %}

        {% if count == 0 or trigger.id == ''clear_cmd'' %} 0

        {% elif urgent_deadline | float <= 15 %} 15

        {% elif urgent_deadline | float <= 30 %} 30

        {% else %} 60

        {% endif %}'
  - if:
    - condition: template
      value_template: '{{ registries | count > 0 and trigger.id != ''clear_cmd'' }}'
    then:
    - repeat:
        for_each: '{{ registries }}'
        sequence:
        - action: mqtt.publish
          data:
            topic: homeassistant/sensor/{{ area_id(repeat.item) }}/presence/state
            payload: reset
          enabled: true
  - if:
    - condition: template
      value_template: '{{ next_check | int > 0 }}'
    then:
    - delay:
        seconds: '{{ next_check | int }}'
    - event: gpe_heartbeat_sync
      event_data:
        reason: recurring_check
        active_count: '{{ registries | count }}'
  mode: restart
